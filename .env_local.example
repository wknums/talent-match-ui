# =============================================================================
# Development Deployment Profile (.env_local)
# =============================================================================
# Copy to .env_local and fill in values for local/dev Azure deployment.
# Usage: ./infra/scripts/deploy.sh .env_local dev apply stack-a
# =============================================================================

# --- Azure Subscription ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=australiaeast

# --- Resource Naming ---
ENVIRONMENT=dev
RESOURCE_GROUP=rg-talentmatch-dev
PROJECT_NAME=talentmatch

# --- Stack Target ---
# Options: shared-only, stack-a, stack-b, both
STACK_TARGET=both

# --- Shared Resource Reuse Flags ---
# Set to TRUE to reuse existing resources instead of creating new ones.
# When TRUE, provide the corresponding name and resource group below.
AZ_APP_SERVICE_PLAN_REUSE=FALSE
AZ_SQL_REUSE=FALSE
AZ_KEY_VAULT_REUSE=FALSE
AZ_APIM_REUSE=FALSE
AZ_IDENTITIES_REUSE=FALSE

# --- Existing Resource Coordinates (required when *_REUSE=TRUE) ---
# App Service Plan
# AZ_APP_SERVICE_PLAN_NAME=
# AZ_APP_SERVICE_PLAN_RG=

# Azure SQL
# SQL_SERVER_NAME=
# SQL_DATABASE_NAME=
# SQL_RG=

# Key Vault
# AZ_KEY_VAULT_NAME=
# AZ_KEY_VAULT_RG=

# API Management
# AZ_APIM_NAME=
# AZ_APIM_RG=

# Managed Identities
# AZ_IDENTITY_STACK_A_NAME=
# AZ_IDENTITY_STACK_B_NAME=
# AZ_IDENTITIES_RG=

# --- App Service SKU ---
APP_SERVICE_PLAN_SKU=B1

# --- SQL Configuration ---
SQL_ADMIN_LOGIN=sqladmin

# --- Runtime Settings (non-secret) ---
# Stack A
STORAGE_PROVIDER=azuresql
AWR_AUTH_MODE=none
# AWR_SEQ_API_ENDPOINT=http://127.0.0.1:8080
# AWR_PLATFORM_API_ENDPOINT=

# Stack B
DATABASE_PROVIDER=sqlserver

# --- APIM Configuration ---
APIM_SKU=Consumption_0
APIM_PUBLISHER_NAME=TalentMatch
APIM_PUBLISHER_EMAIL=admin@example.com

# --- Key Vault Secret References (set by deployment, not manually) ---
# These are automatically wired from Key Vault into app settings:
#   @Microsoft.KeyVault(SecretUri=<key_vault_uri>/secrets/sql-connection-string)
#   @Microsoft.KeyVault(SecretUri=<key_vault_uri>/secrets/openai-api-key)
#   @Microsoft.KeyVault(SecretUri=<key_vault_uri>/secrets/awr-api-key)

# =============================================================================
# Private Network Connectivity (US6)
# =============================================================================
# Local development typically does not need VNet integration or IP restrictions.
# Uncomment and configure these when deploying to an Azure environment with
# private networking requirements.
#
# AZ_VNET_REUSE — Set to TRUE to enable VNet Integration for App Services.
#   VNet creation is NOT supported; only existing VNets are used.
# AZ_VNET_REUSE=TRUE
# AZ_VNET_NAME=vnet-awr-platform
# AZ_VNET_RG=rg-awr-networking
#
# Subnet mode: choose ONE of the following two options.
#   Option A: Reuse an existing delegated subnet (recommended for shared VNets)
# AZ_INTEGRATION_SUBNET_NAME=snet-appservice-integration
#   Option B: Create a new delegated subnet with the specified CIDR.
#   Minimum CIDR prefix is /26 for App Service delegation.
# AZ_INTEGRATION_SUBNET_CIDR=10.0.4.0/26
#
# SQL Private Endpoint — Set to TRUE if the VNet already has a Private
# Endpoint for the SQL Server. No PE will be created by Terraform.
# AZ_SQL_PRIVATE_ENDPOINT_REUSE=TRUE
#
# IP Access Restrictions — Comma-separated list of public IPs allowed to
# reach the App Services. When AZ_VNET_REUSE=TRUE, this is REQUIRED.
# All other traffic is denied by default.
# AZ_ALLOWED_IPS=203.0.113.10,198.51.100.20
