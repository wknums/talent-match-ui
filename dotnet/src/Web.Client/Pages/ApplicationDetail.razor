@page "/applications/{ApplicationId}"
@using TalentMatch.Web.Client.Services
@using System.Text.Json
@inject ApiClient Api
@inject NavigationManager Navigation

<h3>Application Detail</h3>

@if (application != null)
{
    <div style="margin-bottom: 1rem;">
        <span style="background: @StatusColor; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.85rem;">@application.Status</span>
        @if (application.FinalDecision != null)
        {
            <span style="margin-left: 0.5rem; font-weight: bold;">Decision: @application.FinalDecision</span>
        }
        @if (application.FinalScore.HasValue)
        {
            <span style="margin-left: 0.5rem;">Score: @application.FinalScore.Value.ToString("F1")</span>
        }
        @if (application.Variance.HasValue)
        {
            <span style="margin-left: 0.5rem; color: #666;">Variance: @application.Variance.Value.ToString("F1")</span>
        }
    </div>

    @if (application.FinalDecision is "NeedsManualReview" or "Eligible")
    {
        <button @onclick="NavigateToManualReview" style="margin-bottom: 1rem; padding: 0.5rem 1rem; background: #ed8936; color: white; border: none; border-radius: 4px;">
            Manual Review
        </button>
    }

    @* Extracted Text *@
    @if (extraction != null)
    {
        <div style="margin-bottom: 1.5rem;">
            <h4>Extracted Text</h4>
            <div style="font-size: 0.8rem; color: #666; margin-bottom: 0.25rem;">Confidence: @extraction.ConfidenceScore.ToString("F2")</div>
            <div style="border: 1px solid #ccc; border-radius: 8px; padding: 1rem; max-height: 300px; overflow-y: auto; background: #f9f9f9;">
                <pre style="white-space: pre-wrap; margin: 0;">@extraction.NormalisedText</pre>
            </div>
        </div>
    }

    @* Scoring Runs *@
    @if (scoringRuns.Any())
    {
        <div style="margin-bottom: 1.5rem;">
            <h4>Scoring Runs (@scoringRuns.Count)</h4>
            @foreach (var run in scoringRuns.OrderBy(r => r.RunIndex))
            {
                <details style="border: 1px solid #ccc; border-radius: 8px; padding: 1rem; margin-bottom: 0.5rem;">
                    <summary style="cursor: pointer; font-weight: bold;">
                        Run @(run.RunIndex + 1) — Score: @run.TotalScore.ToString("F1")
                        <span style="font-size: 0.8rem; color: #666; margin-left: 0.5rem;">(@run.AiModelId, v@run.PromptVersion)</span>
                    </summary>
                    <div style="margin-top: 0.5rem;">
                        @if (!string.IsNullOrEmpty(run.CategoryScoresJson))
                        {
                            <h5>Category Scores</h5>
                            <pre style="white-space: pre-wrap; font-size: 0.85rem; background: #f5f5f5; padding: 0.5rem; border-radius: 4px;">@FormatJson(run.CategoryScoresJson)</pre>
                        }
                        @if (!string.IsNullOrEmpty(run.MustHaveEvaluationJson))
                        {
                            <h5>Must-Have Evaluation</h5>
                            <pre style="white-space: pre-wrap; font-size: 0.85rem; background: #f5f5f5; padding: 0.5rem; border-radius: 4px;">@FormatJson(run.MustHaveEvaluationJson)</pre>
                        }
                        @if (!string.IsNullOrEmpty(run.EvidenceCitationsJson))
                        {
                            <h5>Evidence Citations</h5>
                            <pre style="white-space: pre-wrap; font-size: 0.85rem; background: #f5f5f5; padding: 0.5rem; border-radius: 4px;">@FormatJson(run.EvidenceCitationsJson)</pre>
                        }
                        @if (!string.IsNullOrEmpty(run.ImprovementTipsJson))
                        {
                            <h5>Improvement Tips</h5>
                            <pre style="white-space: pre-wrap; font-size: 0.85rem; background: #f5f5f5; padding: 0.5rem; border-radius: 4px;">@FormatJson(run.ImprovementTipsJson)</pre>
                        }
                        <div style="font-size: 0.8rem; color: #666; margin-top: 0.5rem;">
                            Tokens: @run.InputTokens input / @run.OutputTokens output
                        </div>
                    </div>
                </details>
            }
        </div>
    }

    @* Aggregated Result *@
    @if (aggregatedResult != null)
    {
        <div style="margin-bottom: 1.5rem;">
            <h4>Aggregated Result</h4>
            <div style="border: 1px solid #ccc; border-radius: 8px; padding: 1rem;">
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1rem;">
                    <div><strong>Final Score</strong><br />@aggregatedResult.FinalScore.ToString("F1")</div>
                    <div><strong>Decision</strong><br />@aggregatedResult.Decision</div>
                    <div><strong>Variance</strong><br />@aggregatedResult.Variance.ToString("F2")</div>
                    <div><strong>Confidence</strong><br />@aggregatedResult.Confidence.ToString("F2")</div>
                </div>
                @if (!string.IsNullOrEmpty(aggregatedResult.ConsolidatedRationale))
                {
                    <div style="margin-bottom: 0.5rem;">
                        <strong>Consolidated Rationale</strong>
                        <p style="margin-top: 0.25rem;">@aggregatedResult.ConsolidatedRationale</p>
                    </div>
                }
                @if (!string.IsNullOrEmpty(aggregatedResult.MergedImprovementTipsJson))
                {
                    <div>
                        <strong>Improvement Tips</strong>
                        <pre style="white-space: pre-wrap; font-size: 0.85rem; background: #f5f5f5; padding: 0.5rem; border-radius: 4px; margin-top: 0.25rem;">@FormatJson(aggregatedResult.MergedImprovementTipsJson)</pre>
                    </div>
                }
            </div>
        </div>
    }

    <button @onclick="NavigateToJob">← Back to Job</button>
}
else
{
    <p>Loading...</p>
}

@code {
    [Parameter] public string ApplicationId { get; set; } = "";

    private ApplicationDto? application;
    private ExtractionDto? extraction;
    private List<ScoringRunDto> scoringRuns = new();
    private AggregatedResultDto? aggregatedResult;

    private string StatusColor => application?.Status switch
    {
        "Completed" => "#38a169",
        "Failed" => "#e53e3e",
        "NeedsManualReview" => "#ed8936",
        "Scoring" or "Extracting" or "Aggregating" => "#3182ce",
        _ => "#718096"
    };

    protected override async Task OnInitializedAsync()
    {
        application = await Api.GetApplicationAsync(ApplicationId);
        extraction = await Api.GetExtractionAsync(ApplicationId);
        scoringRuns = await Api.GetScoringRunsAsync(ApplicationId);
        aggregatedResult = await Api.GetAggregatedResultAsync(ApplicationId);
    }

    private static string FormatJson(string json)
    {
        try
        {
            var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
        }
        catch { return json; }
    }

    private void NavigateToManualReview() => Navigation.NavigateTo($"/manual-review/{ApplicationId}");
    private void NavigateToJob() => Navigation.NavigateTo($"/jobs/{application?.JobId}");
}
