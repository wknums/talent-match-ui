@page "/jobs/{JobId}"
@using TalentMatch.Web.Client.Services
@using System.Text.Json
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IServiceProvider Services

<h3>Job Detail</h3>

@if (bulkScoringAvailable)
{
    <BulkScoringRequestNotification JobId="@JobId" />
}

@if (job != null)
{
    <div style="margin-bottom: 1rem;">
        <h4>@job.Title</h4>
        <p class="job-identifiers">
            <span><strong>Job code:</strong> @job.JobCode</span>
            <span><strong>Job ID:</strong> <code>@job.Id</code></span>
        </p>
        <p>@job.Organisation — @job.Department | Status: @job.Status</p>
        <div class="action-row">
            <button @onclick="() => showUpload = true"
                    disabled="@(!CanUploadApplications)"
                    title="@UploadApplicationsTitle"
                    style="padding: 0.5rem 1rem; background: #2b6cb0; color: white; border: none; border-radius: 4px;">
                Upload Applications
            </button>
            @if (bulkScoringAvailable)
            {
                <button @onclick="OpenNewBulkScoring"
                        disabled="@(!CanUploadApplications)"
                        title="@BulkScoringTitle"
                        style="padding: 0.5rem 1rem; background: #2b6cb0; color: white; border: none; border-radius: 4px;">
                    Start bulk scoring from SharePoint or OneDrive
                </button>
            }
            <button @onclick="() => showPrompts = !showPrompts" style="padding: 0.5rem 1rem; background: #805ad5; color: white; border: none; border-radius: 4px;">
                @(showPrompts ? "Close Prompt Manager" : "Manage Prompts")
            </button>
            <button @onclick="ReAggregate" disabled="@isReAggregating" style="padding: 0.5rem 1rem; background: #d69e2e; color: white; border: none; border-radius: 4px;" title="Recompute decisions from existing scoring runs (no API calls)">
                @(isReAggregating ? "Re-aggregating..." : "🔄 Re-aggregate")
            </button>
            <button @onclick="ToggleEditDialog" disabled="@isLoadingEditConfig" aria-label="Edit job configuration" style="padding: 0.5rem 1rem; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer;">
                @(isLoadingEditConfig ? "Loading..." : showEditDialog ? "Close Edit Job" : "Edit Job")
            </button>
            <button @onclick="() => showHelp = !showHelp" aria-expanded="@showHelp" style="padding: 0.5rem 1rem;">
                @(showHelp ? "Close Help" : "Help")
            </button>
            @if (isAdmin)
            {
                <button @onclick="OpenDeleteDialog" style="padding: 0.5rem 1rem; background: #dc2626; color: white; border: none; border-radius: 4px;">Delete Job</button>
            }
            @if (!hasProductionApprovedPrompt)
            {
                <span style="color: #c53030; font-size: 0.85rem; align-self: center;">⚠️ Production-approved prompt required</span>
            }
        </div>
        @if (productionProfileStatus is { IsMatch: false })
        {
            <div role="alert" style="margin-top:0.75rem; padding:0.85rem; background:#fee2e2; border:2px solid #dc2626; border-radius:6px; color:#7f1d1d;">
                <strong>Scoring profile mismatch — uploads and production scoring are blocked.</strong>
                <div>@productionProfileStatus.MismatchMessage</div>
                <button @onclick="() => showPrompts = true" style="margin-top:0.5rem;">Open prompt manager to retest</button>
            </div>
        }
    </div>

    <section class="pipeline-section">
        <h5>Pipeline Status</h5>
        <PipelineVisualizer ApplicationCounts="applicationCounts"
                            BulkCounts="bulkPipelineCounts"
                            JobId="@JobId" />
        @if (bulkScoringAvailable)
        {
            <BulkScoringRequestsPanel @ref="bulkRequestsPanel"
                                      JobId="@JobId"
                                      InitialRequestId="@bulkDetailRequestId"
                                      OnPipelineCountsChanged="OnBulkPipelineCountsChanged"
                                      OnRetryRequested="OpenBulkRetry" />
        }

    @if (statusRefreshError is not null)
    {
        <p role="alert">@statusRefreshError</p>
    }

    @if (processingErrors.Any() && HasFailedApps)
    {
        <div style="background: #fee2e2; border: 1px solid #fca5a5; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1rem; color: #991b1b;">
            <strong>Processing Errors (@processingErrors.Count):</strong>
            <ul style="margin: 0.25rem 0 0 1rem; padding: 0;">
                @foreach (var err in processingErrors)
                {
                    <li style="font-size: 0.85rem;">@err</li>
                }
            </ul>
        </div>
    }
    @if (!string.IsNullOrEmpty(reAggregateMessage))
    {
        <div style="background: #fefce8; border: 1px solid #fde68a; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1rem; color: #854d0e; font-size: 0.9rem;">
            🔄 @reAggregateMessage
        </div>
    }

    <details class="job-collapsible pipeline-results" open>
        <summary>Longlist, Shortlist, Review and Excluded Applications (@(applicationCounts?.Total ?? 0))</summary>
        <div class="job-collapsible-content">
    <div class="tab-row">
        <button @onclick="@(() => SelectTab("shortlist"))" style="@TabStyle("shortlist")">Shortlist ≥ @EffectiveShortlistThreshold.ToString("F3") (@(applicationCounts?.Shortlist ?? 0))</button>
        <button @onclick="@(() => SelectTab("longlist"))" style="@TabStyle("longlist")">Longlist ≥ @EffectiveLonglistThreshold.ToString("F3") (@(applicationCounts?.Longlist ?? 0))</button>
        <button @onclick="@(() => SelectTab("review"))" style="@TabStyle("review")">Review (@(applicationCounts?.Review ?? 0))</button>
        <button @onclick="@(() => SelectTab("excluded"))" style="@TabStyle("excluded")">Excluded (@(applicationCounts?.Excluded ?? 0))</button>
    </div>

    <div class="filter-row">
        <input
            @bind="applicantSearch"
            @bind:event="oninput"
            placeholder="Search applicant name"
            aria-label="Search by applicant name"
            style="padding: 0.45rem 0.6rem; flex: 1 1 18rem; min-width: 0; border: 1px solid #cbd5e0; border-radius: 6px;" />
        @if (!string.IsNullOrWhiteSpace(applicantSearch))
        {
            <button @onclick="() => applicantSearch = string.Empty" style="padding: 0.4rem 0.75rem;">Clear</button>
        }
        <div class="application-export-menu">
            <button class="application-export-trigger"
                    @onclick="() => showExportMenu = !showExportMenu"
                    aria-label="@($"Export {activeTab} applications")"
                    aria-expanded="@showExportMenu"
                    title="Export applications">
                …
            </button>
            @if (showExportMenu)
            {
                <div class="application-export-options" role="menu" aria-label="Export to Excel">
                    <strong>Export to Excel</strong>
                    <button role="menuitem" @onclick="() => ExportCurrentList(ApplicationExportFormat.Csv)">Export as CSV</button>
                    <button role="menuitem" @onclick="() => ExportCurrentList(ApplicationExportFormat.Xlsx)">Export as XLSX</button>
                </div>
            }
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(exportError))
    {
        <div role="alert" class="application-export-error">@exportError</div>
    }

    <div class="table-scroll">
    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid #ccc;">
                <th style="padding: 0.5rem; text-align: left;">Applicant</th>
                <th style="padding: 0.5rem; cursor: pointer;" @onclick="SortByScore">Score ↕</th>
                <th style="padding: 0.5rem;">Status</th>
                <th style="padding: 0.5rem;">Decision</th>
                <th style="padding: 0.5rem;">Variance</th>
                <th style="padding: 0.5rem; cursor: pointer;" @onclick="SortByDate">Date ↕</th>
                <th style="padding: 0.5rem;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var app in currentList)
            {
                <tr style="border-bottom: 1px solid #eee;">
                    <td style="padding: 0.5rem;">
                        <div style="font-weight: 600;">@(string.IsNullOrWhiteSpace(app.CandidateName) ? app.CandidateRef : app.CandidateName)</div>
                        @if (!string.IsNullOrWhiteSpace(app.CandidateEmail))
                        {
                            <div style="font-size: 0.8rem; color: #718096;">@app.CandidateEmail</div>
                        }
                    </td>
                    <td style="padding: 0.5rem;">@(app.FinalScore?.ToString("F3") ?? "—")</td>
                    <td style="padding: 0.5rem;">@app.Status</td>
                    <td style="padding: 0.5rem;">@(app.FinalDecision ?? "—")</td>
                    <td style="padding: 0.5rem;">@(app.Variance?.ToString("F3") ?? "—")</td>
                    <td style="padding: 0.5rem; font-size: 0.85rem; color: #718096;">@app.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="padding: 0.5rem;">
                        <button @onclick="@(() => Navigation.NavigateTo($"/applications/{app.Id}"))">View</button>
                        @if (CanReview(app))
                        {
                            <button @onclick="@(() => Navigation.NavigateTo($"/manual-review/{app.Id}"))">Review</button>
                        }
                        else if (CanOverride(app))
                        {
                            <button @onclick="@(() => Navigation.NavigateTo($"/manual-review/{app.Id}"))">Review decision</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
        </div>
    </details>
    </section>

    @if (showHelp)
    {
        <section class="job-help" aria-label="Job detail help">
            <h5>How to use this job page</h5>
            <ol>
                <li><strong>Review and approve the rubric:</strong> open <em>Edit Job</em>, review every extracted requirement, organize items into the correct categories, set scoring thresholds, select rubric approval, and save.</li>
                <li><strong>Complete prompt management:</strong> open <em>Manage Prompts</em>, generate or edit the scoring prompt, test it, and move it through approval until a production-approved prompt is available.</li>
                <li><strong>Upload applications:</strong> this becomes available only after both the rubric and scoring prompt are approved. Uploaded applications start processing automatically.</li>
                <li><strong>Monitor the pipeline:</strong> use Pipeline Status to track processing. Expand Longlist and Shortlist to review candidates against the configured thresholds.</li>
                <li><strong>Investigate results:</strong> open an applicant to review scores and evidence. Use manual review where a result is excluded or requires human judgement.</li>
            </ol>
            <p>Extraction diagnostics and current rubric items are collapsed by default; expand them when you need provenance, validation findings, or the complete rubric.</p>
        </section>
    }

    @if (rubricEnvelope is not null)
    {
        <details class="job-collapsible">
            <summary>Current rubric items (@rubricEnvelope.Items.Count)</summary>
            <div class="job-collapsible-content">
                <RubricEditor Value="rubricEnvelope" />
            </div>
        </details>
    }

    @if (jobConfig?.Extraction is not null)
    {
        <details class="job-collapsible">
            <summary>Extraction diagnostics</summary>
            <div class="job-collapsible-content">
                <div>Instruction version: @jobConfig.Extraction.InstructionVersionId</div>
                <div>Completed: @jobConfig.Extraction.CompletedAt.ToString("u")</div>
                <div>Source: @jobConfig.Extraction.SourceFileName (@jobConfig.Extraction.SourceMimeType)</div>
                @if (jobConfig.Extraction.ValidationFindings.Count > 0)
                {
                    <ul>
                        @foreach (var finding in jobConfig.Extraction.ValidationFindings)
                        {
                            <li>@finding.Code — @finding.Message</li>
                        }
                    </ul>
                }
            </div>
        </details>
    }

    <UploadStatusSurface />
}
else
{
    <p>Loading...</p>
}

@if (showUpload)
{
    <FloatingPanel Title="Upload Applications" InitialWidth="760" InitialHeight="620" OnClose="() => showUpload = false">
        <UploadApplications JobId="@JobId"
                            OnUploaded="OnUploadCompleted"
                            OnOptionalUploadStarted="() => showUpload = false" />
    </FloatingPanel>
}

@if (showBulkScoring)
{
    <FloatingPanel Title="Bulk scoring from SharePoint or OneDrive" InitialWidth="860" InitialHeight="700" OnClose="() => showBulkScoring = false">
        <BulkScoringRequestDialog JobId="@JobId"
                                  RetryOfRequestId="@retryBulkRequestId"
                                  OnStarted="OnBulkScoringStartedAsync"
                                  OnClose="() => showBulkScoring = false" />
    </FloatingPanel>
}

@if (showPrompts)
{
    <FloatingPanel Title="Prompt Management" InitialWidth="1000" InitialHeight="760" OnClose="() => showPrompts = false">
        <PromptManagement JobId="@JobId"
                          HasApprovedRubric="hasApprovedRubric"
                          ProductionPromptId="@productionPromptId"
                          OnPromptStatusChange="OnPromptStatusChanged" />
    </FloatingPanel>
}

@if (showDeleteDialog)
{
    <ConfirmDeleteJobDialog Visible="true"
                            JobTitle="@(job?.Title ?? "")"
                            ApplicationCount="@(applicationCounts?.Total ?? 0)"
                            OnConfirm="ConfirmDelete"
                            OnCancel="CancelDelete" />
}

@if (showEditDialog)
{
    <CreateJobDialog Visible="true"
                     EditingJob="job"
                     EditingConfig="jobConfig"
                     OnUpdated="OnEditCompleted"
                     OnCancel="() => showEditDialog = false" />
}

@if (!string.IsNullOrEmpty(deleteError))
{
    <div style="padding: 0.5rem; background: #fef2f2; border: 1px solid #fca5a5; border-radius: 4px; color: #991b1b; margin-bottom: 1rem;">
        @deleteError
    </div>
}

@if (!string.IsNullOrEmpty(editError))
{
    <div style="padding: 0.5rem; background: #fef2f2; border: 1px solid #fca5a5; border-radius: 4px; color: #991b1b; margin-bottom: 1rem;">
        @editError
    </div>
}

@code {
    [Parameter] public string JobId { get; set; } = "";

    private JobDto? job;
    private JobApplicationCountsDto? applicationCounts;
    private BulkCountsDto? bulkPipelineCounts;
    private string? retryBulkRequestId;
    private string? bulkDetailRequestId;
    private List<ApplicationDto> shortlistApps = new();
    private List<ApplicationDto> longlistApps = new();
    private List<ApplicationDto> excludedApps = new();
    private List<ApplicationDto> reviewApps = new();
    private List<ApplicationDto> failedApps = new();
    private readonly HashSet<string> loadedTabs = [];
    private string activeTab = "shortlist";
    private bool showUpload;
    private bool showBulkScoring;
    private bool bulkScoringAvailable;
    private BulkScoringRequestsPanel? bulkRequestsPanel;
    private bool showPrompts;
    private bool showHelp;
    private bool isProcessRequestInFlight;
    private List<string> processingErrors = new();
    private string sortField = "none";
    private bool sortAscending;
    private bool hasProductionApprovedPrompt;
    private PromptProfileStatusDto? productionProfileStatus;
    private bool hasApprovedRubric;
    private bool isAdmin;
    private bool showDeleteDialog;
    private bool showEditDialog;
    private bool isLoadingEditConfig;
    private string? deleteError;
    private string? editError;
    private string applicantSearch = string.Empty;
    private bool showExportMenu;
    private string? exportError;
    private List<ScoringPromptDto> promptVersions = new();
    private string? productionPromptId;
    private JobConfigDto? jobConfig;
    private RubricEnvelopeDto? rubricEnvelope;
    [CascadingParameter] public PollingSettingsState? PollingSettings { get; set; }
    private AsyncRefreshLoop? statusRefresh;
    private string? statusRefreshError;
    private readonly CancellationTokenSource lifetime = new();
    private readonly SemaphoreSlim applicationRefreshGate = new(1, 1);
    private bool initialStatusLoaded;
    private TimeSpan StatusInterval => TimeSpan.FromSeconds(PollingSettings?.Current.StatusPollingIntervalSeconds ?? 60);
    private bool _jobDisposed;

    private double EffectiveLonglistThreshold => jobConfig?.LonglistThreshold ?? 70;
    private double EffectiveShortlistThreshold => jobConfig?.ShortlistThreshold ?? 85;
    private bool CanUploadApplications => hasApprovedRubric
        && hasProductionApprovedPrompt
        && productionProfileStatus?.IsMatch == true;
    private string UploadApplicationsTitle => CanUploadApplications
        ? "Upload candidate applications"
        : productionProfileStatus is { IsMatch: false }
            ? "Blocked until the production prompt is retested and approved with the current backend model and reasoning level."
            : "Available after the job rubric and scoring prompt are production-approved.";

    private string BulkScoringTitle => CanUploadApplications
        ? "Score every file in a SharePoint or OneDrive folder in the background"
        : UploadApplicationsTitle;

    // The action only appears when the environment has the feature switched on; any failure just hides it.
    private async Task LoadBulkScoringAvailabilityAsync()
    {
        try
        {
            bulkScoringAvailable = (await Api.GetBulkScoringCapabilitiesAsync()).Enabled;
        }
        catch
        {
            bulkScoringAvailable = false;
        }
    }

    private List<ApplicationDto> currentList
    {
        get
        {
            var source = activeTab switch
            {
                "longlist" => longlistApps,
                "excluded" => excludedApps,
                "review" => reviewApps,
                _ => shortlistApps
            };

            IEnumerable<ApplicationDto> filtered = source;
            if (!string.IsNullOrWhiteSpace(applicantSearch))
            {
                var searchTerm = applicantSearch.Trim();
                filtered = filtered.Where(application =>
                    MatchesApplicantSearch(application, searchTerm));
            }

            return (sortField, sortAscending) switch
            {
                ("score", true) => filtered.OrderBy(application =>
                    Math.Round(application.FinalScore ?? 0, 3)).ToList(),
                ("score", false) => filtered.OrderByDescending(application =>
                    Math.Round(application.FinalScore ?? 0, 3)).ToList(),
                ("date", true) => filtered.OrderBy(application =>
                    application.CreatedAt).ToList(),
                ("date", false) => filtered.OrderByDescending(application =>
                    application.CreatedAt).ToList(),
                _ => filtered.ToList(),
            };
        }
    }

    private static bool MatchesApplicantSearch(ApplicationDto application, string searchTerm)
    {
        return (!string.IsNullOrWhiteSpace(application.CandidateName)
                && application.CandidateName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
               || (!string.IsNullOrWhiteSpace(application.CandidateRef)
                   && application.CandidateRef.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
    }

    private static bool CanReview(ApplicationDto application) =>
        application.Status == "NeedsManualReview"
        || application.FinalDecision == "NeedsManualReview";

    private static bool CanOverride(ApplicationDto application) =>
        application.FinalDecision == "Excluded";

    private string TabStyle(string tab) => activeTab == tab
        ? "font-weight: bold; border-bottom: 2px solid #333; padding: 0.5rem 1rem;"
        : "padding: 0.5rem 1rem;";

    private async Task SelectTab(string tab)
    {
        activeTab = tab;
        showExportMenu = false;
        exportError = null;
        await LoadTabAsync(tab);
    }

    private async Task ExportCurrentList(ApplicationExportFormat format)
    {
        showExportMenu = false;
        exportError = null;
        var export = ApplicationExportBuilder.Create(
            currentList,
            job?.Title ?? "job",
            activeTab,
            format);

        try
        {
            await JS.InvokeVoidAsync(
                "talentMatchDownloadBase64",
                export.FileName,
                export.ContentType,
                Convert.ToBase64String(export.Content));
        }
        catch (JSException exception)
        {
            exportError = $"Unable to export {activeTab}: {exception.Message}";
        }
    }

    private static RubricEnvelopeDto? TryParseRubricEnvelope(string? rubricJson)
    {
        if (string.IsNullOrWhiteSpace(rubricJson))
            return null;

        try
        {
            var envelope = JsonSerializer.Deserialize<RubricEnvelopeDto>(rubricJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            return string.Equals(envelope?.SchemaVersion, "rubric-v2", StringComparison.Ordinal) ? envelope : null;
        }
        catch
        {
            return null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        retryBulkRequestId = GetQueryValue("retryBulkRequestId");
        bulkDetailRequestId = GetQueryValue("bulkRequestId");
        showBulkScoring = HasSourceConnectionResume() || !string.IsNullOrWhiteSpace(retryBulkRequestId);

        var currentUserTask = Api.GetCurrentUserAsync();
        var jobTask = Api.GetJobAsync(JobId);
        await Task.WhenAll(currentUserTask, jobTask);
        if (_jobDisposed) return;

        var currentUser = await currentUserTask;
        isAdmin = currentUser?.Role == "admin";
        job = await jobTask;

        _ = LoadSecondaryDataAsync();
    }

    private async Task LoadSecondaryDataAsync()
    {
        var initialApplicationLoad = RefreshApplicationStatusAsync();
        var otherLoads = Task.WhenAll(
            TryLoadSecondaryAsync(LoadPromptStatus),
            TryLoadSecondaryAsync(LoadBulkScoringAvailabilityAsync));

        await initialApplicationLoad;
        if (_jobDisposed) return;
        initialStatusLoaded = true;
        StartBackgroundRefresh();
        await otherLoads;
        if (_jobDisposed) return;
        await InvokeAsync(() =>
        {
            ReconcileProcessingErrors();
            if (HasPendingApps)
            {
                StartBackgroundRefresh();
            }
            StateHasChanged();
        });
    }

    private static async Task TryLoadSecondaryAsync(Func<Task> load)
    {
        try
        {
            await load();
        }
        catch
        {
            // Each secondary surface remains independently retryable through its normal refresh path.
        }
    }

    private bool HasSourceConnectionResume()
    {
        return !string.IsNullOrWhiteSpace(GetQueryValue("sourceConnectionId"))
            || GetQueryValue("resumeBulkScoring") == "1";
    }

    private string? GetQueryValue(string name)
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (Uri.UnescapeDataString(parts[0]).Equals(name, StringComparison.OrdinalIgnoreCase))
                return parts.Length == 2 ? Uri.UnescapeDataString(parts[1].Replace("+", " ")) : "";
        }
        return null;
    }

    private async Task LoadPromptStatus()
    {
        var configTask = Api.GetJobConfigAsync(JobId);
        var promptsTask = Api.GetPromptsAsync(JobId);
        await Task.WhenAll(configTask, promptsTask);

        var config = await configTask;
        jobConfig = config;
        rubricEnvelope = TryParseRubricEnvelope(config?.RubricJson);
        hasApprovedRubric =
            !string.IsNullOrWhiteSpace(config?.RubricJson) &&
            string.Equals(config?.RubricApprovalStatus, "approved", StringComparison.OrdinalIgnoreCase);

        promptVersions = await promptsTask;
        var productionPrompt = promptVersions.FirstOrDefault(p => p.Status == "production-approved");
        hasProductionApprovedPrompt = productionPrompt is not null;
        productionPromptId = productionPrompt?.Id;
        if (productionPrompt is null)
        {
            productionProfileStatus = null;
        }
        else
        {
            try
            {
                productionProfileStatus = await Api.GetPromptProfileStatusAsync(
                    JobId, productionPrompt.Id);
            }
            catch
            {
                // Compatibility for API mocks and rolling deployments. The production API
                // enforces the profile again before upload, queue claim, and submission.
                productionProfileStatus = new PromptProfileStatusDto(
                    productionPrompt.Id,
                    productionPrompt.ApprovedModelId ?? productionPrompt.ModelId,
                    productionPrompt.ApprovedReasoningLevel ?? productionPrompt.ReasoningLevel,
                    productionPrompt.ApprovedModelId ?? productionPrompt.ModelId,
                    productionPrompt.ApprovedReasoningLevel ?? productionPrompt.ReasoningLevel,
                    true,
                    true,
                    productionPrompt.ApprovedTestRunId,
                    null);
            }
        }
    }

    private async Task OnPromptStatusChanged()
    {
        await LoadPromptStatus();
        StateHasChanged();
    }

    private void SortByScore()
    {
        if (sortField == "score") sortAscending = !sortAscending;
        else { sortField = "score"; sortAscending = false; }
    }

    private void SortByDate()
    {
        if (sortField == "date") sortAscending = !sortAscending;
        else { sortField = "date"; sortAscending = false; }
    }

    private async Task LoadTabAsync(string tab, bool force = false)
    {
        if (!force && loadedTabs.Contains(tab))
            return;
        var applications = await Api.GetApplicationsAsync(JobId, tab, cancellationToken: lifetime.Token);
        switch (tab)
        {
            case "longlist":
                longlistApps = applications;
                break;
            case "excluded":
                excludedApps = applications;
                break;
            case "review":
                reviewApps = applications;
                break;
            default:
                shortlistApps = applications;
                break;
        }
        loadedTabs.Add(tab);
    }

    private async Task OnBulkScoringStartedAsync()
    {
        StartBackgroundRefresh();
        try
        {
            await RefreshApplicationDataAsync();
            if (HasPendingApps)
            {
                StartBackgroundRefresh();
            }
            if (bulkRequestsPanel is not null) await bulkRequestsPanel.RefreshAsync();
        }
        catch
        {
            // The periodic refreshes keep both pipeline and request progress live after acceptance.
        }
    }

    private void OnBulkPipelineCountsChanged(BulkCountsDto? counts)
    {
        bulkPipelineCounts = counts;
    }

    private void OpenBulkRetry(string requestId)
    {
        retryBulkRequestId = requestId;
        showBulkScoring = true;
    }

    private void OpenNewBulkScoring()
    {
        retryBulkRequestId = null;
        bulkDetailRequestId = null;
        Navigation.NavigateTo(
            Navigation.ToAbsoluteUri(Navigation.Uri).GetLeftPart(UriPartial.Path),
            replace: true);
        showBulkScoring = true;
    }

    private async Task RefreshApplicationDataAsync()
    {
        await applicationRefreshGate.WaitAsync(lifetime.Token);
        try
        {
            var countsTask = Api.GetJobApplicationCountsAsync(JobId, lifetime.Token);
            var tabTask = LoadTabAsync(activeTab, force: true);
            await Task.WhenAll(countsTask, tabTask);
            applicationCounts = await countsTask;
            failedApps = applicationCounts.Failed > 0
                ? await Api.GetApplicationsAsync(JobId, "failed", cancellationToken: lifetime.Token)
                : [];
        }
        finally
        {
            applicationRefreshGate.Release();
        }
    }

    private async Task OnUploadCompleted()
    {
        showUpload = false;
        await ProcessJob();
    }

    private async Task ProcessJob()
    {
        if (isProcessRequestInFlight) return;

        isProcessRequestInFlight = true;
        processingErrors.Clear();
        try
        {
            var result = await Api.ProcessJobAsync(JobId);
            if (result.Errors.Any())
                processingErrors.AddRange(result.Errors);
        }
        catch (Exception ex)
        {
            processingErrors.Add($"Request failed: {ex.Message}");
        }
        finally
        {
            isProcessRequestInFlight = false;
        }

        await RefreshApplicationDataAsync();
        ReconcileProcessingErrors();
        StartBackgroundRefresh();
    }

    private bool isReAggregating;
    private string? reAggregateMessage;

    private async Task ReAggregate()
    {
        isReAggregating = true;
        reAggregateMessage = null;
        try
        {
            var result = await Api.ReAggregateJobAsync(JobId);
            if (result.Error != null)
                reAggregateMessage = result.Error;
            else
                reAggregateMessage = $"Updated {result.Updated} of {result.Total} applications.";
        }
        catch (Exception ex)
        {
            reAggregateMessage = $"Failed: {ex.Message}";
        }
        await RefreshApplicationDataAsync();
        ReconcileProcessingErrors();
        isReAggregating = false;
    }

    private bool HasPendingApps => applicationCounts?.Pending > 0;
    private bool HasFailedApps => applicationCounts?.Failed > 0;

    private void ReconcileProcessingErrors()
    {
        if (!HasFailedApps)
            processingErrors.Clear();
        else
            processingErrors = failedApps
                .Select(application => $"Application {application.CandidateName ?? application.Id}: {application.LastError ?? "Scoring failed. See Failure Queue for details."}")
                .ToList();
    }

    private void StartBackgroundRefresh()
    {
        if (statusRefresh is not null || _jobDisposed || !initialStatusLoaded) return;
        statusRefresh = new(StatusInterval, Services.GetService<TimeProvider>() ?? TimeProvider.System, _ => InvokeAsync(async () =>
        {
            if (_jobDisposed) return;
            await RefreshApplicationStatusAsync();
            if (!_jobDisposed)
                StateHasChanged();
        }), DispatchExceptionAsync);
        statusRefresh.Start();
    }

    private async Task RefreshApplicationStatusAsync()
    {
        try
        {
            await RefreshApplicationDataAsync();
            ReconcileProcessingErrors();
            statusRefreshError = null;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            statusRefreshError = $"Status refresh failed: {exception.Message}";
        }
    }

    protected override void OnParametersSet() => statusRefresh?.UpdateInterval(StatusInterval);

    private void OpenDeleteDialog()
    {
        showDeleteDialog = true;
        deleteError = null;
    }

    private async Task OpenEditDialog()
    {
        if (isLoadingEditConfig)
            return;

        isLoadingEditConfig = true;
        editError = null;
        try
        {
            var latestJob = await Api.GetJobAsync(JobId);
            var latestConfig = await Api.GetJobConfigAsync(JobId);
            if (latestJob is null || latestConfig is null)
            {
                editError = "The latest job configuration could not be loaded. Please refresh and try again.";
                return;
            }

            job = latestJob;
            jobConfig = latestConfig;
            rubricEnvelope = TryParseRubricEnvelope(latestConfig.RubricJson);
            showEditDialog = true;
        }

        catch (ApiException ex)
        {
            editError = $"Failed to load the latest configuration: {ex.Message}";
        }
        catch (HttpRequestException ex)
        {
            editError = $"Failed to load the latest configuration: {ex.Message}";
        }
        catch (JsonException)
        {
            editError = "The latest configuration response was invalid. Please refresh and try again.";
        }
        finally
        {
            isLoadingEditConfig = false;
        }
    }

    private async Task ToggleEditDialog()
    {
        if (showEditDialog)
        {
            showEditDialog = false;
            return;
        }

        await OpenEditDialog();
    }

    private async Task ConfirmDelete()
    {
        showDeleteDialog = false;
        var success = await Api.DeleteJobAsync(JobId);
        if (success)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            deleteError = "Failed to delete job. Please try again.";
        }
    }

    private void CancelDelete()
    {
        showDeleteDialog = false;
    }

    private async Task OnEditCompleted()
    {
        showEditDialog = false;
        job = await Api.GetJobAsync(JobId);
        await RefreshApplicationDataAsync();
        await LoadPromptStatus();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_jobDisposed)
            return;
        _jobDisposed = true;
        var stopping = statusRefresh?.DisposeAsync() ?? ValueTask.CompletedTask;
        await lifetime.CancelAsync();
        await stopping;
        lifetime.Dispose();
    }
}

