@page "/jobs/{JobId}"
@using TalentMatch.Web.Client.Services
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Navigation

<h3>Job Detail</h3>

@if (job != null)
{
    <div style="margin-bottom: 1rem;">
        <h4>@job.Title</h4>
        <p>@job.Organisation — @job.Department | Status: @job.Status</p>
        <div style="display: flex; gap: 0.5rem;">
            <button @onclick="() => showUpload = true" style="padding: 0.5rem 1rem; background: #3182ce; color: white; border: none; border-radius: 4px;">Upload Applications</button>
            <button @onclick="() => showPrompts = !showPrompts" style="padding: 0.5rem 1rem; background: #805ad5; color: white; border: none; border-radius: 4px;">Manage Prompts</button>
            <button @onclick="ProcessJob" disabled="@(isProcessRequestInFlight || !hasProductionApprovedPrompt)" style="padding: 0.5rem 1rem;" title="@(!hasProductionApprovedPrompt ? "Requires a production-approved prompt (FR-032)" : "")">
                @(isProcessRequestInFlight ? "Starting..." : (isProcessing ? "Processing..." : "Process Applications"))
            </button>
            <button @onclick="ReAggregate" disabled="@isReAggregating" style="padding: 0.5rem 1rem; background: #d69e2e; color: white; border: none; border-radius: 4px;" title="Recompute decisions from existing scoring runs (no API calls)">
                @(isReAggregating ? "Re-aggregating..." : "🔄 Re-aggregate")
            </button>
            <button @onclick="() => showEditDialog = true" aria-label="Edit job configuration" style="padding: 0.5rem 1rem; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer;">✏️ Edit Job</button>
            @if (isAdmin)
            {
                <button @onclick="OpenDeleteDialog" style="padding: 0.5rem 1rem; background: #dc2626; color: white; border: none; border-radius: 4px;">Delete Job</button>
            }
            @if (!hasProductionApprovedPrompt)
            {
                <span style="color: #e53e3e; font-size: 0.85rem; align-self: center;">⚠️ Production-approved prompt required</span>
            }
        </div>
    </div>

    <div style="margin-bottom: 1.5rem;">
        <h5>Pipeline Status</h5>
        <PipelineVisualizer Applications="allApps" />
    </div>

    @if (processingErrors.Any())
    {
        <div style="background: #fee2e2; border: 1px solid #fca5a5; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1rem; color: #991b1b;">
            <strong>Processing Errors (@processingErrors.Count):</strong>
            <ul style="margin: 0.25rem 0 0 1rem; padding: 0;">
                @foreach (var err in processingErrors)
                {
                    <li style="font-size: 0.85rem;">@err</li>
                }
            </ul>
        </div>
    }
    @if (!string.IsNullOrEmpty(reAggregateMessage))
    {
        <div style="background: #fefce8; border: 1px solid #fde68a; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1rem; color: #854d0e; font-size: 0.9rem;">
            🔄 @reAggregateMessage
        </div>
    }

    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
        <button @onclick="@(() => activeTab = "longlist")" style="@TabStyle("longlist")">Longlist ≥ @EffectiveLonglistThreshold.ToString("F0") (@longlist.Count)</button>
        <button @onclick="@(() => activeTab = "shortlist")" style="@TabStyle("shortlist")">Shortlist ≥ @EffectiveShortlistThreshold.ToString("F0") (@shortlist.Count)</button>
        <button @onclick="@(() => activeTab = "excluded")" style="@TabStyle("excluded")">Excluded (@excluded.Count)</button>
    </div>

    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
        <input
            @bind="applicantSearch"
            @bind:event="oninput"
            placeholder="Search applicant name"
            aria-label="Search by applicant name"
            style="padding: 0.45rem 0.6rem; min-width: 300px; border: 1px solid #cbd5e0; border-radius: 6px;" />
        @if (!string.IsNullOrWhiteSpace(applicantSearch))
        {
            <button @onclick="() => applicantSearch = string.Empty" style="padding: 0.4rem 0.75rem;">Clear</button>
        }
    </div>

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 2px solid #ccc;">
                <th style="padding: 0.5rem; text-align: left;">Applicant</th>
                <th style="padding: 0.5rem; cursor: pointer;" @onclick="SortByScore">Score ↕</th>
                <th style="padding: 0.5rem;">Status</th>
                <th style="padding: 0.5rem;">Decision</th>
                <th style="padding: 0.5rem;">Variance</th>
                <th style="padding: 0.5rem; cursor: pointer;" @onclick="SortByDate">Date ↕</th>
                <th style="padding: 0.5rem;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var app in currentList)
            {
                <tr style="border-bottom: 1px solid #eee;">
                    <td style="padding: 0.5rem;">
                        <div style="font-weight: 600;">@(string.IsNullOrWhiteSpace(app.CandidateName) ? app.CandidateRef : app.CandidateName)</div>
                        @if (!string.IsNullOrWhiteSpace(app.CandidateEmail))
                        {
                            <div style="font-size: 0.8rem; color: #718096;">@app.CandidateEmail</div>
                        }
                    </td>
                    <td style="padding: 0.5rem;">@(app.FinalScore?.ToString("F1") ?? "—")</td>
                    <td style="padding: 0.5rem;">@app.Status</td>
                    <td style="padding: 0.5rem;">@(app.FinalDecision ?? "—")</td>
                    <td style="padding: 0.5rem;">@(app.Variance?.ToString("F1") ?? "—")</td>
                    <td style="padding: 0.5rem; font-size: 0.85rem; color: #718096;">@app.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="padding: 0.5rem;">
                        <button @onclick="@(() => Navigation.NavigateTo($"/applications/{app.Id}"))">View</button>
                        @if (app.FinalDecision == "NeedsManualReview" || app.FinalDecision == "Excluded")
                        {
                            <button @onclick="@(() => Navigation.NavigateTo($"/manual-review/{app.Id}"))">Review</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Loading...</p>
}

@if (showUpload)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; display: flex; align-items: center; justify-content: center;" @onclick="() => showUpload = false">
        <div @onclick:stopPropagation>
            <UploadApplications JobId="@JobId" OnUploaded="OnUploadCompleted" />
        </div>
    </div>
}

@if (showPrompts)
{
    <div style="margin-bottom: 1.5rem; padding: 1rem; border: 1px solid #ddd; border-radius: 8px; background: #fafafa;">
        <PromptManagement JobId="@JobId" HasApprovedRubric="hasApprovedRubric" OnPromptStatusChange="OnPromptStatusChanged" />
        <hr style="margin: 1rem 0;" />
        <PromptTestRunner JobId="@JobId" ActivePrompt="activePrompt" OnPromptStatusChange="OnPromptStatusChanged" />
    </div>
}

@if (showDeleteDialog)
{
    <ConfirmDeleteJobDialog Visible="true"
                            JobTitle="@(job?.Title ?? "")"
                            ApplicationCount="@(allApps.Count)"
                            OnConfirm="ConfirmDelete"
                            OnCancel="CancelDelete" />
}

@if (showEditDialog)
{
    <CreateJobDialog Visible="true"
                     EditingJob="job"
                     EditingConfig="jobConfig"
                     OnUpdated="OnEditCompleted"
                     OnCancel="() => showEditDialog = false" />
}

@if (!string.IsNullOrEmpty(deleteError))
{
    <div style="padding: 0.5rem; background: #fef2f2; border: 1px solid #fca5a5; border-radius: 4px; color: #991b1b; margin-bottom: 1rem;">
        @deleteError
    </div>
}

@code {
    [Parameter] public string JobId { get; set; } = "";

    private JobDto? job;
    private List<ApplicationDto> allApps = new();
    private string activeTab = "longlist";
    private bool showUpload;
    private bool showPrompts;
    private bool isProcessing;
    private bool isProcessRequestInFlight;
    private List<string> processingErrors = new();
    private string sortField = "none";
    private bool sortAscending;
    private bool hasProductionApprovedPrompt;
    private bool hasApprovedRubric;
    private bool isAdmin;
    private bool showDeleteDialog;
    private bool showEditDialog;
    private string? deleteError;
    private string applicantSearch = string.Empty;
    private ScoringPromptDto? activePrompt;
    private JobConfigDto? jobConfig;
    private System.Threading.Timer? _jobPollTimer;
    private System.Threading.Timer? _bgRefreshTimer;
    private bool _jobDisposed;

    private double EffectiveLonglistThreshold => jobConfig?.LonglistThreshold ?? 70;
    private double EffectiveShortlistThreshold => jobConfig?.ShortlistThreshold ?? 85;

    // Longlist is inclusive by threshold, so shortlist is naturally a subset
    // when shortlist threshold >= longlist threshold.
    private List<ApplicationDto> longlist => allApps
        .Where(a => a.FinalScore.HasValue && a.FinalScore.Value >= EffectiveLonglistThreshold)
        .ToList();

    private List<ApplicationDto> shortlist => allApps
        .Where(a => a.FinalScore.HasValue && a.FinalScore.Value >= EffectiveShortlistThreshold)
        .ToList();

    private List<ApplicationDto> excluded => allApps.Where(a => a.FinalDecision == "Excluded").ToList();

    private List<ApplicationDto> currentList
    {
        get
        {
            var source = activeTab switch
            {
                "shortlist" => shortlist,
                "excluded" => excluded,
                _ => longlist
            };

            if (string.IsNullOrWhiteSpace(applicantSearch))
                return source;

            var searchTerm = applicantSearch.Trim();
            return allApps.Where(a => MatchesApplicantSearch(a, searchTerm)).ToList();
        }
    }

    private static bool MatchesApplicantSearch(ApplicationDto application, string searchTerm)
    {
        return (!string.IsNullOrWhiteSpace(application.CandidateName)
                && application.CandidateName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
               || (!string.IsNullOrWhiteSpace(application.CandidateRef)
                   && application.CandidateRef.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
    }

    private string TabStyle(string tab) => activeTab == tab
        ? "font-weight: bold; border-bottom: 2px solid #333; padding: 0.5rem 1rem;"
        : "padding: 0.5rem 1rem;";

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await Api.GetCurrentUserAsync();
        isAdmin = currentUser?.Role == "admin";

        job = await Api.GetJobAsync(JobId);
        allApps = await Api.GetApplicationsAsync(JobId);
        ApplySort();
        await LoadPromptStatus();

        // Start fast polling if apps are actively being processed (Scoring/Extracting/Aggregating)
        if (HasActivelyProcessingApps)
        {
            isProcessing = true;
            StartJobPolling();
        }

        // Always run a background refresh every 15 seconds for status freshness
        StartBackgroundRefresh();
    }

    private async Task LoadPromptStatus()
    {
        var config = await Api.GetJobConfigAsync(JobId);
        jobConfig = config;
        hasApprovedRubric =
            !string.IsNullOrWhiteSpace(config?.RubricJson) &&
            string.Equals(config?.RubricApprovalStatus, "approved", StringComparison.OrdinalIgnoreCase);

        var prompts = await Api.GetPromptsAsync(JobId);
        hasProductionApprovedPrompt = prompts.Any(p => p.Status == "production-approved");
        activePrompt = prompts.FirstOrDefault(p => p.Status == "active" || p.Status == "production-approved");
    }

    private async Task OnPromptStatusChanged()
    {
        await LoadPromptStatus();
        StateHasChanged();
    }

    private void SortByScore()
    {
        if (sortField == "score") sortAscending = !sortAscending;
        else { sortField = "score"; sortAscending = false; }
        ApplySort();
    }

    private void SortByDate()
    {
        if (sortField == "date") sortAscending = !sortAscending;
        else { sortField = "date"; sortAscending = false; }
        ApplySort();
    }

    private void ApplySort()
    {
        allApps = (sortField, sortAscending) switch
        {
            ("score", true) => allApps.OrderBy(a => a.FinalScore).ToList(),
            ("score", false) => allApps.OrderByDescending(a => a.FinalScore).ToList(),
            ("date", true) => allApps.OrderBy(a => a.CreatedAt).ToList(),
            ("date", false) => allApps.OrderByDescending(a => a.CreatedAt).ToList(),
            _ => allApps
        };
    }

    private async Task OnUploadCompleted()
    {
        showUpload = false;
        allApps = await Api.GetApplicationsAsync(JobId);
        ApplySort();
    }

    private async Task ProcessJob()
    {
        if (isProcessRequestInFlight) return;

        isProcessRequestInFlight = true;
        isProcessing = true;
        processingErrors.Clear();
        try
        {
            var result = await Api.ProcessJobAsync(JobId);
            if (result.Errors.Any())
                processingErrors.AddRange(result.Errors);
        }
        catch (Exception ex)
        {
            processingErrors.Add($"Request failed: {ex.Message}");
        }
        finally
        {
            isProcessRequestInFlight = false;
        }

        allApps = await Api.GetApplicationsAsync(JobId);
        ApplySort();
        StartJobPolling();
    }

    private bool isReAggregating;
    private string? reAggregateMessage;

    private async Task ReAggregate()
    {
        isReAggregating = true;
        reAggregateMessage = null;
        try
        {
            var result = await Api.ReAggregateJobAsync(JobId);
            if (result.Error != null)
                reAggregateMessage = result.Error;
            else
                reAggregateMessage = $"Updated {result.Updated} of {result.Total} applications.";
        }
        catch (Exception ex)
        {
            reAggregateMessage = $"Failed: {ex.Message}";
        }
        allApps = await Api.GetApplicationsAsync(JobId);
        ApplySort();
        isReAggregating = false;
    }

    private bool HasPendingApps => allApps.Any(a => a.Status is "Queued" or "Extracting" or "Scoring" or "Aggregating");
    private bool HasActivelyProcessingApps => allApps.Any(a => a.Status is "Extracting" or "Scoring" or "Aggregating");

    private void StartJobPolling()
    {
        if (_jobPollTimer != null) return;
        _jobPollTimer = new System.Threading.Timer(async _ =>
        {
            if (_jobDisposed) return;
            try
            {
                var updated = await Api.GetApplicationsAsync(JobId);
                await InvokeAsync(() =>
                {
                    allApps = updated;
                    ApplySort();
                    StateHasChanged();
                    if (!HasPendingApps)
                    {
                        isProcessing = false;
                        StopJobPolling();
                    }
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void StopJobPolling()
    {
        _jobPollTimer?.Dispose();
        _jobPollTimer = null;
    }

    private void StartBackgroundRefresh()
    {
        _bgRefreshTimer = new System.Threading.Timer(async _ =>
        {
            if (_jobDisposed) return;
            try
            {
                var updated = await Api.GetApplicationsAsync(JobId);
                await InvokeAsync(() =>
                {
                    allApps = updated;
                    ApplySort();
                    // If fast poll isn't running but there are now pending apps, start it
                    if (HasPendingApps && _jobPollTimer == null)
                    {
                        isProcessing = true;
                        StartJobPolling();
                    }
                    StateHasChanged();
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    private void OpenDeleteDialog()
    {
        showDeleteDialog = true;
        deleteError = null;
    }

    private async Task ConfirmDelete()
    {
        showDeleteDialog = false;
        var success = await Api.DeleteJobAsync(JobId);
        if (success)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            deleteError = "Failed to delete job. Please try again.";
        }
    }

    private void CancelDelete()
    {
        showDeleteDialog = false;
    }

    private async Task OnEditCompleted()
    {
        showEditDialog = false;
        job = await Api.GetJobAsync(JobId);
        allApps = await Api.GetApplicationsAsync(JobId);
        ApplySort();
        await LoadPromptStatus();
        StateHasChanged();
    }

    public void Dispose()
    {
        _jobDisposed = true;
        StopJobPolling();
        _bgRefreshTimer?.Dispose();
        _bgRefreshTimer = null;
    }
}
