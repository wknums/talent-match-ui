@page "/"
@using TalentMatch.Web.Client.Services
@inject ApiClient Api
@inject NavigationManager Navigation
@implements IDisposable

<h3>Dashboard</h3>

@if (stats != null)
{
    <div style="display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap;">
        <div style="padding: 1rem; border: 1px solid #ccc; border-radius: 8px; min-width: 120px;">
            <div style="font-size: 2rem; font-weight: bold;">@stats.TotalJobs</div>
            <div>Total Jobs</div>
        </div>
        <div style="padding: 1rem; border: 1px solid #ccc; border-radius: 8px; min-width: 120px;">
            <div style="font-size: 2rem; font-weight: bold;">@stats.TotalApplications</div>
            <div>Applications</div>
        </div>
        <div style="padding: 1rem; border: 1px solid #ccc; border-radius: 8px; min-width: 120px;">
            <div style="font-size: 2rem; font-weight: bold;">@stats.Queued</div>
            <div>Queued</div>
        </div>
        <div style="padding: 1rem; border: 1px solid #ccc; border-radius: 8px; min-width: 120px;">
            <div style="font-size: 2rem; font-weight: bold;">@stats.Completed</div>
            <div>Completed</div>
        </div>
        <div style="padding: 1rem; border: 1px solid #ccc; border-radius: 8px; min-width: 120px;">
            <div style="font-size: 2rem; font-weight: bold;">@stats.Failed</div>
            <div>Failed</div>
        </div>
    </div>
    <p style="font-size: 0.8rem; color: #595959;">Last updated: @lastUpdated.ToString("HH:mm:ss")</p>
}
else if (!string.IsNullOrEmpty(statsLoadError))
{
    <div style="padding: 0.5rem; background: #fef2f2; border: 1px solid #fca5a5; border-radius: 4px; color: #991b1b; margin-bottom: 1rem;">
        Failed to load statistics: @statsLoadError
    </div>
}

<div style="display: flex; gap: 1rem; margin-bottom: 1rem;">
    <select @bind="organisationFilter" @bind:after="OnOrganisationFilterChanged" aria-label="Filter jobs by organisation" style="padding: 0.5rem;">
        <option value="">All Organisations</option>
        @foreach (var org in organisations)
        {
            <option value="@org">@org</option>
        }
    </select>
    <select @bind="departmentFilter" aria-label="Filter jobs by department" style="padding: 0.5rem;">
        <option value="">All Departments</option>
        @foreach (var dept in departments)
        {
            <option value="@dept">@dept</option>
        }
    </select>
    <button @onclick="LoadJobs">Filter</button>
    <button @onclick="() => showCreateJob = true" style="padding: 0.5rem 1rem; background: #2b6cb0; color: white; border: none; border-radius: 4px;">Create Job</button>
    @if (canViewAnalytics)
    {
        <button @onclick='() => Navigation.NavigateTo("/analytics")' style="padding: 0.5rem 1rem; background: #276749; color: white; border: none; border-radius: 4px;">View Analytics</button>
    }
</div>

@if (showCreateJob)
{
    <CreateJobDialog Visible="true" OnCreated="OnJobCreated" OnCancel="() => showCreateJob = false" />
}

<h4>Jobs</h4>
@if (!string.IsNullOrEmpty(jobLoadError))
{
    <div style="padding: 0.5rem; background: #fef2f2; border: 1px solid #fca5a5; border-radius: 4px; color: #991b1b; margin-bottom: 1rem;">
        Failed to load jobs: @jobLoadError
    </div>
}

@if (!string.IsNullOrEmpty(deleteError))
{
    <div style="padding: 0.5rem; background: #fef2f2; border: 1px solid #fca5a5; border-radius: 4px; color: #991b1b; margin-bottom: 1rem;">
        @deleteError
    </div>
}

@if (filteredJobs.Any())
{
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem;">
        @foreach (var job in filteredJobs)
        {
            <div style="border: 1px solid #ccc; border-radius: 8px; padding: 1rem; cursor: pointer; position: relative;" @onclick="() => ViewJob(job.Id)">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                    <h5 style="margin: 0;">@job.Title</h5>
                    @if (isAdmin)
                    {
                        <button @onclick="(e) => OpenDeleteDialog(e, job)" @onclick:stopPropagation="true"
                                style="background: none; border: none; cursor: pointer; font-size: 1.1rem; padding: 0.25rem; color: #dc2626;"
                                title="Delete job">🗑️</button>
                    }
                </div>
                <p style="margin: 0.25rem 0;">@job.Organisation — @job.Department</p>
                <p style="font-size: 0.8rem; color: #595959; margin: 0.25rem 0;">Posted @((DateTime.UtcNow - job.PostingDate).Days) days ago</p>
                <p style="font-size: 0.8rem; color: #595959; margin: 0.25rem 0;">Created @job.CreatedAt.ToString("MMM d, yyyy") by @job.CreatedByName</p>
                @if (job.TotalApplications > 0)
                {
                    <p style="font-size: 0.8rem; color: #555; margin: 0.25rem 0;">@job.CompletedApplications / @job.TotalApplications completed</p>
                }
                else
                {
                    <p style="font-size: 0.8rem; color: #999; margin: 0.25rem 0;">0 applications</p>
                }
                <span style="background: @(job.Status == "active" ? "#4caf50" : "#999"); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.8rem;">@job.Status</span>
            </div>
        }
    </div>
}
else if (string.IsNullOrEmpty(jobLoadError))
{
    <p>No jobs found.</p>
}

@if (showDeleteDialog)
{
    <ConfirmDeleteJobDialog Visible="true"
                            JobTitle="@(jobToDelete?.Title ?? "")"
                            ApplicationCount="@(jobToDelete?.TotalApplications ?? 0)"
                            OnConfirm="ConfirmDelete"
                            OnCancel="CancelDelete" />
}

@code {
    private List<JobSummaryDto> jobs = new();
    private SystemStatsDto? stats;
    private DateTime lastUpdated;
    private string organisationFilter = "";
    private string departmentFilter = "";
    private System.Threading.Timer? refreshTimer;
    private bool showCreateJob;
    private string? jobLoadError;
    private string? statsLoadError;
    private string? deleteError;
    private bool isAdmin;
    private bool canViewAnalytics;
    private bool showDeleteDialog;
    private JobSummaryDto? jobToDelete;

    private List<string> organisations => jobs
        .Select(j => j.Organisation).Distinct().OrderBy(o => o).ToList();

    // Departments are scoped to the selected organisation so the two filters cannot form an empty combination.
    private IEnumerable<JobSummaryDto> organisationScopedJobs => string.IsNullOrEmpty(organisationFilter)
        ? jobs : jobs.Where(j => j.Organisation == organisationFilter);

    private List<string> departments => organisationScopedJobs
        .Select(j => j.Department).Distinct().OrderBy(d => d).ToList();

    private IEnumerable<JobSummaryDto> filteredJobs => string.IsNullOrEmpty(departmentFilter)
        ? organisationScopedJobs
        : organisationScopedJobs.Where(j => j.Department == departmentFilter);

    private void OnOrganisationFilterChanged()
    {
        if (!string.IsNullOrEmpty(departmentFilter) && !departments.Contains(departmentFilter))
            departmentFilter = "";
    }

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await Api.GetCurrentUserAsync();
        isAdmin = currentUser?.Role == "admin";
        canViewAnalytics = currentUser?.Role == "admin" || currentUser?.Role == "recruiter";

        await LoadData();
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await LoadStats();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadData()
    {
        await LoadJobs();
        await LoadStats();
    }

    private async Task LoadJobs()
    {
        try
        {
            jobLoadError = null;
            jobs = await Api.GetJobsAsync();
        }
        catch (Exception ex)
        {
            jobLoadError = ex.Message;
            jobs = new();
        }
    }

    private async Task LoadStats()
    {
        try
        {
            statsLoadError = null;
            stats = await Api.GetSystemStatsAsync();
            lastUpdated = DateTime.Now;
        }
        catch (Exception ex)
        {
            stats = null;
            statsLoadError = ex.Message;
        }
    }

    private void ViewJob(string jobId)
    {
        Navigation.NavigateTo($"/jobs/{jobId}");
    }

    private void OpenDeleteDialog(MouseEventArgs e, JobSummaryDto job)
    {
        jobToDelete = job;
        showDeleteDialog = true;
        deleteError = null;
    }

    private async Task ConfirmDelete()
    {
        if (jobToDelete == null) return;

        var deletedJob = jobToDelete;
        showDeleteDialog = false;
        jobToDelete = null;

        // Optimistic removal
        jobs.Remove(deletedJob);
        StateHasChanged();

        var success = await Api.DeleteJobAsync(deletedJob.Id);
        if (!success)
        {
            // Rollback
            jobs.Add(deletedJob);
            deleteError = $"Failed to delete job \"{deletedJob.Title}\". Please try again.";
        }
        else
        {
            deleteError = null;
            await LoadStats();
        }
    }

    private void CancelDelete()
    {
        showDeleteDialog = false;
        jobToDelete = null;
    }

    public void Dispose() => refreshTimer?.Dispose();

    private async Task OnJobCreated()
    {
        showCreateJob = false;
        await LoadJobs();
    }
}
