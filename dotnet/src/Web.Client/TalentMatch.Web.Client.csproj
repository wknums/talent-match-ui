<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(DotNetPatchVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="$(DotNetPatchVersion)" />
    <PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" Version="$(DotNetPatchVersion)" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="$(DotNetPatchVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(DotNetPatchVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
