@using TalentMatch.Web.Client.Services
@inject ApiClient Api
@inject PublicAuthConfiguration AuthConfiguration
@inject NavigationManager Navigation
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img class="navbar-brand-logo"
                 src="images/logo_1_puzzle.png"
                 alt="" />
            <span>TalentMatch</span>
        </a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="nav flex-column">
        @if (currentUser != null)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
                </NavLink>
            </div>
            @if (CanManageUsers)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="users">
                        <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> @AdministrationLabel
                    </NavLink>
                </div>
                @if (AuthConfiguration.IsEntra)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="organizations">
                            <span class="bi bi-diagram-3-fill-nav-menu" aria-hidden="true"></span> Organizations
                        </NavLink>
                    </div>
                }
            }
            @if (IsGlobalAdmin)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="failure-queue">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Failure Queue
                    </NavLink>
                </div>
                <details class="nav-group px-3">
                    <summary class="nav-group-label">
                        <span class="bi bi-sliders-nav-menu" aria-hidden="true"></span>
                        System Configuration
                    </summary>
                    <div class="nav-item nav-subitem">
                        <NavLink class="nav-link" href="extraction-instructions">
                            Job Extraction Prompt
                        </NavLink>
                    </div>
                    <div class="nav-item nav-subitem">
                        <NavLink class="nav-link" href="scoring-prompt-generation">
                            Scoring Prompt Generation
                        </NavLink>
                    </div>
                    <div class="nav-item nav-subitem">
                        <NavLink class="nav-link" href="settings">
                            Settings
                        </NavLink>
                    </div>
                </details>
            }
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Login
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private UserInfo? currentUser;
    private bool disposed;

    private bool IsGlobalAdmin => AuthConfiguration.IsEntra
        ? Api.CurrentAuthorizationContext?.GlobalRole == "admin"
        : string.Equals(currentUser?.Role, "admin", StringComparison.OrdinalIgnoreCase);
    private bool CanManageUsers => IsGlobalAdmin
        || (AuthConfiguration.IsEntra
            && string.Equals(currentUser?.Role, "organization_admin", StringComparison.OrdinalIgnoreCase));
    private string AdministrationLabel => AuthConfiguration.IsEntra ? "Access management" : "Users";

    protected override async Task OnInitializedAsync()
    {
        Api.AuthorizationChanged += AuthorizationChanged;
        Navigation.LocationChanged += LocationChanged;
        currentUser = await Api.GetCurrentUserAsync();
    }
    private void AuthorizationChanged()
    {
        if (AuthConfiguration.IsEntra) currentUser = Api.CurrentAuthorizationContext?.ToUserInfo();
        _ = InvokeAsync(StateHasChanged);
    }
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        if (AuthConfiguration.IsSimple)
            _ = InvokeAsync(async () =>
            {
                currentUser = await Api.GetCurrentUserAsync();
                if (!disposed) StateHasChanged();
            });
    }
    public void Dispose()
    {
        disposed = true;
        Api.AuthorizationChanged -= AuthorizationChanged;
        Navigation.LocationChanged -= LocationChanged;
    }
}
