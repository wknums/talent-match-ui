@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using TalentMatch.Web.Client.Services
@inject NavigationShellState ShellState
@inject NavigationManager Navigation
@inject BuildInfoService BuildInfo
@inject ApiClient Api
@inject PublicAuthConfiguration AuthConfiguration

<PollingSettingsProvider>
<div class="page @ShellStateClass">
    <div class="sidebar" id="@ShellState.RegionElementId" inert="@(!ShellState.NavigationVisible)">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <button type="button"
                    class="navigation-toggle"
                    data-testid="navigation-toggle"
                    aria-label="@ShellState.ToggleLabel"
                    aria-expanded="@(ShellState.NavigationVisible ? "true" : "false")"
                    aria-controls="@ShellState.RegionElementId"
                    @onclick="ToggleAsync">
                <span class="navigation-toggle-icon" aria-hidden="true"></span>
            </button>
            <div class="top-row-actions">
                <button type="button"
                        class="about-button"
                        data-testid="about-button"
                        @onclick="OpenAboutAsync">
                    About
                </button>
                <UserMenu />
            </div>
        </div>

        @if (ShellState.Notification is { } notification)
        {
            <div class="navigation-notification" role="alert">
                <span>@notification.Message</span>
                @if (notification.IsRetryable)
                {
                    <button type="button"
                            class="navigation-notification-retry"
                            data-action="retry-navigation"
                            @onclick="ToggleAsync">
                        Retry
                    </button>
                }
            </div>
        }

        @if (RequiresCurrentAuthority && Api.CurrentAuthorizationContext is null)
        {
            <div class="alert alert-warning mx-4" role="alert">
                Current access is being checked or is no longer available. Contact an administrator if access was removed.
                <button class="btn btn-link" @onclick="RefreshAccessAsync">Refresh access</button>
                @if (accessRefreshFailed) { <span>Access could not be refreshed. Try again or sign in again.</span> }
            </div>
        }
        <article class="content px-4" inert="@(RequiresCurrentAuthority && Api.CurrentAuthorizationContext is null)">
            @Body
        </article>
    </main>

    @if (ShellState.IsCompact && ShellState.CompactOverlayOpen)
    {
        <div class="navigation-backdrop"
             data-testid="navigation-backdrop"
             aria-hidden="true"
             @onclick="CloseOverlay"></div>
    }

    @if (showAbout)
    {
        <div class="about-backdrop" @onclick="CloseAbout">
            <section class="about-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="about-title"
                     @onclick:stopPropagation="true">
                <header>
                    <h2 id="about-title">About TalentMatch</h2>
                    <button type="button" aria-label="Close About" @onclick="CloseAbout">X</button>
                </header>
                @if (loadingBuildStamp)
                {
                    <p role="status">Loading build information...</p>
                }
                else if (buildStamp is not null)
                {
                    <dl>
                        <dt>Release</dt>
                        <dd data-testid="about-release">@buildStamp.Version</dd>
                        <dt>Build date</dt>
                        <dd data-testid="about-build-date">@FormatBuildDate(buildStamp.CreatedAtUtc)</dd>
                    </dl>
                }
                else
                {
                    <p role="alert">@buildStampError</p>
                }
            </section>
        </div>
    }
</div>
</PollingSettingsProvider>

@code {
    private bool accessRefreshFailed;
    private bool RequiresCurrentAuthority => AuthConfiguration.IsEntra
        && !Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("authentication/", StringComparison.OrdinalIgnoreCase)
        && !Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Equals("login", StringComparison.OrdinalIgnoreCase);
    private async Task RefreshAccessAsync()
    {
        accessRefreshFailed = false;
        try { accessRefreshFailed = (await Api.GetCurrentUserResultAsync()).User is null; }
        catch (HttpRequestException) { accessRefreshFailed = true; }
        catch (TaskCanceledException) { accessRefreshFailed = true; }
        catch (Microsoft.AspNetCore.Components.WebAssembly.Authentication.AccessTokenNotAvailableException)
        { accessRefreshFailed = true; }
    }
    private bool showAbout;
    private bool loadingBuildStamp;
    private BuildStamp? buildStamp;
    private string buildStampError = "Build information is unavailable.";

    private string ShellStateClass => ShellState.IsCompact
        ? (ShellState.CompactOverlayOpen ? "navigation-overlay-open" : "navigation-overlay-closed")
        : (ShellState.DesktopCollapsed ? "navigation-collapsed" : "navigation-expanded");

    protected override async Task OnInitializedAsync()
    {
        Api.AuthorizationChanged += OnAuthorizationChanged;
        ShellState.Changed += OnShellStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await ShellState.InitializeAsync();
    }

    private Task ToggleAsync() => ShellState.ToggleAsync();
    private void OnAuthorizationChanged() => _ = InvokeAsync(StateHasChanged);

    private void CloseOverlay() => ShellState.CloseCompactOverlay();

    private async Task OpenAboutAsync()
    {
        showAbout = true;
        if (buildStamp is not null || loadingBuildStamp) return;

        loadingBuildStamp = true;
        try
        {
            buildStamp = await BuildInfo.GetBuildStampAsync();
            if (buildStamp is null
                || string.IsNullOrWhiteSpace(buildStamp.Version)
                || string.IsNullOrWhiteSpace(buildStamp.CreatedAtUtc))
            {
                buildStamp = null;
                buildStampError = "Build information is incomplete.";
            }
        }
        catch (Exception ex)
        {
            buildStampError = ex.Message;
        }
        finally
        {
            loadingBuildStamp = false;
        }
    }

    private void CloseAbout() => showAbout = false;

    private static string FormatBuildDate(string? value) =>
        DateTimeOffset.TryParse(value, out var date)
            ? date.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'")
            : value ?? "Unavailable";

    private void OnShellStateChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
        => ShellState.OnRouteChanged();

    public void Dispose()
    {
        Api.AuthorizationChanged -= OnAuthorizationChanged;
        ShellState.Changed -= OnShellStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
