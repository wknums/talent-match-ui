@using TalentMatch.Web.Client.Services
@inject ApiClient Api

<div>
    <h4>Scoring Prompt Management</h4>

    @if (!HasApprovedRubric)
    {
        <div style="padding: 1rem; background: #fef3cd; border-radius: 4px; margin-bottom: 1rem;">
            ⚠️ Job must have an approved rubric before managing prompts (FR-033)
        </div>
    }
    else
    {
        <details style="margin-bottom:1rem; border:1px solid #cbd5e1; border-radius:6px; padding:0.75rem;">
            <summary style="font-weight:600; cursor:pointer;">Prompt generation instructions</summary>
            <p style="color:#4a5568; margin-bottom:0.5rem;">
                An active job instruction overrides the active system default. Creating or editing always makes a new immutable version.
            </p>
            <textarea @bind="instructionText" rows="5" placeholder="Job-specific generation instruction" style="width:100%;"></textarea>
            <input @bind="instructionChangeNote" placeholder="Change note (optional)" style="width:100%; margin-top:0.35rem;" />
            <div style="margin-top:0.5rem;">
                <ReasoningProfileFields Catalog="reasoningCatalog"
                                        @bind-ModelId="instructionModelId"
                                        @bind-ReasoningLevel="instructionReasoningLevel"
                                        Disabled="isSavingInstruction" />
            </div>
            <button @onclick="CreateInstruction" disabled="@isSavingInstruction" style="margin-top:0.5rem;">
                @(isSavingInstruction ? "Creating..." : "Create instruction draft")
            </button>
            @foreach (var instruction in instructions)
            {
                <div style="display:flex; justify-content:space-between; gap:0.5rem; margin-top:0.5rem; padding:0.5rem; background:#f8fafc;">
                    <span>v@instruction.VersionNumber — @instruction.Status — @instruction.CreatedBy</span>
                    <span style="font-size:0.8rem; color:#475569;">
                        @instruction.ModelId / @instruction.ReasoningLevel
                    </span>
                    @if (instruction.Status != "active")
                    {
                        <button @onclick="() => ActivateInstruction(instruction.Id)">Activate</button>
                    }
                </div>
            }
        </details>

        @if (productionProfileStatus is { IsMatch: false })
        {
            <div role="alert" style="padding:0.85rem; margin-bottom:1rem; background:#fee2e2; border:2px solid #dc2626; border-radius:6px; color:#7f1d1d;">
                <strong>Scoring profile mismatch — production scoring is blocked.</strong>
                <div>@productionProfileStatus.MismatchMessage</div>
            </div>
        }

        <!-- Creation controls -->
        <div style="margin-bottom:1rem;">
            <strong>New scoring prompt profile</strong>
            <ReasoningProfileFields Catalog="reasoningCatalog"
                                    @bind-ModelId="editorModelId"
                                    @bind-ReasoningLevel="editorReasoningLevel"
                                    Disabled="@(isSaving || isGenerating)" />
        </div>
        <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
            <button @onclick="StartManualCreate" style="padding: 0.5rem 1rem; background: #2b6cb0; color: white; border: none; border-radius: 4px;">✏️ Write Manually</button>
            <button @onclick="StartFileImport" style="padding: 0.5rem 1rem; background: #805ad5; color: white; border: none; border-radius: 4px;">📄 Import File</button>
            <button @onclick="GenerateFromRubric" disabled="@isGenerating" style="padding: 0.5rem 1rem; background: #d69e2e; color: white; border: none; border-radius: 4px;">
                @(isGenerating ? "Generating..." : "⚡ Generate from Rubric")
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(generationError))
        {
            <div style="padding: 0.75rem; margin-bottom: 1rem; background: #fff5f5; border: 1px solid #fed7d7; border-radius: 4px; color: #9b2c2c;">
                ⚠️ @generationError
            </div>
        }

        <!-- Editor (shown when creating/editing) -->
        @if (showEditor)
        {
            <div style="margin-bottom: 1rem;">
                <textarea @bind="editorText" rows="10" style="width: 100%; padding: 0.5rem; font-family: var(--app-font-mono);"></textarea>
                <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
                    <button @onclick="SavePrompt" disabled="@isSaving" style="padding: 0.5rem 1rem; background: #276749; color: white; border: none; border-radius: 4px;">
                        @(isSaving ? "Saving..." : "Save Prompt")
                    </button>
                    <button @onclick="() => showEditor = false" style="padding: 0.5rem 1rem;">Cancel</button>
                </div>
            </div>
        }

        <!-- Prompt list -->
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 2px solid #ccc;">
                    <th style="padding: 0.5rem;">Version</th>
                    <th style="padding: 0.5rem;">Status</th>
                    <th style="padding: 0.5rem;">Source</th>
                    <th style="padding: 0.5rem;">Profile snapshot</th>
                    <th style="padding: 0.5rem;">Rating</th>
                    <th style="padding: 0.5rem;">Created</th>
                    <th style="padding: 0.5rem;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prompt in prompts)
                {
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: 0.5rem;">v@(prompt.VersionNumber)</td>
                        <td style="padding: 0.5rem;">
                            <span style="@StatusStyle(prompt.Status)">@prompt.Status</span>
                            @if (IsProductionPrompt(prompt))
                            {
                                <span style="display: inline-block; margin-left: 0.35rem; padding: 2px 6px; font-size: 0.75rem; background: #c6f6d5; color: #22543d; border-radius: 4px; font-weight: bold;">
                                    Current production prompt
                                </span>
                            }
                        </td>
                        <td style="padding: 0.5rem;">@prompt.Source</td>
                        <td style="padding: 0.5rem; font-size:0.85rem;">@prompt.ModelId / @prompt.ReasoningLevel</td>
                        <td style="padding: 0.5rem;">@(prompt.Rating.HasValue ? $"⭐ {prompt.Rating}/5" : "—")</td>
                        <td style="padding: 0.5rem;">@prompt.CreatedAt.ToString("g")</td>
                        <td style="padding: 0.5rem; display: flex; gap: 0.25rem; flex-wrap: wrap;">
                            <button @onclick="() => EditPrompt(prompt)" title="Edit">✏️</button>
                            @if (prompt.Status != "active" && prompt.Status != "production-approved")
                            {
                                <button @onclick="() => ActivatePrompt(prompt)" title="Activate">▶️</button>
                            }
                            @if (prompt.Status == "active")
                            {
                                <button @onclick="() => ShowRating(prompt)" title="Rate">⭐</button>
                            }
                            @if (prompt.Status == "inactive" && !IsProductionPrompt(prompt))
                            {
                                <button @onclick="() => SetAsProduction(prompt)" style="padding: 2px 6px; font-size: 0.8rem; background: #276749; color: white; border: none; border-radius: 4px;" title="Set as the active production prompt">🚀 Use for Production</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Rating dialog -->
        @if (ratingPrompt != null)
        {
            <div style="margin-top: 1rem; padding: 1rem; border: 1px solid #ccc; border-radius: 4px;">
                <h5>Rate Prompt v@(ratingPrompt.VersionNumber)</h5>
                <div style="margin-bottom: 0.5rem;">
                    Rating (0-5): <input type="number" @bind="ratingValue" min="0" max="5" style="width: 60px;" />
                </div>
                <div style="margin-bottom: 0.5rem;">
                    Comments: <textarea @bind="ratingComments" rows="2" style="width: 100%;"></textarea>
                </div>
                <button @onclick="SubmitRating" style="padding: 0.5rem 1rem;">Save Rating</button>
                <button @onclick="() => ratingPrompt = null" style="padding: 0.5rem 1rem;">Cancel</button>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string JobId { get; set; } = "";
    [Parameter] public bool HasApprovedRubric { get; set; }
    [Parameter] public string? ProductionPromptId { get; set; }
    [Parameter] public EventCallback OnPromptStatusChange { get; set; }

    private List<ScoringPromptDto> prompts = new();
    private bool showEditor;
    private string editorText = "";
    private string editorSource = "manual";
    private string? editingPromptId;
    private bool isSaving;
    private bool isGenerating;
    private string? generationError;
    private ScoringPromptDto? ratingPrompt;
    private int ratingValue;
    private string ratingComments = "";
    private List<PromptGenerationInstructionDto> instructions = new();
    private PromptProfileStatusDto? productionProfileStatus;
    private string instructionText = "";
    private string? instructionChangeNote;
    private bool isSavingInstruction;
    private ReasoningModelsResponseDto? reasoningCatalog;
    private string instructionModelId = "";
    private string instructionReasoningLevel = "high";
    private string editorModelId = "";
    private string editorReasoningLevel = "high";

    protected override async Task OnInitializedAsync()
    {
        await LoadPrompts();
    }

    private async Task LoadPrompts()
    {
        try
        {
            var promptsTask = Api.GetPromptsAsync(JobId);
            prompts = await promptsTask;
            try
            {
                reasoningCatalog = await Api.GetReasoningModelsAsync();
            }
            catch (Exception ex)
            {
                reasoningCatalog = null;
                generationError = $"Supported models could not be loaded: {ex.Message}";
            }
            if (reasoningCatalog is null)
                return;
            if (string.IsNullOrWhiteSpace(instructionModelId))
                instructionModelId = reasoningCatalog.DefaultModel;
            if (!reasoningCatalog.SupportedReasoningEfforts.Contains(instructionReasoningLevel))
                instructionReasoningLevel = reasoningCatalog.DefaultReasoningEffort;
            if (string.IsNullOrWhiteSpace(editorModelId))
                editorModelId = reasoningCatalog.DefaultModel;
            if (!reasoningCatalog.SupportedReasoningEfforts.Contains(editorReasoningLevel))
                editorReasoningLevel = reasoningCatalog.DefaultReasoningEffort;
            try
            {
                instructions = await Api.GetPromptGenerationInstructionsAsync(JobId);
            }
            catch
            {
                instructions = new();
            }
            var production = prompts.FirstOrDefault(IsProductionPrompt);
            if (production is null)
            {
                productionProfileStatus = null;
            }
            else
            {
                try
                {
                    productionProfileStatus = await Api.GetPromptProfileStatusAsync(
                        JobId, production.Id);
                }
                catch
                {
                    productionProfileStatus = null;
                }
            }
        }

        catch (Exception ex)
        {
            // A failed refresh must not tear the component down: keep the list that is already on
            // screen and explain why it is not current.
            generationError = $"The prompt list could not be refreshed: {ex.Message}";
        }
    }

    private async Task CreateInstruction()
    {
        if (string.IsNullOrWhiteSpace(instructionText)) return;
        isSavingInstruction = true;
        try
        {
            await Api.CreatePromptGenerationInstructionAsync(
                JobId,
                instructionText,
                instructionChangeNote,
                instructionModelId,
                instructionReasoningLevel);
            instructionText = "";
            instructionChangeNote = null;
            await LoadPrompts();
        }
        catch (ApiException ex)
        {
            generationError = ex.Message;
        }
        finally
        {
            isSavingInstruction = false;
        }
    }

    private async Task ActivateInstruction(string instructionId)
    {
        try
        {
            await Api.ActivatePromptGenerationInstructionAsync(JobId, instructionId);
            await LoadPrompts();
        }
        catch (ApiException ex)
        {
            generationError = ex.Message;
        }
    }

    private void StartManualCreate()
    {
        generationError = null;
        editorText = "";
        editorSource = "manual";
        editingPromptId = null;
        showEditor = true;
    }

    private void StartFileImport()
    {
        generationError = null;
        editorText = "// Paste imported prompt content here";
        editorSource = "imported";
        editingPromptId = null;
        showEditor = true;
    }

    private async Task GenerateFromRubric()
    {
        generationError = null;
        isGenerating = true;
        StateHasChanged();
        try
        {
            var result = await Api.GeneratePromptAsync(
                JobId,
                editorModelId,
                editorReasoningLevel);
            if (result != null)
            {
                editorText = result.PromptText;
                editorSource = "generated";
                await LoadPrompts();
                var generatedPrompt = prompts.OrderByDescending(p => p.VersionNumber).FirstOrDefault();
                editingPromptId = generatedPrompt?.Id;
                showEditor = true;
            }
            else
            {
                generationError = "Prompt generation did not return any content.";
            }
        }
        catch (ApiException ex)
        {
            generationError = ex.Message;
        }
        catch (Exception ex)
        {
            generationError = $"Failed to generate prompt: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task SavePrompt()
    {
        isSaving = true;
        generationError = null;
        StateHasChanged();
        try
        {
            var saved = editingPromptId != null
                ? await Api.EditPromptAsync(
                    JobId,
                    editingPromptId,
                    editorText,
                    editorModelId,
                    editorReasoningLevel)
                : await Api.CreatePromptAsync(
                    JobId,
                    editorText,
                    editorSource,
                    editorModelId,
                    editorReasoningLevel);

            if (saved is null)
            {
                // Leave the editor open so a rejected save does not discard what the user wrote.
                generationError = "The prompt could not be saved. Your text has been kept - please try again.";
                return;
            }

            showEditor = false;
            await LoadPrompts();
            await OnPromptStatusChange.InvokeAsync();
        }
        catch (HttpRequestException ex)
        {
            generationError = $"The prompt could not be saved: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void EditPrompt(ScoringPromptDto prompt)
    {
        generationError = null;
        editorText = prompt.PromptText;
        editorSource = prompt.Source;
        editingPromptId = prompt.Id;
        editorModelId = prompt.ModelId;
        editorReasoningLevel = prompt.ReasoningLevel;
        showEditor = true;
    }

    private async Task ActivatePrompt(ScoringPromptDto prompt)
    {
        await Api.ActivatePromptAsync(JobId, prompt.Id);
        await LoadPrompts();
        await OnPromptStatusChange.InvokeAsync();
    }

    private async Task SetAsProduction(ScoringPromptDto prompt)
    {
        try
        {
            await Api.SetProductionPromptAsync(JobId, prompt.Id);
            await LoadPrompts();
            await OnPromptStatusChange.InvokeAsync();
        }
        catch (ApiException ex)
        {
            generationError = ex.Message;
        }
    }

    private void ShowRating(ScoringPromptDto prompt)
    {
        ratingPrompt = prompt;
        ratingValue = prompt.Rating ?? 0;
        ratingComments = prompt.Comments ?? "";
    }

    private async Task SubmitRating()
    {
        if (ratingPrompt != null)
        {
            await Api.RatePromptAsync(JobId, ratingPrompt.Id, ratingValue, ratingComments);
            ratingPrompt = null;
            await LoadPrompts();
        }
    }

    private string StatusStyle(string status) => status switch
    {
        "draft" => "padding: 2px 8px; background: #e2e8f0; border-radius: 4px;",
        "active" => "padding: 2px 8px; background: #bee3f8; color: #2b6cb0; border-radius: 4px;",
        "inactive" => "padding: 2px 8px; background: #fefcbf; color: #744210; border-radius: 4px;",
        "production-approved" => "padding: 2px 8px; background: #c6f6d5; color: #22543d; border-radius: 4px;",
        _ => "padding: 2px 8px; background: #eee; border-radius: 4px;"
    };

    private bool IsProductionPrompt(ScoringPromptDto prompt)
        => prompt.Status == "production-approved"
           || (!string.IsNullOrWhiteSpace(ProductionPromptId) && prompt.Id == ProductionPromptId);
}
