@using TalentMatch.Web.Client.Services
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject ApiClient Api
@inject IJSRuntime JS

@if (Visible)
{
    <div class="dialog-backdrop"
         @onclick="HandleBackdropClick"
         @onmousemove="OnMouseMove"
         @onmouseup="OnMouseUp">
        <div class="dialog-window"
             role="dialog"
             aria-modal="true"
             style="left: @(posX)px; top: @(posY)px; width: @(width)px; height: @(height)px;"
             @onclick:stopPropagation="true">
            @* Drag handle (title bar) *@
            <div class="dialog-header"
                 @onmousedown="OnHeaderMouseDown">
                <h4 style="margin: 0;">@(IsEditMode ? "Edit Job Configuration" : "Create New Job")</h4>
                <button class="dialog-close-btn" aria-label="Close dialog" @onclick="HandleCancel">✕</button>
            </div>

            @* Scrollable body *@
            <div class="dialog-body">

                @* Tab selector — hidden in edit mode *@
                @if (!IsEditMode)
                {
                <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
                    <button @onclick="() => activeTab = Tab.Upload" style="font-weight: @(activeTab == Tab.Upload ? "bold" : "normal");">Upload Spec</button>
                    <button @onclick="() => activeTab = Tab.Manual" style="font-weight: @(activeTab == Tab.Manual ? "bold" : "normal");">Manual Entry</button>
                </div>
                }

                @if (activeTab == Tab.Upload && !IsEditMode)
                {
                    <div style="display: grid; gap: 0.5rem;">
                        <h5>Upload Job Specification</h5>
                        <p style="font-size: 0.85rem; color: #666;">Supported formats: PDF, JPG, Markdown, TXT, DOCX</p>
                        <InputFile OnChange="HandleSpecFileSelected" accept=".pdf,.jpg,.jpeg,.md,.txt,.docx" disabled="@processingSpec" />
                        @if (processingSpec)
                        {
                            <div style="display: flex; align-items: center; gap: 0.5rem; color: #2563eb; padding: 0.5rem; background: #eff6ff; border-radius: 4px;">
                                <span style="animation: pulse 1.5s ease-in-out infinite;">✨</span>
                                <span>Extracting job specification with AI... This may take a moment.</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(specExtractionError))
                        {
                            <div style="padding: 0.5rem; background: #fef2f2; border: 1px solid #fca5a5; border-radius: 4px; color: #991b1b; font-size: 0.85rem;">
                                ❌ @specExtractionError
                            </div>
                        }

                        <h5 style="margin-top: 1rem;">Upload Rubric (optional)</h5>
                        <p style="font-size: 0.85rem; color: #666;">Upload a separate rubric document if not included in the spec.</p>
                        <InputFile OnChange="HandleRubricFileSelected" accept=".pdf,.jpg,.jpeg,.md,.txt,.docx" disabled="@processingRubric" />
                        @if (processingRubric)
                        {
                            <div style="display: flex; align-items: center; gap: 0.5rem; color: #2563eb; padding: 0.5rem; background: #eff6ff; border-radius: 4px;">
                                <span style="animation: pulse 1.5s ease-in-out infinite;">✨</span>
                                <span>Extracting rubric with AI... This may take a moment.</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(rubricExtractionError))
                        {
                            <div style="padding: 0.5rem; background: #fef2f2; border: 1px solid #fca5a5; border-radius: 4px; color: #991b1b; font-size: 0.85rem;">
                                ❌ @rubricExtractionError
                            </div>
                        }
                        @if (rubricTitleMismatch)
                        {
                            <p style="color: #c57600;">⚠️ Warning: The rubric appears to be for a different job title. Please verify it matches the uploaded spec.</p>
                        }
                    </div>
                }

    <div style="display: grid; gap: 0.5rem; margin-top: 1rem;">
        @if (IsEditMode)
        {
            <div style="background: #f3f4f6; padding: 1rem; border-radius: 6px; margin-bottom: 1rem; border: 1px solid #e5e7eb;">
                <h5 style="margin: 0 0 0.5rem;">Job Details (read-only)</h5>
                <div style="display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 1rem; font-size: 0.9rem;">
                    <strong>Title:</strong> <span>@title</span>
                    @if (!string.IsNullOrEmpty(EditingJob?.JobCode))
                    {
                        <strong>Job Code:</strong> <span>@EditingJob.JobCode</span>
                    }
                    <strong>Department:</strong> <span>@department</span>
                    <strong>Organisation:</strong> <span>@organisation</span>
                    <strong>Posting Date:</strong> <span>@postingDate.ToString("yyyy-MM-dd")</span>
                    @if (!string.IsNullOrEmpty(jobDescription))
                    {
                        <strong>Description:</strong> <span>@jobDescription</span>
                    }
                </div>
            </div>
        }
        else
        {
        <input placeholder="Job Title" @bind="title" @oninput="OnTitleInput" />
        @if (validationErrors.ContainsKey("title"))
        {
            <span style="color: #dc2626; font-size: 0.85rem;">@validationErrors["title"]</span>
        }
        <input placeholder="Department" @bind="department" />
        @if (validationErrors.ContainsKey("department"))
        {
            <span style="color: #dc2626; font-size: 0.85rem;">@validationErrors["department"]</span>
        }
        <input placeholder="Organisation" @bind="organisation" />
        @if (validationErrors.ContainsKey("organisation"))
        {
            <span style="color: #dc2626; font-size: 0.85rem;">@validationErrors["organisation"]</span>
        }
        <input type="date" @bind="postingDate" />

        <div>
            <label style="font-size: 0.85rem;">Job Description</label>
            <textarea @bind="jobDescription" rows="4" placeholder="Describe the role and responsibilities..." style="width: 100%;"></textarea>
        </div>
        }

        <h5 style="margin-top: 1rem;">Rubric Categories</h5>
        @for (int i = 0; i < rubricCategories.Count; i++)
        {
            var idx = i;
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <input placeholder="Category Name" value="@rubricCategories[idx].Name" @oninput="(e) => rubricCategories[idx] = rubricCategories[idx] with { Name = e.Value?.ToString() ?? string.Empty }" style="flex: 2;" />
                <input type="number" placeholder="Weight" value="@rubricCategories[idx].Weight" @oninput="(e) => OnWeightInput(idx, e)" step="0.05" style="width: 80px;" />
                <input placeholder="Description" value="@rubricCategories[idx].Description" @oninput="(e) => rubricCategories[idx] = rubricCategories[idx] with { Description = e.Value?.ToString() ?? string.Empty }" style="flex: 2;" />
                <button @onclick="() => RemoveCategory(idx)" style="color: red;">✕</button>
            </div>
        }
        <div style="display: flex; gap: 0.5rem; align-items: center;">
            <button @onclick="AddCategory" style="padding: 0.25rem 0.5rem;">+ Add Category</button>
            <span style="font-size: 0.8rem; color: @(validationErrors.ContainsKey("rubricWeights") ? "#dc2626" : Math.Abs(WeightSum - 1.0) < 0.001 ? "green" : "red");">
                Weight sum: @WeightSum.ToString("F2") @(Math.Abs(WeightSum - 1.0) < 0.001 ? "✓" : "(must equal 1.0)")
            </span>
        </div>
        @if (validationErrors.ContainsKey("rubric"))
        {
            <span style="color: #dc2626; font-size: 0.85rem;">@validationErrors["rubric"]</span>
        }
        @if (validationErrors.ContainsKey("rubricWeights"))
        {
            <span style="color: #dc2626; font-size: 0.85rem;">@validationErrors["rubricWeights"]</span>
        }

        <h5 style="margin-top: 1rem;">Must-Have Criteria</h5>
        @for (int i = 0; i < mustHaveCriteria.Count; i++)
        {
            var idx = i;
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <input value="@mustHaveCriteria[idx]" @oninput="(e) => mustHaveCriteria[idx] = e.Value?.ToString() ?? string.Empty" style="flex: 1;" />
                <button @onclick="() => mustHaveCriteria.RemoveAt(idx)" style="color: red;">✕</button>
            </div>
        }
        <button @onclick="() => mustHaveCriteria.Add(string.Empty)" style="padding: 0.25rem 0.5rem; width: fit-content;">+ Add Must-Have</button>

        <h5 style="margin-top: 1rem;">Desired Criteria</h5>
        @for (int i = 0; i < desiredCriteria.Count; i++)
        {
            var idx = i;
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <input placeholder="Qualification" value="@desiredCriteria[idx].Qualification" @oninput="(e) => desiredCriteria[idx] = desiredCriteria[idx] with { Qualification = e.Value?.ToString() ?? string.Empty }" style="flex: 2;" />
                <input placeholder="Description" value="@desiredCriteria[idx].Description" @oninput="(e) => desiredCriteria[idx] = desiredCriteria[idx] with { Description = e.Value?.ToString() ?? string.Empty }" style="flex: 2;" />
                <button @onclick="() => desiredCriteria.RemoveAt(idx)" style="color: red;">✕</button>
            </div>
        }
        <button @onclick="() => desiredCriteria.Add(new DesiredCriterionInput(string.Empty, string.Empty))" style="padding: 0.25rem 0.5rem; width: fit-content;">+ Add Desired Criterion</button>

        <h5 style="margin-top: 1rem;">Scoring Configuration</h5>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
            <div>
                <label style="font-size: 0.85rem;">Scoring Runs</label>
                <input type="number" @bind="scoringRunCount" style="width: 100%;" />
            </div>
            <div>
                <label style="font-size: 0.85rem;">Aggregation Strategy</label>
                <select @bind="aggregationStrategy" style="width: 100%;">
                    <option value="median">Median</option><option value="mean">Mean</option><option value="weighted">Weighted</option>
                </select>
            </div>
            <div>
                <label style="font-size: 0.85rem;">Longlist Threshold</label>
                <input type="number" @bind="longlistThreshold" step="0.1" style="width: 100%;" />
            </div>
            <div>
                <label style="font-size: 0.85rem;">Shortlist Threshold</label>
                <input type="number" @bind="shortlistThreshold" step="0.1" style="width: 100%;" />
            </div>
            <div>
                <label style="font-size: 0.85rem;">Variance Threshold</label>
                <input type="number" @bind="varianceThreshold" step="0.1" style="width: 100%;" />
            </div>
        </div>

        <div style="margin-top: 1rem; display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button @onclick="HandleCancel">Cancel</button>
            <button @onclick="Submit" disabled="@((!CanSubmit && !IsEditMode) || isSaving)">@(IsEditMode ? "Update Configuration" : "Create Job")</button>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(message))
    {
        @if (success)
        {
            <p style="color: green; padding: 0 1.5rem 1rem;">@message</p>
        }
        else
        {
            <div style="background: #fef2f2; border: 1px solid #fca5a5; color: #991b1b; padding: 0.75rem 1rem; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; margin: 0.5rem 0;">
                <span>@message</span>
                <button @onclick="() => message = null" style="background: none; border: none; color: #991b1b; cursor: pointer; font-size: 1.1rem;">✕</button>
            </div>
        }
    }

            </div>@* end dialog-body *@

            @* Resize handle *@
            <div class="dialog-resize-handle"
                 @onmousedown="OnResizeMouseDown"></div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnCreated { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public JobDto? EditingJob { get; set; }
    [Parameter] public JobConfigDto? EditingConfig { get; set; }
    [Parameter] public EventCallback OnUpdated { get; set; }

    private bool IsEditMode => EditingJob != null;

    private enum Tab { Upload, Manual }
    private Tab activeTab = Tab.Upload;

    // Drag & resize state
    private int posX, posY, width = 750, height = 600;
    private bool _sizedToViewport;
    private const int MinWidth = 500, MinHeight = 400;
    private bool isDragging, isResizing;
    private double dragStartX, dragStartY;
    private int dragOrigX, dragOrigY, resizeOrigW, resizeOrigH;

    private string title = "", department = "", organisation = "", jobDescription = "";
    private DateTime postingDate = DateTime.Today;
    private int scoringRunCount = 3;
    private string aggregationStrategy = "median";
    private double longlistThreshold = 70, shortlistThreshold = 85, varianceThreshold = 15;
    private string? message;
    private bool success;
    private bool processingSpec, processingRubric, rubricTitleMismatch;
    private string? specExtractionError, rubricExtractionError;
    private List<RubricCategoryInput> rubricCategories = new();
    private List<string> mustHaveCriteria = new();
    private List<DesiredCriterionInput> desiredCriteria = new();
    private bool _populated;
    private bool isSaving;
    private Dictionary<string, string> validationErrors = new();

    protected override void OnParametersSet()
    {
        if (Visible && !_sizedToViewport)
        {
            // Will be properly sized in OnAfterRenderAsync via JS interop
        }

        if (IsEditMode && EditingConfig != null && !_populated)
        {
            // Populate config fields
            scoringRunCount = EditingConfig.ScoringRunCount;
            aggregationStrategy = EditingConfig.AggregationStrategy ?? "median";
            longlistThreshold = EditingConfig.LonglistThreshold;
            shortlistThreshold = EditingConfig.ShortlistThreshold;
            varianceThreshold = EditingConfig.VarianceThreshold;

            // Deserialize rubric categories
            if (!string.IsNullOrEmpty(EditingConfig.RubricJson))
            {
                try
                {
                    var rubricItems = JsonSerializer.Deserialize<List<RubricCategoryInput>>(EditingConfig.RubricJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    rubricCategories = rubricItems ?? new();
                }
                catch { rubricCategories = new(); }
            }
            else { rubricCategories = new(); }

            // Deserialize must-have criteria
            if (!string.IsNullOrEmpty(EditingConfig.MustHaveCriteriaJson))
            {
                try
                {
                    var items = JsonSerializer.Deserialize<List<string>>(EditingConfig.MustHaveCriteriaJson);
                    mustHaveCriteria = items ?? new();
                }
                catch { mustHaveCriteria = new(); }
            }
            else { mustHaveCriteria = new(); }

            // Deserialize desired criteria
            if (!string.IsNullOrEmpty(EditingConfig.DesiredCriteriaJson))
            {
                try
                {
                    var items = JsonSerializer.Deserialize<List<DesiredCriterionInput>>(EditingConfig.DesiredCriteriaJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    desiredCriteria = items ?? new();
                }
                catch { desiredCriteria = new(); }
            }
            else { desiredCriteria = new(); }

            // Populate read-only metadata from EditingJob
            title = EditingJob!.Title ?? "";
            department = EditingJob.Department ?? "";
            organisation = EditingJob.Organisation ?? "";
            postingDate = EditingJob.PostingDate;
            jobDescription = EditingJob.JobDescription ?? "";

            _populated = true;
            activeTab = Tab.Manual;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_sizedToViewport)
        {
            _sizedToViewport = true;
            var vw = await JS.InvokeAsync<int>("eval", "window.innerWidth");
            var vh = await JS.InvokeAsync<int>("eval", "window.innerHeight");
            width = (int)(vw * 0.8);
            height = (int)(vh * 0.8);
            posX = (vw - width) / 2;
            posY = (vh - height) / 2;
            StateHasChanged();
        }
    }

    private double WeightSum => rubricCategories.Sum(c => c.Weight);
    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(title)
        && !string.IsNullOrWhiteSpace(department)
        && !string.IsNullOrWhiteSpace(organisation);

    private void AddCategory()
    {
        rubricCategories.Add(new("", 0, ""));
        validationErrors.Remove("rubric");
    }

    private void RemoveCategory(int idx)
    {
        rubricCategories.RemoveAt(idx);
        validationErrors.Remove("rubric");
        validationErrors.Remove("rubricWeights");
    }

    private void OnWeightInput(int idx, ChangeEventArgs e)
    {
        rubricCategories[idx] = rubricCategories[idx] with { Weight = double.TryParse(e.Value?.ToString(), out var w) ? w : 0 };
        validationErrors.Remove("rubricWeights");
    }

    private void OnTitleInput(ChangeEventArgs e)
    {
        title = e.Value?.ToString() ?? "";
        validationErrors.Remove("title");
    }

    private bool Validate()
    {
        validationErrors = new();

        if (!IsEditMode && string.IsNullOrWhiteSpace(title))
            validationErrors["title"] = "Title is required";

        if (!IsEditMode && string.IsNullOrWhiteSpace(department))
            validationErrors["department"] = "Department is required";

        if (!IsEditMode && string.IsNullOrWhiteSpace(organisation))
            validationErrors["organisation"] = "Organisation is required";

        if (!rubricCategories.Any(c => !string.IsNullOrWhiteSpace(c.Name) && c.Weight > 0))
            validationErrors["rubric"] = "At least one rubric category with a name and weight is required";

        if (rubricCategories.Any())
        {
            var weightSum = rubricCategories.Sum(c => c.Weight);
            if (Math.Abs(weightSum - 1.0) > 0.01)
                validationErrors["rubricWeights"] = $"Rubric weights must sum to 1.0 (currently {weightSum:F2})";
        }

        return validationErrors.Count == 0;
    }

    private void HandleBackdropClick()
    {
        ResetForm();
        OnCancel.InvokeAsync();
    }

    private void OnHeaderMouseDown(MouseEventArgs e)
    {
        isDragging = true;
        dragStartX = e.ClientX;
        dragStartY = e.ClientY;
        dragOrigX = posX;
        dragOrigY = posY;
    }

    private void OnResizeMouseDown(MouseEventArgs e)
    {
        isResizing = true;
        dragStartX = e.ClientX;
        dragStartY = e.ClientY;
        resizeOrigW = width;
        resizeOrigH = height;
    }

    private async Task HandleSpecFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        processingSpec = true;
        message = null;
        specExtractionError = null;
        StateHasChanged();;

        try
        {
            // Read file as base64
            var buffer = new byte[file.Size];
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).ReadExactlyAsync(buffer);
            var base64Content = Convert.ToBase64String(buffer);

            var result = await Api.ExtractJobSpecAsync(file.Name, base64Content, file.ContentType);
            if (result != null)
            {
                if (!string.IsNullOrWhiteSpace(result.Title)) title = result.Title;
                if (!string.IsNullOrWhiteSpace(result.Department)) department = result.Department;
                if (!string.IsNullOrWhiteSpace(result.Organisation)) organisation = result.Organisation;
                if (!string.IsNullOrWhiteSpace(result.JobDescription)) jobDescription = result.JobDescription;

                if (result.MustHaves?.Any() == true)
                    mustHaveCriteria = result.MustHaves.Select(m => m.Criterion).ToList();

                if (result.DesiredCriteria?.Any() == true)
                    desiredCriteria = result.DesiredCriteria.Select(d => new DesiredCriterionInput(d.Qualification, d.Description ?? "")).ToList();

                if (result.Rubric?.Any() == true)
                {
                    rubricCategories = result.Rubric.Select(r => new RubricCategoryInput(r.Name, r.Weight, r.Description ?? "")).ToList();
                }
                else if (!rubricCategories.Any())
                {
                    // Auto-generate draft rubric: 60% to must-haves, 40% to desired criteria
                    AutoGenerateDraftRubric();
                }
            }
        }
        catch (Exception ex)
        {
            specExtractionError = $"Failed to extract spec: {ex.Message}";
            message = specExtractionError;
            success = false;
        }
        finally
        {
            processingSpec = false;
            StateHasChanged();
        }
    }

    private async Task HandleRubricFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        processingRubric = true;
        rubricTitleMismatch = false;
        rubricExtractionError = null;
        message = null;
        StateHasChanged();

        try
        {
            var buffer = new byte[file.Size];
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).ReadExactlyAsync(buffer);
            var base64Content = Convert.ToBase64String(buffer);

            var result = await Api.ExtractRubricAsync(file.Name, base64Content, file.ContentType);
            if (result != null)
            {
                if (!string.IsNullOrWhiteSpace(result.Title) && !string.IsNullOrWhiteSpace(title)
                    && !string.Equals(result.Title, title, StringComparison.OrdinalIgnoreCase))
                {
                    rubricTitleMismatch = true;
                }

                if (result.Categories?.Any() == true)
                {
                    rubricCategories = result.Categories.Select(c => new RubricCategoryInput(c.Name, c.Weight, c.Description ?? "")).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            rubricExtractionError = $"Failed to extract rubric: {ex.Message}";
            message = rubricExtractionError;
            success = false;
        }
        finally
        {
            processingRubric = false;
            StateHasChanged();
        }
    }

    private void AutoGenerateDraftRubric()
    {
        var categories = new List<RubricCategoryInput>();
        var mustHaveCount = mustHaveCriteria.Count(c => !string.IsNullOrWhiteSpace(c));
        var desiredCount = desiredCriteria.Count(c => !string.IsNullOrWhiteSpace(c.Qualification));
        var totalCount = mustHaveCount + desiredCount;
        if (totalCount == 0) return;

        var mustHavePool = 0.6;
        var desiredPool = 0.4;

        foreach (var criterion in mustHaveCriteria.Where(c => !string.IsNullOrWhiteSpace(c)))
        {
            categories.Add(new RubricCategoryInput(criterion, mustHaveCount > 0 ? mustHavePool / mustHaveCount : 0, "Must-have requirement"));
        }

        foreach (var criterion in desiredCriteria.Where(c => !string.IsNullOrWhiteSpace(c.Qualification)))
        {
            categories.Add(new RubricCategoryInput(criterion.Qualification, desiredCount > 0 ? desiredPool / desiredCount : 0, criterion.Description));
        }

        // Normalize weights to sum to 1.0
        var sum = categories.Sum(c => c.Weight);
        if (sum > 0)
            categories = categories.Select(c => c with { Weight = Math.Round(c.Weight / sum, 4) }).ToList();

        rubricCategories = categories;
    }

    private async Task Submit()
    {
        if (!Validate()) return;

        var rubricJson = rubricCategories.Any()
            ? JsonSerializer.Serialize(rubricCategories.Where(c => !string.IsNullOrWhiteSpace(c.Name)).Select(c => new { c.Name, c.Weight, c.Description }))
            : null;
        var mustHaveJson = mustHaveCriteria.Any(c => !string.IsNullOrWhiteSpace(c))
            ? JsonSerializer.Serialize(mustHaveCriteria.Where(c => !string.IsNullOrWhiteSpace(c)))
            : null;
        var desiredJson = desiredCriteria.Any(c => !string.IsNullOrWhiteSpace(c.Qualification))
            ? JsonSerializer.Serialize(desiredCriteria.Where(c => !string.IsNullOrWhiteSpace(c.Qualification)).Select(c => new { c.Qualification, c.Description }))
            : null;

        if (IsEditMode)
        {
            isSaving = true;
            try
            {
                await Api.UpdateJobConfigAsync(EditingJob!.Id, new UpdateConfigDto(rubricJson, mustHaveJson, desiredJson, scoringRunCount, aggregationStrategy, longlistThreshold, shortlistThreshold, varianceThreshold));
                success = true;
                message = "Configuration updated!";
                await OnUpdated.InvokeAsync();
                ResetForm();
            }
            catch (ApiException ex)
            {
                message = $"Failed to save: {ex.Message}";
                success = false;
            }
            catch (Exception)
            {
                message = "An unexpected error occurred. Please try again.";
                success = false;
            }
            finally
            {
                isSaving = false;
            }
        }
        else
        {
            try
            {
                var result = await Api.CreateJobAsync(new CreateJobDto(title, department, organisation, postingDate,
                    rubricJson, mustHaveJson, desiredJson, scoringRunCount, aggregationStrategy, longlistThreshold, shortlistThreshold, varianceThreshold,
                    string.IsNullOrWhiteSpace(jobDescription) ? null : jobDescription));
                success = result;
                message = result ? "Job created successfully!" : "Failed to create job.";
                if (result)
                {
                    await OnCreated.InvokeAsync();
                    ResetForm();
                }
            }
            catch (ApiException ex)
            {
                success = false;
                message = ex.Message;
            }
        }
    }

    private void ResetForm()
    {
        title = "";
        department = "";
        organisation = "";
        jobDescription = "";
        postingDate = DateTime.Today;
        scoringRunCount = 3;
        aggregationStrategy = "median";
        longlistThreshold = 70;
        shortlistThreshold = 85;
        varianceThreshold = 15;
        rubricCategories = new();
        mustHaveCriteria = new();
        desiredCriteria = new();
        _populated = false;
        message = null;
        success = false;
        activeTab = Tab.Upload;
        validationErrors = new();
        isSaving = false;
        _sizedToViewport = false;
    }

    private async Task HandleCancel()
    {
        ResetForm();
        await OnCancel.InvokeAsync();
    }

    private record RubricCategoryInput(string Name, double Weight, string Description);
    private record DesiredCriterionInput(string Qualification, string Description);

    private void OnMouseMove(MouseEventArgs e)
    {
        if (isDragging)
        {
            posX = dragOrigX + (int)(e.ClientX - dragStartX);
            posY = dragOrigY + (int)(e.ClientY - dragStartY);
            if (posX < 0) posX = 0;
            if (posY < 0) posY = 0;
        }
        else if (isResizing)
        {
            var newW = resizeOrigW + (int)(e.ClientX - dragStartX);
            var newH = resizeOrigH + (int)(e.ClientY - dragStartY);
            width = Math.Max(MinWidth, newW);
            height = Math.Max(MinHeight, newH);
        }
    }

    private void OnMouseUp(MouseEventArgs e)
    {
        isDragging = false;
        isResizing = false;
    }
}

