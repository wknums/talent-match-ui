    private async Task HandleSpecFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        processingSpec = true;
        message = null;
        specExtractionError = null;
        StateHasChanged();;

        try
        {
            // Read file as base64
            var buffer = new byte[file.Size];
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).ReadExactlyAsync(buffer);
            var base64Content = Convert.ToBase64String(buffer);

            var result = await Api.ExtractJobSpecAsync(file.Name, base64Content, file.ContentType);
            if (result != null)
            {
                if (!string.IsNullOrWhiteSpace(result.Title)) title = result.Title;
                if (!string.IsNullOrWhiteSpace(result.Department)) department = result.Department;
                if (!string.IsNullOrWhiteSpace(result.Organization)) organisation = result.Organization;
                if (!string.IsNullOrWhiteSpace(result.JobDescription)) jobDescription = result.JobDescription;
                extractionId = result.ExtractionId;
                extractionInstructionVersionId = result.InstructionVersionId;
                extractionValidationFindings = result.ValidationFindings ?? new();
                extractionCompletedAt = DateTime.UtcNow;

                MatchExtractedScope();

                if (result.Rubric is not null)
                {
                    ApplyItemizedRubric(result.Rubric);
                }
                else if (!rubricCategories.Any())
                {
                    // Auto-generate draft rubric: 60% to must-haves, 40% to desired criteria
                    AutoGenerateDraftRubric();
                }
            }
        }
        catch (Exception ex)
        {
            specExtractionError = $"Failed to extract spec: {ex.Message}";
            message = specExtractionError;
            success = false;
        }
        finally
        {
            processingSpec = false;
            StateHasChanged();
        }
    }

    private async Task HandleRubricFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        processingRubric = true;
        rubricTitleMismatch = false;
        rubricExtractionError = null;
        message = null;
        StateHasChanged();

        try
        {
            var buffer = new byte[file.Size];
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).ReadExactlyAsync(buffer);
            var base64Content = Convert.ToBase64String(buffer);

            var result = await Api.ExtractRubricAsync(file.Name, base64Content, file.ContentType);
            if (result != null)
            {
                ApplyItemizedRubric(result);
            }
        }
        catch (Exception ex)
        {
            rubricExtractionError = $"Failed to extract rubric: {ex.Message}";
            message = rubricExtractionError;
            success = false;
        }
        finally
        {
            processingRubric = false;
            StateHasChanged();
        }
    }

    private void AutoGenerateDraftRubric()
    {
        rubricEnvelope = null;
        var categories = new List<RubricCategoryInput>();
        var mustHaveCount = mustHaveCriteria.Count(c => !string.IsNullOrWhiteSpace(c));
        var desiredCount = desiredCriteria.Count(c => !string.IsNullOrWhiteSpace(c.Qualification));
        var totalCount = mustHaveCount + desiredCount;
        if (totalCount == 0) return;

        var mustHavePool = 0.6;
        var desiredPool = 0.4;

        foreach (var criterion in mustHaveCriteria.Where(c => !string.IsNullOrWhiteSpace(c)))
        {
            categories.Add(new RubricCategoryInput(criterion, mustHaveCount > 0 ? mustHavePool / mustHaveCount : 0, "Must-have requirement"));
        }

        foreach (var criterion in desiredCriteria.Where(c => !string.IsNullOrWhiteSpace(c.Qualification)))
        {
            categories.Add(new RubricCategoryInput(criterion.Qualification, desiredCount > 0 ? desiredPool / desiredCount : 0, criterion.Description));
        }

        // Normalize weights to sum to 1.0
        var sum = categories.Sum(c => c.Weight);
        if (sum > 0)
            categories = categories.Select(c => c with { Weight = Math.Round(c.Weight / sum, 4) }).ToList();

        rubricCategories = categories;
    }

    private async Task Submit()
    {
        if (isSaving)
            return;

        if (!Validate()) return;

        isSaving = true;
        message = null;

        var rubricJson = rubricEnvelope is not null
            ? JsonSerializer.Serialize(rubricEnvelope)
            : rubricCategories.Any()
            ? JsonSerializer.Serialize(rubricCategories.Where(c => !string.IsNullOrWhiteSpace(c.Name)).Select(c => new { c.Name, c.Weight, c.Description }))
            : null;
        var mustHaveJson = rubricEnvelope is not null
            ? BuildMustHaveProjectionJson(rubricEnvelope)
            : mustHaveCriteria.Any(c => !string.IsNullOrWhiteSpace(c))
            ? JsonSerializer.Serialize(mustHaveCriteria.Where(c => !string.IsNullOrWhiteSpace(c)))
            : null;
        var desiredJson = rubricEnvelope is not null
            ? BuildDesiredProjectionJson(rubricEnvelope)
            : desiredCriteria.Any(c => !string.IsNullOrWhiteSpace(c.Qualification))
            ? JsonSerializer.Serialize(desiredCriteria.Where(c => !string.IsNullOrWhiteSpace(c.Qualification)).Select(c => new { c.Qualification, c.Description }))
            : null;

        if (IsEditMode)
        {
            try
            {
                await Api.UpdateJobConfigAsync(EditingJob!.Id, new UpdateConfigDto(
                    rubricJson,
                    mustHaveJson,
                    desiredJson,
                    scoringRunCount,
                    aggregationStrategy,
                    longlistThreshold,
                    shortlistThreshold,
                    varianceThreshold,
                    extractionId,
                    extractionInstructionVersionId,
                    expectedConfigVersionId,
                    approveRubricOnSave ? "approved" : "draft"));
                success = true;
                message = "Configuration updated!";
                await OnUpdated.InvokeAsync();
                ResetForm();
            }
            catch (ApiException ex)
            {
                success = false;
                if (IsStaleVersion(ex))
                {
                    try
                    {
                        var latestConfig = await Api.GetJobConfigAsync(EditingJob!.Id);
                        expectedConfigVersionId = latestConfig?.Id;
                        message = latestConfig?.Id is null
                            ? "The configuration changed while you were editing. Your changes are preserved; close this dialog, reopen it, and try again."
                            : "The configuration changed while you were editing. Your changes are preserved. Review them, then click Update Configuration again to save against the latest version.";
                    }
                    catch (HttpRequestException)
                    {
                        message = "The configuration changed while you were editing, and the latest version could not be loaded. Your changes are preserved; close this dialog, reopen it, and try again.";
                    }
                    catch (JsonException)
                    {
                        message = "The configuration changed while you were editing, but the latest version response was invalid. Your changes are preserved; close this dialog, reopen it, and try again.";
                    }
                }
                else
                {
                    message = $"Failed to save: {ex.Message}";
                }
            }
            catch (Exception)
            {
                message = "An unexpected error occurred. Please try again.";
                success = false;
            }
            finally
            {
                isSaving = false;
            }
        }
        else
        {
            try
            {
                var result = await Api.CreateJobAsync(new CreateJobDto(title, department, organisation, postingDate,
                    rubricJson, mustHaveJson, desiredJson, scoringRunCount, aggregationStrategy, longlistThreshold, shortlistThreshold, varianceThreshold,
                    string.IsNullOrWhiteSpace(jobDescription) ? null : jobDescription,
                    ExtractionId: extractionId,
                    ExtractionInstructionVersionId: extractionInstructionVersionId,
                    OrganizationId: string.IsNullOrWhiteSpace(selectedOrganizationId) ? null : selectedOrganizationId,
                    DepartmentId: string.IsNullOrWhiteSpace(selectedDepartmentId) ? null : selectedDepartmentId));
                success = result;
                message = result ? "Job created successfully!" : "Failed to create job.";
                if (result)
                {
                    await OnCreated.InvokeAsync();
                    ResetForm();
                }
            }
            catch (ApiException ex)
            {
                success = false;
                message = ex.Message;
            }
            finally
            {
                isSaving = false;
            }
        }
    }

    private static bool IsStaleVersion(ApiException exception)
        => string.Equals(exception.ErrorCode, "stale_version", StringComparison.Ordinal)
           || exception.Message.Contains("stale_version", StringComparison.OrdinalIgnoreCase);

    private void ResetForm()
    {
        title = "";
        department = "";
        organisation = "";
        selectedOrganizationId = "";
        selectedDepartmentId = "";
        jobDescription = "";
        postingDate = DateTime.Today;
        scoringRunCount = 3;
        aggregationStrategy = "median";
        longlistThreshold = 70;
        shortlistThreshold = 85;
        varianceThreshold = 15;
        rubricCategories = new();
        mustHaveCriteria = new();
        desiredCriteria = new();
        rubricEnvelope = null;
        extractionId = null;
        extractionInstructionVersionId = null;
        extractionCompletedAt = null;
        extractionValidationFindings = new();
        isLegacyRubric = false;
        expectedConfigVersionId = null;
        _populated = false;
        message = null;
        success = false;
        activeTab = Tab.Upload;
        validationErrors = new();
        isSaving = false;
        approveRubricOnSave = false;
        _sizedToViewport = false;
        sectionOrder.Clear();
        sectionOrder.AddRange([EditorSection.JobDetails, EditorSection.Rubric, EditorSection.Scoring]);
        expandedSections.Clear();
        expandedSections.UnionWith([EditorSection.JobDetails, EditorSection.Rubric, EditorSection.Scoring]);
    }

    private string SectionStyle(EditorSection section)
        => $"order: {sectionOrder.IndexOf(section)};";

    private bool IsFirstSection(EditorSection section)
        => sectionOrder.IndexOf(section) == 0;

    private bool IsLastSection(EditorSection section)
        => sectionOrder.IndexOf(section) == sectionOrder.Count - 1;

    private void ToggleSection(EditorSection section)
    {
        if (!expandedSections.Add(section))
            expandedSections.Remove(section);
    }

    private string SectionToggleLabel(EditorSection section, string sectionName)
        => $"{(expandedSections.Contains(section) ? "Collapse" : "Expand")} {sectionName}";

    private void MoveSection(EditorSection section, int offset)
    {
        var currentIndex = sectionOrder.IndexOf(section);
        var targetIndex = currentIndex + offset;
        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= sectionOrder.Count)
            return;

        sectionOrder.RemoveAt(currentIndex);
        sectionOrder.Insert(targetIndex, section);
    }

