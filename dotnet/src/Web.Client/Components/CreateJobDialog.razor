    private bool Validate()
    {
        validationErrors = new();

        if (!IsEditMode && string.IsNullOrWhiteSpace(title))
            validationErrors["title"] = "Title is required";

        if (!IsEditMode && string.IsNullOrWhiteSpace(department))
            validationErrors["department"] = "Department is required";

        if (!IsEditMode && string.IsNullOrWhiteSpace(organisation))
            validationErrors["organisation"] = "Organisation is required";

        if (UseScopeSelectors && string.IsNullOrWhiteSpace(selectedOrganizationId))
            validationErrors["organisation"] = "Organisation is required";

        if (UseScopeSelectors && string.IsNullOrWhiteSpace(selectedDepartmentId))
            validationErrors["department"] = "Department is required";

        if (rubricEnvelope is not null)
        {
            if (!rubricEnvelope.Categories.Any())
                validationErrors["rubric"] = "At least one rubric category is required";

            var envelopeWeightSum = rubricEnvelope.Categories.Sum(c => c.Weight);
            if (Math.Abs(envelopeWeightSum - 1.0) > 0.01)
                validationErrors["rubricWeights"] = $"Rubric weights must sum to 1.0 (currently {envelopeWeightSum:F2})";
        }
        else if (!rubricCategories.Any(c => !string.IsNullOrWhiteSpace(c.Name) && c.Weight > 0))
        {
            validationErrors["rubric"] = "At least one rubric category with a name and weight is required";
        }

        if (rubricEnvelope is null && rubricCategories.Any())
        {
            var weightSum = rubricCategories.Sum(c => c.Weight);
            if (Math.Abs(weightSum - 1.0) > 0.01)
                validationErrors["rubricWeights"] = $"Rubric weights must sum to 1.0 (currently {weightSum:F2})";
        }

        return validationErrors.Count == 0;
    }

