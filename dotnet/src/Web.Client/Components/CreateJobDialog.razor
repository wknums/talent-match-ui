@using TalentMatch.Web.Client.Services
@inject ApiClient Api

<div style="border: 1px solid #ccc; padding: 1.5rem; border-radius: 8px; max-width: 600px;">
    <h4>Create New Job</h4>
    <div style="display: grid; gap: 0.5rem;">
        <input placeholder="Job Title" @bind="title" />
        <input placeholder="Department" @bind="department" />
        <input placeholder="Organisation" @bind="organisation" />
        <input type="date" @bind="postingDate" />
        <input type="number" placeholder="Scoring Runs (default 3)" @bind="scoringRunCount" />
        <select @bind="aggregationStrategy">
            <option value="median">Median</option><option value="mean">Mean</option><option value="weighted">Weighted</option>
        </select>
        <input type="number" placeholder="Longlist Threshold" @bind="longlistThreshold" step="0.1" />
        <input type="number" placeholder="Shortlist Threshold" @bind="shortlistThreshold" step="0.1" />
        <input type="number" placeholder="Variance Threshold" @bind="varianceThreshold" step="0.1" />
        <div>
            <button @onclick="Submit">Create Job</button>
            <button @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(message))
    {
        <p style="color: @(success ? "green" : "red");">@message</p>
    }
</div>

@code {
    [Parameter] public EventCallback OnCreated { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string title = "", department = "", organisation = "";
    private DateTime postingDate = DateTime.Today;
    private int scoringRunCount = 3;
    private string aggregationStrategy = "median";
    private double longlistThreshold = 70, shortlistThreshold = 85, varianceThreshold = 15;
    private string? message;
    private bool success;

    private async Task Submit()
    {
        var result = await Api.CreateJobAsync(new CreateJobDto(title, department, organisation, postingDate,
            null, null, scoringRunCount, aggregationStrategy, longlistThreshold, shortlistThreshold, varianceThreshold));
        success = result;
        message = result ? "Job created successfully!" : "Failed to create job.";
        if (result) await OnCreated.InvokeAsync();
    }
}
