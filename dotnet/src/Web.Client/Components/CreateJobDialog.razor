    private async Task PreviewLegacyConversion()
    {
        if (EditingJob?.Id is null)
            return;

        isSaving = true;
        message = null;
        try
        {
            rubricEnvelope = await Api.PreviewLegacyRubricConversionAsync(
                EditingJob.Id,
                EditingConfig?.Id ?? EditingJob.CurrentConfigVersionId ?? string.Empty);
            if (rubricEnvelope is not null)
                SyncLegacyFieldsFromEnvelope(rubricEnvelope);
        }
        catch (ApiException ex)
        {
            success = false;
            message = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ConfirmLegacyConversion()
    {
        if (EditingJob?.Id is null || rubricEnvelope is null)
            return;

        isSaving = true;
        message = null;
        try
        {
            await Api.ConfirmLegacyRubricConversionAsync(
                EditingJob.Id,
                EditingConfig?.Id ?? EditingJob.CurrentConfigVersionId ?? string.Empty,
                rubricEnvelope);
            success = true;
            message = "Legacy rubric converted successfully.";
            await OnUpdated.InvokeAsync();
            ResetForm();
        }
        catch (ApiException ex)
        {
            success = false;
            message = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CancelLegacyPreview()
    {
        rubricEnvelope = null;
        if (EditingConfig is not null)
        {
            try
            {
                var rubricItems = JsonSerializer.Deserialize<List<RubricCategoryInput>>(EditingConfig.RubricJson ?? "[]", new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                rubricCategories = rubricItems ?? new();
            }
            catch
            {
                rubricCategories = new();
            }
        }
    }

    private void ApplyItemizedRubric(RubricEnvelopeDto envelope)
    {
        rubricEnvelope = envelope;
        isLegacyRubric = false;
        SyncLegacyFieldsFromEnvelope(envelope);
    }

    private void SyncLegacyFieldsFromEnvelope(RubricEnvelopeDto envelope)
    {
        rubricCategories = envelope.Categories
            .OrderBy(category => category.Order)
            .Select(category => new RubricCategoryInput(category.Name, category.Weight, category.Description ?? string.Empty))
            .ToList();

        mustHaveCriteria = envelope.Items
            .Where(item => item.RequirementType is "must_have" or "experience")
            .OrderBy(item => item.Order)
            .Select(item => item.Text)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        desiredCriteria = envelope.Items
            .Where(item => item.RequirementType == "desired")
            .OrderBy(item => item.Order)
            .Select(item => new DesiredCriterionInput(item.Text, item.SourceText ?? string.Empty))
            .ToList();
    }

    private static bool TryParseRubricEnvelope(string rubricJson, out RubricEnvelopeDto? envelope)
    {
        try
        {
            envelope = JsonSerializer.Deserialize<RubricEnvelopeDto>(rubricJson, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
            });
            return string.Equals(envelope?.SchemaVersion, "rubric-v2", StringComparison.Ordinal);
        }
        catch
        {
            envelope = null;
            return false;
        }
    }

    private static string? BuildMustHaveProjectionJson(RubricEnvelopeDto envelope)
    {
        var items = envelope.Items
            .Where(item => item.RequirementType is "must_have" or "experience")
            .Select(item => new { Criterion = item.Text, Description = item.SourceText ?? item.Text })
            .ToList();
        return items.Count == 0 ? null : JsonSerializer.Serialize(items);
    }

    private static string? BuildDesiredProjectionJson(RubricEnvelopeDto envelope)
    {
        var items = envelope.Items
            .Where(item => item.RequirementType == "desired")
            .Select(item => new { Qualification = item.Text, Description = item.SourceText ?? item.Text })
            .ToList();
        return items.Count == 0 ? null : JsonSerializer.Serialize(items);
    }

    private record RubricCategoryInput(string Name, double Weight, string Description);
    private record DesiredCriterionInput(string Qualification, string Description);

    private void OnMouseMove(MouseEventArgs e)
    {
        if (isDragging)
        {
            posX = dragOrigX + (int)(e.ClientX - dragStartX);
            posY = dragOrigY + (int)(e.ClientY - dragStartY);
            if (posX < 0) posX = 0;
            if (posY < 0) posY = 0;
        }
        else if (isResizing)
        {
            var newW = resizeOrigW + (int)(e.ClientX - dragStartX);
            var newH = resizeOrigH + (int)(e.ClientY - dragStartY);
            width = Math.Max(MinWidth, newW);
            height = Math.Max(MinHeight, newH);
        }
    }

    private void OnMouseUp(MouseEventArgs e)
    {
        isDragging = false;
        isResizing = false;
    }
