@using TalentMatch.Web.Client.Services
@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Navigation

<div>
    <h5>Prompt Test Workflow</h5>

    @if (CurrentPrompt == null)
    {
        <p style="color: #888;">Create a prompt revision to enable testing.</p>
    }
    else
    {
        <div style="margin-bottom: 1rem;">
            <label style="display:block; margin-bottom:0.75rem;">
                <span style="display:block; font-weight:600; margin-bottom:0.25rem;">Prompt revision for new tests</span>
                <select value="@CurrentPrompt.Id"
                        @onchange="SelectPrompt"
                        aria-label="Prompt revision for test results"
                        style="min-width:22rem; max-width:100%;">
                    @foreach (var prompt in AvailablePrompts)
                    {
                        <option value="@prompt.Id">@($"v{prompt.VersionNumber} · {prompt.Status} · {prompt.ModelId} / {prompt.ReasoningLevel}")</option>
                    }
                </select>
            </label>
            <p>New tests will use prompt: v@(CurrentPrompt.VersionNumber) (@CurrentPrompt.Status)</p>
            <p style="font-size:0.85rem;">
                Current backend profile: <strong>@profileStatus?.CurrentModelId / @profileStatus?.CurrentReasoningLevel</strong>
            </p>
            @if (profileStatus is { IsMatch: false } && CurrentPrompt.Status == "production-approved")
            {
                <div role="alert" style="padding:0.85rem; margin-bottom:0.75rem; background:#fee2e2; border:2px solid #dc2626; border-radius:6px; color:#7f1d1d;">
                    <strong>Profile mismatch. Production scoring is blocked.</strong>
                    <div>@profileStatus.MismatchMessage</div>
                    @if (testRuns.FirstOrDefault(run =>
                        run.PromptId == CurrentPrompt.Id && run.Status == "approved") is { } approvedRun)
                    {
                        <button @onclick="() => RetestPrompt(approvedRun.Id)" style="margin-top:0.5rem;">Retest with current profile</button>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(workflowMessage))
            {
                <div style="margin-bottom: 0.75rem; padding: 0.75rem; background: #ebf8ff; color: #2a4365; border: 1px solid #90cdf4; border-radius: 4px; white-space: pre-wrap; word-break: break-word;">
                    @workflowMessage
                </div>
            }

            @if (!showUpload)
            {
                <button @onclick="() => showUpload = true" style="padding: 0.5rem 1rem; background: #2b6cb0; color: white; border: none; border-radius: 4px;">
                    📤 Upload Test Applications
                </button>
                <button @onclick="ReconcileRuns" disabled="@isReconciling" style="margin-left: 0.5rem; padding: 0.5rem 1rem; background: #2f855a; color: white; border: none; border-radius: 4px;">
                    @(isReconciling ? "Reconciling..." : "🩹 Reconcile Stuck Runs")
                </button>
            }
            else
            {
                <div style="border: 2px dashed #ccc; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
                    <InputFile OnChange="OnFilesSelected" multiple />
                    @if (!string.IsNullOrWhiteSpace(uploadError))
                    {
                        <div style="margin-top: 0.75rem; padding: 0.75rem; background: #fed7d7; color: #822727; border: 1px solid #feb2b2; border-radius: 4px; white-space: pre-wrap; word-break: break-word;">
                            @uploadError
                        </div>
                    }
                    <button @onclick="SubmitTestFiles" disabled="@isUploading" style="margin-top: 0.5rem; padding: 0.5rem 1rem;">
                        @(isUploading ? "Uploading..." : "Start Test Run")
                    </button>
                    <button @onclick="() => showUpload = false" style="margin-left: 0.5rem; padding: 0.5rem 1rem;">Cancel</button>
                </div>
            }
        </div>

        <!-- Test runs list -->
        @if (testRuns.Any())
        {
            <h6>Test Runs — All Prompt Revisions</h6>
            @foreach (var prompt in AvailablePrompts)
            {
                var promptRuns = testRuns
                    .Where(run => run.PromptId == prompt.Id)
                    .OrderByDescending(run => run.CreatedAt)
                    .ToList();
                @if (promptRuns.Count > 0)
                {
                    <details class="prompt-test-history-group"
                             open
                             style="margin-bottom:1rem; border:1px solid #cbd5e1; border-radius:6px; padding:0.6rem 0.75rem;">
                        <summary style="font-weight:600; cursor:pointer; margin-bottom:0.4rem;">
                            @($"Prompt v{prompt.VersionNumber} · {prompt.Status} · {prompt.ModelId} / {prompt.ReasoningLevel}")
                            <span style="font-weight:400; color:#64748b;"> · @promptRuns.Count test run(s)</span>
                        </summary>
                        @foreach (var run in promptRuns)
                        {
                            <div style="border: 1px solid #eee; padding: 0.75rem; margin-bottom: 0.5rem; border-radius: 4px;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span>Test Run: @run.Id[..Math.Min(8, run.Id.Length)]... | Apps: @GetAppCount(run.ApplicationIdsJson)</span>
                                    <span style="@TestRunStatusStyle(run.Status)">@run.Status</span>
                                </div>
                                <div style="font-size:0.8rem; color:#4a5568;">Profile: @run.ModelId / @run.ReasoningLevel</div>
                                <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                    @if (run.Status is "pending_review" or "approved" or "rejected" or "scoring_failed")
                                    {
                                        <button @onclick="() => ViewResults(run)" style="padding: 0.4rem 0.8rem; background: #4a5568; color: white; border: none; border-radius: 4px; cursor: pointer;">
                                            🔍 View Results
                                        </button>
                                    }
                                    @if (run.Status == "pending_review")
                                    {
                                        <button @onclick="() => ApproveTestRun(run.PromptId, run.Id)" style="padding: 0.4rem 0.8rem; background: #276749; color: white; border: none; border-radius: 4px; cursor: pointer;">
                                            ✅ Approve Test Run
                                        </button>
                                    }
                                    @if (run.Status is "scoring_failed" or "pending_scoring" or "scoring" or "pending_review")
                                    {
                                        <button @onclick="() => RetryTestRun(run.PromptId, run.Id)" style="padding: 0.4rem 0.8rem; background: #dd6b20; color: white; border: none; border-radius: 4px; cursor: pointer;">
                                            🔄 @(run.Status == "scoring_failed" ? "Retry Failed Scoring" : "Re-trigger Scoring")
                                        </button>
                                    }
                                    @if (run.Status == "approved"
                                        && (prompt.Status != "production-approved"
                                            || prompt.ApprovedTestRunId != run.Id))
                                    {
                                        <button @onclick="() => ApproveForProduction(prompt.Id)" style="padding: 0.4rem 0.8rem; background: #805ad5; color: white; border: none; border-radius: 4px; cursor: pointer;">
                                            🚀 Approve for Production
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </details>
                }
            }
        }
        else
        {
            <p style="color:#718096;">No test runs have been created for any prompt revision.</p>
        }

        <!-- Results detail panel -->
        @if (selectedDetail != null)
        {
            <div style="border: 2px solid #2b6cb0; border-radius: 8px; padding: 1rem; margin-top: 1rem; background: #f7fafc;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <h6 style="margin: 0;">📊 Test Run Results</h6>
                    <button @onclick="CloseDetail" style="padding: 0.25rem 0.5rem; border: 1px solid #ccc; border-radius: 4px; cursor: pointer;">✕ Close</button>
                </div>

                <div style="margin-bottom: 0.75rem;">
                    <span><strong>Status:</strong> </span>
                    <span style="@TestRunStatusStyle(selectedDetail.TestRun.Status)">@selectedDetail.TestRun.Status</span>
                    <span style="margin-left: 1rem;"><strong>Created:</strong> @selectedDetail.TestRun.CreatedAt.ToString("g")</span>
                </div>

                @if (selectedDetail.Applications.Any())
                {
                    @foreach (var appDetail in selectedDetail.Applications)
                    {
                        <div style="border: 1px solid #e2e8f0; border-radius: 6px; padding: 0.75rem; margin-bottom: 0.75rem; background: white;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                <div>
                                    <strong>@GetApplicantLabel(appDetail.Application)</strong>
                                    @if (!string.IsNullOrWhiteSpace(appDetail.Application.CandidateEmail))
                                    {
                                        <div style="font-size: 0.8rem; color: #718096;">@appDetail.Application.CandidateEmail</div>
                                    }
                                </div>
                                <div style="display: flex; gap: 0.5rem; align-items: center;">
                                    <button @onclick="() => NavigateToApp(appDetail.Application.Id)" style="padding: 0.2rem 0.5rem; background: #4a5568; color: white; border: none; border-radius: 3px; cursor: pointer; font-size: 0.8rem;">
                                        📋 Detail
                                    </button>
                                    @if (appDetail.Application.FinalDecision is "NeedsManualReview" or "Eligible")
                                    {
                                        <button @onclick="() => NavigateToManualReview(appDetail.Application.Id)" style="padding: 0.2rem 0.5rem; background: #805ad5; color: white; border: none; border-radius: 3px; cursor: pointer; font-size: 0.8rem;">
                                            ✍️ Manual Review
                                        </button>
                                    }
                                    <span style="@AppStatusStyle(appDetail.Application.Status)">@appDetail.Application.Status</span>
                                </div>
                            </div>

                            @if (appDetail.Application.Status == "ScoringFailed" && !string.IsNullOrEmpty(appDetail.Application.LastError))
                            {
                                <div style="margin-bottom: 0.5rem; padding: 0.5rem; background: #fed7d7; border: 1px solid #feb2b2; border-radius: 4px; font-size: 0.85rem;">
                                    <div style="font-weight: 600; color: #822727; margin-bottom: 0.25rem;">❌ Scoring Error</div>
                                    <div style="color: #822727; white-space: pre-wrap; word-break: break-word;">@appDetail.Application.LastError</div>
                                </div>
                            }

                            @if (appDetail.Application.FinalScore.HasValue)
                            {
                                <div style="margin-bottom: 0.5rem;">
                                    <strong>Final Score:</strong> @appDetail.Application.FinalScore.Value.ToString("F3")
                                    @if (appDetail.Application.FinalDecision != null)
                                    {
                                        <span> | <strong>Decision:</strong> @appDetail.Application.FinalDecision</span>
                                    }
                                </div>
                            }

                            @if (appDetail.ScoringRuns.Any())
                            {
                                <div style="margin-top: 0.5rem; border-top: 1px solid #e2e8f0; padding-top: 0.5rem;">
                                    <div style="font-size: 0.8rem; color: #718096; margin-bottom: 0.5rem;">
                                        @appDetail.ScoringRuns.Count scoring run(s) — avg score: @appDetail.ScoringRuns.Average(r => r.TotalScore).ToString("F3")
                                    </div>
                                    @foreach (var run in appDetail.ScoringRuns.OrderBy(r => r.RunIndex))
                                    {
                                        <div style="border: 1px solid #e2e8f0; border-radius: 4px; padding: 0.5rem; margin-bottom: 0.5rem; background: @(HasError(run.MustHaveEvaluationJson) ? "#fff5f5" : "#f7fafc"); font-size: 0.85rem;">
                                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
                                                <span><strong>Run #@(run.RunIndex)</strong></span>
                                                <span style="display: flex; align-items: center; gap: 0.5rem;">
                                                    <strong>Score: @run.TotalScore.ToString("F3")</strong>@(HasError(run.MustHaveEvaluationJson) ? " ⚠️" : "")
                                                    <button @onclick="() => ReparseRun(appDetail.Application.Id, run.Id)"
                                                            disabled="@reparsingRunIds.Contains(run.Id)"
                                                            style="padding: 0.15rem 0.4rem; background: #2b6cb0; color: white; border: none; border-radius: 3px; cursor: pointer; font-size: 0.75rem;">
                                                        @(reparsingRunIds.Contains(run.Id) ? "Re-parsing..." : "♻ Re-parse")
                                                    </button>
                                                </span>
                                            </div>

                                            @if (HasError(run.MustHaveEvaluationJson))
                                            {
                                                <div style="margin: 0.25rem 0; padding: 0.5rem; background: #fed7d7; border-radius: 4px; border: 1px solid #feb2b2;">
                                                    <div style="font-weight: 600; color: #822727; font-size: 0.8rem; margin-bottom: 0.25rem;">⚠️ Scoring Error</div>
                                                    <div style="color: #822727; font-size: 0.8rem;">@GetErrorMessage(run.MustHaveEvaluationJson)</div>
                                                    @{ var rawResp = GetRawResponse(run.MustHaveEvaluationJson); }
                                                    @if (!string.IsNullOrEmpty(rawResp))
                                                    {
                                                        <details style="margin-top: 0.25rem;">
                                                            <summary style="cursor: pointer; font-size: 0.75rem; color: #822727;">Show raw LLM response</summary>
                                                            <pre style="margin-top: 0.25rem; padding: 0.5rem; background: #1a202c; color: #e2e8f0; border-radius: 4px; font-size: 0.75rem; white-space: pre-wrap; max-height: 300px; overflow-y: auto;">@rawResp</pre>
                                                        </details>
                                                    }
                                                </div>
                                            }

                                            @{
                                                var subScores = ParseJson<Dictionary<string, double>>(run.CategoryScoresJson);
                                                var evidence = ParseJson<List<EvidenceItem>>(run.EvidenceCitationsJson) ?? new List<EvidenceItem>();
                                                var tips = ParseJson<List<string>>(run.ImprovementTipsJson) ?? new List<string>();
                                                var mustHave = ParseJson<MustHaveDto>(run.MustHaveEvaluationJson);
                                                var mustHaveEntries = ParseMustHaveEntries(run.MustHaveEvaluationJson);
                                                var categoryBreakdown = BuildCategoryBreakdown(subScores, evidence, _jobConfig, tips, mustHaveEntries);
                                            }
                                            @if (categoryBreakdown.Any())
                                            {
                                                <div style="margin: 0.35rem 0; padding: 0.4rem 0.55rem; background: #edf2f7; border-radius: 4px; border: 1px solid #cbd5e0;">
                                                    <div style="font-weight: 600; font-size: 0.8rem; color: #2d3748; margin-bottom: 0.35rem;">Category Score Breakdown (scored JSON)</div>
                                                    @foreach (var category in categoryBreakdown)
                                                    {
                                                        <div style="margin-bottom: 0.4rem; padding: 0.4rem 0.5rem; border: 1px solid #d2d6dc; border-radius: 4px; background: white;">
                                                            <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem;">
                                                                <span style="font-weight: 600; color: #2d3748;">@category.Name</span>
                                                                <div style="text-align: right;">
                                                                    <div style="font-weight: 700; color: #1a202c;">Score: @FormatPercent(category.ScorePercent)</div>
                                                                    <div style="font-size: 0.75rem; color: #4a5568;">Weight: @FormatPercent(category.WeightPercent)</div>
                                                                </div>
                                                            </div>

                                                            @if (!category.ScorePercent.HasValue)
                                                            {
                                                                <div style="margin-top: 0.2rem; color: #975a16; font-size: 0.75rem;">
                                                                    Score % unavailable in this run's scoring JSON (raw value appears to be rubric weighting: @FormatCategoryScore(category.RawValue)).
                                                                </div>
                                                            }
                                                            else if (category.WeightedContributionPoints.HasValue)
                                                            {
                                                                <div style="margin-top: 0.2rem; color: #4a5568; font-size: 0.75rem;">
                                                                    Weighted contribution: @FormatCategoryScore(category.WeightedContributionPoints.Value) points.
                                                                </div>
                                                            }

                                                            @if (!string.IsNullOrWhiteSpace(category.Description))
                                                            {
                                                                <div style="margin-top: 0.1rem; color: #718096; font-size: 0.75rem;">@category.Description</div>
                                                            }

                                                            @if (category.Requirements.Any())
                                                            {
                                                                <ul style="margin: 0.3rem 0 0 1.25rem; padding: 0;">
                                                                    @foreach (var req in category.Requirements)
                                                                    {
                                                                        <li style="color: @(req.Found ? "#2f855a" : "#c53030"); margin-bottom: 0.2rem;">
                                                                            @(req.Found ? "✅" : "❌") <span style="color: #2d3748;">@req.Requirement</span>
                                                                            <div style="color: @(req.Found ? "#4a5568" : "#c53030"); font-size: 0.75rem; margin-top: 0.08rem; font-style: italic;">
                                                                                @(req.Found ? req.Evidence : "None found")
                                                                            </div>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            }
                                                            else if (category.EvidenceSnippets.Any())
                                                            {
                                                                <ul style="margin: 0.3rem 0 0 1.25rem; padding: 0;">
                                                                    @foreach (var snippet in category.EvidenceSnippets)
                                                                    {
                                                                        var supportsRequirement = HasUsableEvidence(snippet);
                                                                        <li style="color: @(supportsRequirement ? "#2f855a" : "#c53030"); margin-bottom: 0.15rem;">
                                                                            @(supportsRequirement ? "✅" : "❌") <span style="color: #2d3748;">@snippet</span>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            }
                                                            else
                                                            {
                                                                <div style="margin-top: 0.3rem; color: #c53030; font-size: 0.75rem;">
                                                                    ❌ No evidence citations captured for this category.
                                                                </div>
                                                            }

                                                            @if (category.RelevantTips.Any())
                                                            {
                                                                <div style="margin-top: 0.25rem; color: #4a5568; font-size: 0.75rem;">
                                                                    <strong>Improvement focus:</strong>
                                                                    <ul style="margin: 0.15rem 0 0 1.25rem; padding: 0;">
                                                                        @foreach (var tip in category.RelevantTips)
                                                                        {
                                                                            <li>@tip</li>
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            }
                                                        </div>
                                                        }
                                                </div>
                                            }

                                            @{
                                                var desiredChecklist = BuildDesiredChecklist(_jobConfig?.DesiredCriteriaJson, run.EvidenceCitationsJson);
                                                var desiredCategoryScore = GetDesiredCategoryScore(subScores);
                                                bool? inferredEligibilityPassed = mustHave?.Passed;
                                                if (!inferredEligibilityPassed.HasValue && mustHaveEntries.Any())
                                                {
                                                    inferredEligibilityPassed = mustHaveEntries.All(e => e.Passed);
                                                }
                                            }
                                            @if (mustHave != null || mustHaveEntries.Any())
                                            {
                                                <div style="margin-top: 0.25rem;">
                                                    <span style="font-weight: 600; font-size: 0.8rem; color: #4a5568;">Eligibility: </span>
                                                    @if (inferredEligibilityPassed == true)
                                                    {
                                                        <span style="color: #276749;">✅ Passed</span>
                                                    }
                                                    else if (inferredEligibilityPassed == false)
                                                    {
                                                        <span style="color: #c53030;">❌ Failed</span>
                                                    }
                                                    else
                                                    {
                                                        <span style="color: #718096;">⚪ Unknown</span>
                                                    }

                                                    @if (mustHaveEntries.Any())
                                                    {
                                                        <ul style="margin: 0.15rem 0 0 1.25rem; padding: 0;">
                                                            @foreach (var entry in mustHaveEntries)
                                                            {
                                                                <li style="color: @(entry.Passed ? "#276749" : "#c53030");">
                                                                    @(entry.Passed ? "✅" : "❌") @entry.Criterion
                                                                    @if (!string.IsNullOrWhiteSpace(entry.Evidence))
                                                                    {
                                                                        <div style="color: #718096; font-size: 0.75rem; font-style: italic; margin-top: 0.1rem;">@entry.Evidence</div>
                                                                    }
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                    else if (mustHave?.MissingCriteria?.Any() == true)
                                                    {
                                                        <ul style="margin: 0.15rem 0 0 1.25rem; padding: 0; color: #c53030;">
                                                            @foreach (var m in mustHave.MissingCriteria)
                                                            {
                                                                <li>❌ @m</li>
                                                            }
                                                        </ul>
                                                    }
                                                </div>
                                            }
                                            else if (HasError(run.MustHaveEvaluationJson))
                                            {
                                                <div style="margin-top: 0.25rem; color: #c53030; font-size: 0.8rem;">
                                                    <span style="font-weight: 600;">Eligibility: </span>⚠️ @GetErrorMessage(run.MustHaveEvaluationJson)
                                                </div>
                                            }

                                            @if (desiredChecklist.Any())
                                            {
                                                <div style="margin-top: 0.35rem; padding: 0.35rem 0.5rem; background: #f0fff4; border-radius: 4px; border: 1px solid #9ae6b4;">
                                                    <div style="font-weight: 600; font-size: 0.8rem; color: #276749; margin-bottom: 0.15rem;">
                                                        Desired Qualifications
                                                        @if (desiredCategoryScore.HasValue)
                                                        {
                                                            <span style="margin-left: 0.5rem; color: #2f855a;">Score: @desiredCategoryScore.Value.ToString("F3")</span>
                                                        }
                                                    </div>
                                                    <ul style="margin: 0.15rem 0 0 1.25rem; padding: 0;">
                                                        @foreach (var item in desiredChecklist)
                                                        {
                                                            <li style="color: @(item.Passed ? "#276749" : "#c53030"); margin-bottom: 0.2rem;">
                                                                @(item.Passed ? "✅" : "❌") @item.Criterion
                                                                @if (!string.IsNullOrWhiteSpace(item.Evidence))
                                                                {
                                                                    <div style="color: #718096; font-size: 0.75rem; font-style: italic; margin-top: 0.1rem;">@item.Evidence</div>
                                                                }
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            }

                                            @if (evidence.Any())
                                            {
                                                <details style="margin-top: 0.25rem;">
                                                    <summary style="cursor: pointer; font-weight: 600; font-size: 0.8rem; color: #4a5568;">Evidence Citations (@evidence.Count)</summary>
                                                    <div style="margin-top: 0.15rem; padding: 0.25rem 0.5rem; background: #fffff0; border-radius: 4px; font-size: 0.8rem;">
                                                        @foreach (var ev in evidence)
                                                        {
                                                            <div style="margin-bottom: 0.25rem;">
                                                                <span style="font-weight: 600; color: #4a5568;">@(ev.Category ?? "—"):</span>
                                                                <span style="color: #718096;"> @(ev.Snippet ?? "")</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </details>
                                            }

                                            @{ 
                                                var gateFailedCriteria = GetFailedCriteria(run.MustHaveEvaluationJson);
                                                var gateFailed = mustHave?.Passed == false;
                                            }
                                            @if (tips.Any())
                                            {
                                                <details style="margin-top: 0.25rem;">
                                                    <summary style="cursor: pointer; font-weight: 600; font-size: 0.8rem; color: #4a5568;">Improvement Tips (@tips.Count)</summary>
                                                    <ul style="margin: 0.15rem 0 0 1.25rem; padding: 0;">
                                                        @foreach (var tip in tips)
                                                        {
                                                            var isGateFailureTip = gateFailed && IsTipGateFailureRelated(tip, gateFailedCriteria);
                                                            <li style="color: @(isGateFailureTip ? "#c53030" : "#4a5568");">@tip</li>
                                                        }
                                                    </ul>
                                                </details>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p style="color: #a0aec0; font-size: 0.85rem;">No scoring runs yet</p>
                            }
                        </div>
                    }
                }
                else
                {
                    <p style="color: #a0aec0;">No application data available.</p>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string JobId { get; set; } = "";
    [Parameter] public ScoringPromptDto? ActivePrompt { get; set; }
    [Parameter] public IReadOnlyList<ScoringPromptDto> Prompts { get; set; } = [];
    [Parameter] public EventCallback OnPromptStatusChange { get; set; }

    private List<PromptTestRunDto> testRuns = new();
    private PromptTestRunDetailDto? selectedDetail;
    private bool showUpload;
    private bool isUploading;
    private bool isReconciling;
    private readonly HashSet<string> reparsingRunIds = new(StringComparer.Ordinal);
    private JobConfigDto? _jobConfig;
    private List<IBrowserFile> selectedFiles = new();
    private System.Threading.Timer? _pollTimer;
    private bool _disposed;
    private string? uploadError;
    private string? workflowMessage;
    private PromptProfileStatusDto? profileStatus;
    private string? selectedPromptId;
    private ScoringPromptDto? CurrentPrompt
        => AvailablePrompts.FirstOrDefault(prompt => prompt.Id == selectedPromptId)
           ?? ActivePrompt;
    private IReadOnlyList<ScoringPromptDto> AvailablePrompts
        => Prompts.Count > 0
            ? Prompts.OrderByDescending(prompt => prompt.VersionNumber).ToList()
            : ActivePrompt is null
                ? []
                : [ActivePrompt];

    protected override async Task OnParametersSetAsync()
    {
        if (CurrentPrompt is null
            || !AvailablePrompts.Any(prompt => prompt.Id == selectedPromptId))
            selectedPromptId = ActivePrompt?.Id ?? AvailablePrompts.FirstOrDefault()?.Id;

        if (CurrentPrompt != null)
        {
            _jobConfig = await Api.GetJobConfigAsync(JobId);
            await LoadSelectedPromptAsync();
        }
        else
        {
            ClearSelectedPrompt();
        }
    }

    private async Task SelectPrompt(ChangeEventArgs eventArgs)
    {
        var promptId = eventArgs.Value?.ToString();
        if (string.IsNullOrWhiteSpace(promptId)
            || !AvailablePrompts.Any(prompt => prompt.Id == promptId))
            return;

        selectedPromptId = promptId;
        selectedDetail = null;
        _selectedDetailRunId = null;
        _selectedDetailPromptId = null;
        workflowMessage = null;
        uploadError = null;
        showUpload = false;
        StopPolling();
        await LoadSelectedPromptAsync();
    }

    private async Task LoadSelectedPromptAsync()
    {
        var prompt = CurrentPrompt;
        if (prompt is null)
        {
            ClearSelectedPrompt();
            return;
        }

        testRuns = await FetchAllTestRunsAsync();
        await LoadProfileStatus();
        Console.WriteLine($"[PromptTestRunner] Loaded {testRuns.Count} test runs for prompt {prompt.Id}");
        foreach (var run in testRuns)
        {
            Console.WriteLine($"[PromptTestRunner] Run {run.Id} status='{run.Status}' apps={run.ApplicationIdsJson}");
        }
        StartOrStopPolling();
    }

    private async Task<List<PromptTestRunDto>> FetchAllTestRunsAsync()
    {
        var results = await Task.WhenAll(AvailablePrompts.Select(prompt =>
            Api.GetTestRunsAsync(JobId, prompt.Id)));
        return results
            .SelectMany(runs => runs)
            .OrderByDescending(run => run.CreatedAt)
            .ToList();
    }

    private void ClearSelectedPrompt()
    {
        _jobConfig = null;
        testRuns = new();
        selectedDetail = null;
        _selectedDetailRunId = null;
        _selectedDetailPromptId = null;
        profileStatus = null;
        StopPolling();
    }

    private async Task LoadProfileStatus()
    {
        if (CurrentPrompt is null)
        {
            profileStatus = null;
            return;
        }

        try
        {
            profileStatus = await Api.GetPromptProfileStatusAsync(JobId, CurrentPrompt.Id);
        }
        catch
        {
            profileStatus = null;
        }
    }

    private bool HasActiveRuns => testRuns.Any(r => r.Status is "pending_scoring" or "scoring");
    private string? _selectedDetailRunId;
    private string? _selectedDetailPromptId;

    private async Task RetryTestRun(string promptId, string testRunId)
    {
        workflowMessage = null;
        await Api.RetryTestRunAsync(JobId, promptId, testRunId);
        testRuns = await FetchAllTestRunsAsync();
        StartPolling();
    }

    private async Task RetestPrompt(string testRunId)
    {
        if (CurrentPrompt == null) return;
        workflowMessage = null;
        try
        {
            await Api.RetestPromptAsync(JobId, CurrentPrompt.Id, testRunId);
            testRuns = await FetchAllTestRunsAsync();
            await LoadProfileStatus();
            StartPolling();
        }
        catch (ApiException ex)
        {
            workflowMessage = ex.Message;
        }
    }

    private async Task ReconcileRuns()
    {
        if (CurrentPrompt == null) return;

        isReconciling = true;
        workflowMessage = null;
        StateHasChanged();

        try
        {
            var response = await Api.ReconcileTestRunsAsync(JobId, CurrentPrompt.Id);
            testRuns = await FetchAllTestRunsAsync();
            var healedCount = response?.HealedCount ?? 0;
            workflowMessage = healedCount > 0
                ? $"Reconciled {healedCount} test run(s)."
                : "No test runs required reconciliation.";
            StartOrStopPolling();
        }
        catch (ApiException ex)
        {
            workflowMessage = ex.Message;
        }
        catch (Exception ex)
        {
            workflowMessage = ex.Message;
        }
        finally
        {
            isReconciling = false;
        }
    }

    private void StartPolling()
    {
        if (_pollTimer != null) return;
        _pollTimer = new System.Threading.Timer(async _ =>
        {
            if (_disposed || CurrentPrompt == null) return;
            try
            {
                var updated = await FetchAllTestRunsAsync();
                await InvokeAsync(async () =>
                {
                    testRuns = updated;

                    // Auto-refresh the detail panel if it's open
                    if (_selectedDetailRunId != null
                        && _selectedDetailPromptId != null)
                    {
                        try
                        {
                            selectedDetail = await Api.GetTestRunDetailAsync(
                                JobId,
                                _selectedDetailPromptId,
                                _selectedDetailRunId);
                        }
                        catch { /* detail may not be ready yet */ }
                    }

                    StateHasChanged();

                    // Stop polling when no active runs remain
                    if (!HasActiveRuns)
                        StopPolling();
                });
            }
            catch { /* ignore transient errors during polling */ }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void StartOrStopPolling()
    {
        if (HasActiveRuns)
            StartPolling();
        else
            StopPolling();
    }

    private void StopPolling()
    {
        _pollTimer?.Dispose();
        _pollTimer = null;
    }

    public void Dispose()
    {
        _disposed = true;
        StopPolling();
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        selectedFiles = e.GetMultipleFiles(20).ToList();
        uploadError = null;
    }

    private async Task SubmitTestFiles()
    {
        if (CurrentPrompt == null || !selectedFiles.Any()) return;
        isUploading = true;
        uploadError = null;
        workflowMessage = null;
        StateHasChanged();
        try
        {
            var files = new List<object>();
            foreach (var file in selectedFiles)
            {
                using var stream = file.OpenReadStream(50 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                files.Add(new
                {
                    FileName = file.Name,
                    Content = Convert.ToBase64String(ms.ToArray()),
                    MimeType = file.ContentType,
                    SizeBytes = file.Size
                });
            }
            await Api.CreateTestRunAsync(JobId, CurrentPrompt.Id, files);
            showUpload = false;
            selectedFiles.Clear();
            testRuns = await FetchAllTestRunsAsync();
            StartPolling();
        }
        catch (ApiException ex)
        {
            uploadError = ex.Message;
        }
        catch (Exception ex)
        {
            uploadError = ex.Message;
        }
        finally
        {
            isUploading = false;
        }
    }

