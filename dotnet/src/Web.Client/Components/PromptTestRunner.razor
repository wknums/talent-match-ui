    private T? ParseJson<T>(string? json) where T : class
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try { return JsonSerializer.Deserialize<T>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }); }
        catch { return null; }
    }

    private List<MustHaveEntry> ParseMustHaveEntries(string? json)
    {
        var entries = new List<MustHaveEntry>();
        if (string.IsNullOrWhiteSpace(json)) return entries;

        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            var missingCriteria = ExtractMissingCriteria(root);
            var gatePassedHint = TryGetFlexibleBoolProperty(root, "passed", "met", "eligible", "satisfied");

            static bool IsObjectArray(JsonElement element)
                => element.ValueKind == JsonValueKind.Array
                   && element.GetArrayLength() > 0
                   && element[0].ValueKind == JsonValueKind.Object;

            static string? ExtractCriterion(JsonElement item)
                => item.TryGetProperty("criterion", out var criterionElement)
                    ? criterionElement.GetString()
                    : item.TryGetProperty("requirement", out var requirementElement)
                        ? requirementElement.GetString()
                        : item.TryGetProperty("item", out var itemElement)
                            ? itemElement.GetString()
                            : item.TryGetProperty("name", out var nameElement)
                                ? nameElement.GetString()
                                : null;

            static string? ExtractEvidence(JsonElement item)
                => item.TryGetProperty("evidence", out var evidenceElement)
                    ? evidenceElement.GetString()
                    : item.TryGetProperty("reason", out var reasonElement)
                        ? reasonElement.GetString()
                        : null;

            bool AppendFromArray(JsonElement entryArray)
            {
                var startCount = entries.Count;
                foreach (var item in entryArray.EnumerateArray())
                {
                    if (item.ValueKind != JsonValueKind.Object) continue;

                    var criterion = ExtractCriterion(item);
                    if (string.IsNullOrWhiteSpace(criterion)) continue;

                    var passed = false;
                    var hasPassed = false;

                    if (item.TryGetProperty("passed", out var passedElement) && TryParseFlexibleBool(passedElement, out var parsedPassed))
                    {
                        passed = parsedPassed;
                        hasPassed = true;
                    }
                    else if (item.TryGetProperty("met", out var metElement) && TryParseFlexibleBool(metElement, out var parsedMet))
                    {
                        passed = parsedMet;
                        hasPassed = true;
                    }
                    else if (item.TryGetProperty("satisfied", out var satisfiedElement) && TryParseFlexibleBool(satisfiedElement, out var parsedSatisfied))
                    {
                        passed = parsedSatisfied;
                        hasPassed = true;
                    }

                    var evidence = ExtractEvidence(item);

                    if (!hasPassed)
                    {
                        if (IsCriterionInMissingCriteria(criterion, missingCriteria))
                            passed = false;
                        else if (!string.IsNullOrWhiteSpace(evidence))
                            passed = !LooksLikeNegativeEvidence(evidence) && !EvidenceContradictsCriterion(criterion, evidence);
                        else if (gatePassedHint.HasValue)
                            passed = gatePassedHint.Value;
                        else
                            passed = false;
                    }

                    entries.Add(new MustHaveEntry
                    {
                        Criterion = criterion,
                        Passed = passed,
                        Evidence = evidence
                    });
                }

                return entries.Count > startCount;
            }

            if (root.ValueKind == JsonValueKind.Array)
            {
                if (AppendFromArray(root)) return entries;
            }

            if (root.ValueKind == JsonValueKind.Object)
            {
                if (root.TryGetProperty("entries", out var topEntries) && topEntries.ValueKind == JsonValueKind.Array)
                {
                    if (AppendFromArray(topEntries)) return entries;
                }

                if (root.TryGetProperty("details", out var details))
                {
                    if (details.ValueKind == JsonValueKind.Object
                        && details.TryGetProperty("entries", out var entryArray)
                        && entryArray.ValueKind == JsonValueKind.Array)
                    {
                        if (AppendFromArray(entryArray)) return entries;
                    }

                    if (details.ValueKind == JsonValueKind.Object)
                    {
                        foreach (var prop in details.EnumerateObject())
                        {
                            if (prop.Name is "source" or "entries" or "recommendation") continue;
                            if (!TryParseFlexibleBool(prop.Value, out var passed)) continue;

                            entries.Add(new MustHaveEntry
                            {
                                Criterion = prop.Name,
                                Passed = passed,
                                Evidence = null
                            });
                        }

                        if (entries.Any()) return entries;
                    }
                }

                // Last fallback: scan for any object-array children and parse them as entries.
                foreach (var prop in root.EnumerateObject())
                {
                    if (IsObjectArray(prop.Value) && AppendFromArray(prop.Value))
                        return entries;
                }
            }
        }
        catch
        {
            return new List<MustHaveEntry>();
        }

        return entries;
    }

    private static List<string> ExtractMissingCriteria(JsonElement root)
    {
        var missingCriteria = new List<string>();
        if (root.ValueKind != JsonValueKind.Object)
            return missingCriteria;

        if (root.TryGetProperty("missing_criteria", out var missingElement) && missingElement.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in missingElement.EnumerateArray())
            {
                if (item.ValueKind != JsonValueKind.String) continue;
                var criterion = item.GetString();
                if (!string.IsNullOrWhiteSpace(criterion))
                    missingCriteria.Add(criterion.Trim());
            }
        }

        return missingCriteria;
    }

    private static bool IsCriterionInMissingCriteria(string criterion, List<string> missingCriteria)
    {
        if (string.IsNullOrWhiteSpace(criterion) || missingCriteria.Count == 0)
            return false;

        var normalizedCriterion = NormalizeForMatch(criterion);
        foreach (var missing in missingCriteria)
        {
            var normalizedMissing = NormalizeForMatch(missing);
            if (string.IsNullOrWhiteSpace(normalizedMissing))
                continue;

            if (normalizedMissing == normalizedCriterion
                || normalizedMissing.Contains(normalizedCriterion, StringComparison.Ordinal)
                || normalizedCriterion.Contains(normalizedMissing, StringComparison.Ordinal))
            {
                return true;
            }
        }

        return false;
    }

    private static bool LooksLikeNegativeEvidence(string evidence)
    {
        var normalized = NormalizeForMatch(evidence);
        if (string.IsNullOrWhiteSpace(normalized))
            return false;

        return normalized.Contains("none found", StringComparison.Ordinal)
            || normalized.Contains("not found", StringComparison.Ordinal)
            || normalized.Contains("no evidence", StringComparison.Ordinal)
            || normalized.Contains("no proof", StringComparison.Ordinal)
            || normalized.Contains("not provided", StringComparison.Ordinal)
            || normalized.Contains("insufficient evidence", StringComparison.Ordinal)
            || normalized.Contains("unable to verify", StringComparison.Ordinal)
            || normalized.Contains("cannot verify", StringComparison.Ordinal)
            || normalized.Contains("missing evidence", StringComparison.Ordinal)
            || normalized.Contains("no supporting evidence", StringComparison.Ordinal)
            || normalized.Contains("unknown", StringComparison.Ordinal)
            || normalized.Contains("not met", StringComparison.Ordinal)
            || normalized.Contains("does not meet", StringComparison.Ordinal)
            || normalized.Contains("did not meet", StringComparison.Ordinal)
            || normalized.Contains("not registered", StringComparison.Ordinal)
            || normalized.Contains("no professional", StringComparison.Ordinal)
            || normalized.Contains("no formal", StringComparison.Ordinal)
            || normalized.Contains("no explicit", StringComparison.Ordinal)
            || normalized.Contains("no budgeting", StringComparison.Ordinal)
            || normalized.Contains("could not be verified", StringComparison.Ordinal)
            || normalized.Contains("without evidence", StringComparison.Ordinal)
            || normalized.Contains("lacks ", StringComparison.Ordinal)
            || normalized.Contains("limited exposure", StringComparison.Ordinal)
            || normalized.Contains("limited management tenure", StringComparison.Ordinal)
            || normalized.Contains("vs required", StringComparison.Ordinal)
            || normalized.Contains("only", StringComparison.Ordinal);
    }

    private static bool EvidenceContradictsCriterion(string criterion, string evidence)
    {
        var normalizedCriterion = NormalizeForMatch(criterion);
        var normalizedEvidence = NormalizeForMatch(evidence);

        if (string.IsNullOrWhiteSpace(normalizedCriterion) || string.IsNullOrWhiteSpace(normalizedEvidence))
            return false;

        if (normalizedCriterion.Contains("registered", StringComparison.Ordinal)
            && (normalizedEvidence.Contains("not registered", StringComparison.Ordinal)
                || normalizedEvidence.Contains("unregistered", StringComparison.Ordinal)
                || normalizedEvidence.Contains("registration missing", StringComparison.Ordinal)))
        {
            return true;
        }

        if (TryExtractRequiredYears(normalizedCriterion, out var requiredYears)
            && TryExtractYearsMentioned(normalizedEvidence, out var evidencedYears)
            && evidencedYears < requiredYears)
        {
            return true;
        }

        return false;
    }

    private static bool TryExtractRequiredYears(string normalizedCriterion, out double years)
    {
        years = 0;
        if (!normalizedCriterion.Contains("year", StringComparison.Ordinal))
            return false;

        var minOrAtLeastMatch = Regex.Match(normalizedCriterion, @"(?:minimum|at least)\s+(\d+(?:\.\d+)?)\s+year");
        if (minOrAtLeastMatch.Success && double.TryParse(minOrAtLeastMatch.Groups[1].Value, out years))
            return true;

        var genericMatch = Regex.Match(normalizedCriterion, @"(\d+(?:\.\d+)?)\s+year");
        if (genericMatch.Success && double.TryParse(genericMatch.Groups[1].Value, out years))
            return true;

        return false;
    }

    private static bool TryExtractYearsMentioned(string normalizedEvidence, out double years)
    {
        years = 0;
        if (!normalizedEvidence.Contains("year", StringComparison.Ordinal))
            return false;

        var matches = Regex.Matches(normalizedEvidence, @"(\d+(?:\.\d+)?)\s+year");
        if (matches.Count == 0)
            return false;

        var max = 0d;
        var found = false;
        foreach (Match match in matches)
        {
            if (!double.TryParse(match.Groups[1].Value, out var value))
                continue;
            if (!found || value > max)
            {
                max = value;
                found = true;
            }
        }

        if (!found)
            return false;

        years = max;
        return true;
    }

    private static bool? TryGetFlexibleBoolProperty(JsonElement root, params string[] names)
    {
        if (root.ValueKind != JsonValueKind.Object)
            return null;

        foreach (var name in names)
        {
            if (root.TryGetProperty(name, out var value) && TryParseFlexibleBool(value, out var parsed))
                return parsed;
        }

        return null;
    }

    private List<string> GetFailedCriteria(string? mustHaveEvaluationJson)
    {
        var failed = new List<string>();

        foreach (var entry in ParseMustHaveEntries(mustHaveEvaluationJson).Where(e => !e.Passed))
        {
            if (!string.IsNullOrWhiteSpace(entry.Criterion))
                failed.Add(entry.Criterion);
        }

        var mustHave = ParseJson<MustHaveDto>(mustHaveEvaluationJson);
        if (mustHave?.MissingCriteria?.Any() == true)
        {
            failed.AddRange(mustHave.MissingCriteria.Where(c => !string.IsNullOrWhiteSpace(c)));
        }

        return failed.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    }

    private List<CategoryDetailRow> BuildCategoryBreakdown(
        Dictionary<string, double>? subScores,
        List<EvidenceItem> evidence,
        JobConfigDto? jobConfig,
        List<string>? tips,
        List<MustHaveEntry>? mustHaveEntries)
    {
        var rows = new List<CategoryDetailRow>();
        if (subScores == null || subScores.Count == 0)
            return rows;

        var rubricJson = jobConfig?.RubricJson;
        var descriptions = ParseRubricDescriptions(rubricJson);
        var weights = ParseRubricWeights(rubricJson);
        var rubricRequirements = ParseRubricRequirements(rubricJson);
        var mustHaveCriteria = ParseMustHaveCriteriaItems(jobConfig?.MustHavesJson);
        var desiredCriteria = ParseDesiredCriteriaItems(jobConfig?.DesiredCriteriaJson);
        var isWeightOnlyMap = LooksLikeWeightOnlyCategoryScores(subScores, weights);
        var safeTips = tips ?? new List<string>();
        var safeMustHaveEntries = mustHaveEntries ?? new List<MustHaveEntry>();
        foreach (var kv in subScores)
        {
            var weightFraction = ResolveRubricWeight(kv.Key, weights);
            var scorePercent = GetCategoryScorePercent(kv.Value, weightFraction, isWeightOnlyMap);
            double? weightPercent = weightFraction.HasValue ? weightFraction.Value * 100.0 : (double?)null;
            double? weightedContribution = scorePercent.HasValue && weightFraction.HasValue
                ? scorePercent.Value * weightFraction.Value
                : (double?)null;
            var categoryEvidence = GetEvidenceSnippetsForCategory(kv.Key, evidence);

            var requirements = BuildCategoryRequirementChecklist(
                kv.Key,
                categoryEvidence,
                rubricRequirements,
                mustHaveCriteria,
                desiredCriteria,
                safeMustHaveEntries);

            rows.Add(new CategoryDetailRow
            {
                Name = kv.Key,
                RawValue = kv.Value,
                ScorePercent = scorePercent,
                WeightPercent = weightPercent,
                WeightedContributionPoints = weightedContribution,
                Description = ResolveRubricDescription(kv.Key, descriptions),
                EvidenceSnippets = categoryEvidence,
                Requirements = requirements,
                RelevantTips = GetTipsForCategory(kv.Key, safeTips)
            });
        }

        return rows;
    }

    private static string FormatCategoryScore(double score)
        => score.ToString("0.###", CultureInfo.InvariantCulture);

    private static string FormatPercent(double? value)
        => value.HasValue
            ? $"{value.Value.ToString("0.##", CultureInfo.InvariantCulture)}%"
            : "N/A";

    private static Dictionary<string, string> ParseRubricDescriptions(string? rubricJson)
    {
        return ReadRubricCategories(rubricJson)
            .Where(category => !string.IsNullOrWhiteSpace(category.Name)
                && !string.IsNullOrWhiteSpace(category.Description))
            .GroupBy(category => category.Name.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                group => group.Key,
                group => group.First().Description!.Trim(),
                StringComparer.OrdinalIgnoreCase);
    }

    private static Dictionary<string, double> ParseRubricWeights(string? rubricJson)
    {
        return ReadRubricCategories(rubricJson)
            .Where(category => !string.IsNullOrWhiteSpace(category.Name))
            .GroupBy(category => category.Name.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                group => group.Key,
                group => NormalizeWeight(group.First().Weight),
                StringComparer.OrdinalIgnoreCase);
    }

    private static string? ResolveRubricDescription(string categoryName, Dictionary<string, string> descriptions)
    {
        if (descriptions.TryGetValue(categoryName, out var exact))
            return exact;

        var normalizedCategory = NormalizeForMatch(categoryName);
        foreach (var kv in descriptions)
        {
            var normalizedCandidate = NormalizeForMatch(kv.Key);
            if (string.IsNullOrWhiteSpace(normalizedCandidate))
                continue;

            if (normalizedCandidate == normalizedCategory
                || normalizedCandidate.Contains(normalizedCategory, StringComparison.Ordinal)
                || normalizedCategory.Contains(normalizedCandidate, StringComparison.Ordinal))
            {
                return kv.Value;
            }
        }

        return null;
    }

    private static double? ResolveRubricWeight(string categoryName, Dictionary<string, double> weights)
    {
        if (weights.TryGetValue(categoryName, out var exact))
            return exact;

        var normalizedCategory = NormalizeForMatch(categoryName);
        foreach (var kv in weights)
        {
            var normalizedCandidate = NormalizeForMatch(kv.Key);
            if (string.IsNullOrWhiteSpace(normalizedCandidate))
                continue;

            if (normalizedCandidate == normalizedCategory
                || normalizedCandidate.Contains(normalizedCategory, StringComparison.Ordinal)
                || normalizedCategory.Contains(normalizedCandidate, StringComparison.Ordinal))
            {
                return kv.Value;
            }
        }

        return null;
    }

    private static bool LooksLikeWeightOnlyCategoryScores(
        Dictionary<string, double> subScores,
        Dictionary<string, double> weights)
    {
        if (subScores.Count == 0 || weights.Count == 0)
            return false;

        var matched = 0;
        foreach (var kv in subScores)
        {
            var weight = ResolveRubricWeight(kv.Key, weights);
            if (!weight.HasValue)
                return false;

            matched++;
            if (!AreApproximatelyEqual(kv.Value, weight.Value))
                return false;
        }

        return matched == subScores.Count;
    }

    private static double? GetCategoryScorePercent(double rawValue, double? weightFraction, bool looksLikeWeightOnly)
    {
        if (looksLikeWeightOnly && weightFraction.HasValue && AreApproximatelyEqual(rawValue, weightFraction.Value))
            return null;

        if (rawValue <= 1.0)
            return rawValue * 100.0;

        return rawValue;
    }

    private static double NormalizeWeight(double rawWeight)
    {
        var normalized = rawWeight <= 1.0 ? rawWeight : rawWeight / 100.0;
        if (normalized < 0) return 0;
        if (normalized > 1) return 1;
        return normalized;
    }

    private static bool AreApproximatelyEqual(double left, double right)
        => Math.Abs(left - right) <= 0.0005;

    private List<CategoryRequirementItem> BuildCategoryRequirementChecklist(
        string categoryName,
        List<string> categoryEvidence,
        Dictionary<string, List<string>> rubricRequirements,
        List<string> mustHaveCriteria,
        List<string> desiredCriteria,
        List<MustHaveEntry> mustHaveEntries)
    {
        var requirements = new List<CategoryRequirementItem>();

        if (IsMustHaveCategory(categoryName) && mustHaveEntries.Any())
        {
            foreach (var entry in mustHaveEntries)
            {
                var criterion = entry.Criterion?.Trim();
                if (string.IsNullOrWhiteSpace(criterion))
                    continue;

                requirements.Add(new CategoryRequirementItem
                {
                    Requirement = criterion,
                    Found = entry.Passed,
                    Evidence = string.IsNullOrWhiteSpace(entry.Evidence)
                        ? "None found"
                        : entry.Evidence.Trim()
                });
            }

            return requirements;
        }

        var sourceRequirements = ResolveRequirementsForCategory(
            categoryName,
            rubricRequirements,
            mustHaveCriteria,
            desiredCriteria);

        foreach (var requirement in sourceRequirements)
        {
            var evidence = FindMatchingEvidence(requirement, categoryEvidence);

            var found = HasUsableEvidence(evidence);
            requirements.Add(new CategoryRequirementItem
            {
                Requirement = requirement,
                Found = found,
                Evidence = found ? evidence!.Trim() : "None found"
            });
        }

        return requirements;
    }

    private static List<string> ResolveRequirementsForCategory(
        string categoryName,
        Dictionary<string, List<string>> rubricRequirements,
        List<string> mustHaveCriteria,
        List<string> desiredCriteria)
    {
        if (IsMustHaveCategory(categoryName) && mustHaveCriteria.Any())
            return mustHaveCriteria;

        if (IsDesiredCategory(categoryName) && desiredCriteria.Any())
            return desiredCriteria;

        if (TryResolveCategoryValue(categoryName, rubricRequirements, out var rubricItems) && rubricItems.Any())
            return rubricItems;

        return new List<string>();
    }

    private static bool IsMustHaveCategory(string categoryName)
    {
        var normalized = NormalizeForMatch(categoryName);
        return normalized.Contains("must have", StringComparison.Ordinal)
            || normalized.Contains("mandatory", StringComparison.Ordinal)
            || normalized.Contains("minimum requirement", StringComparison.Ordinal)
            || normalized.Contains("required", StringComparison.Ordinal);
    }

    private static bool IsDesiredCategory(string categoryName)
    {
        var normalized = NormalizeForMatch(categoryName);
        return normalized.Contains("desired", StringComparison.Ordinal)
            || normalized.Contains("recommended", StringComparison.Ordinal)
            || normalized.Contains("preferred", StringComparison.Ordinal)
            || normalized.Contains("optional", StringComparison.Ordinal)
            || normalized.Contains("bonus", StringComparison.Ordinal);
    }

    private static bool HasUsableEvidence(string? evidence)
        => !string.IsNullOrWhiteSpace(evidence) && !LooksLikeNegativeEvidence(evidence);

    private static Dictionary<string, List<string>> ParseRubricRequirements(string? rubricJson)
    {
        var result = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(rubricJson))
            return result;

        try
        {
            using var document = JsonDocument.Parse(rubricJson);
            if (document.RootElement.ValueKind == JsonValueKind.Object
                && TryGetPropertyIgnoreCase(document.RootElement, "categories", out var categoriesElement)
                && TryGetPropertyIgnoreCase(document.RootElement, "items", out var itemsElement)
                && categoriesElement.ValueKind == JsonValueKind.Array
                && itemsElement.ValueKind == JsonValueKind.Array)
            {
                var categoryNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                foreach (var category in categoriesElement.EnumerateArray())
                {
                    if (!TryReadStringIgnoreCase(category, "id", out var id)
                        || !TryReadStringIgnoreCase(category, "name", out var name))
                        continue;
                    categoryNames[id] = name;
                    result[name] = [];
                }
                foreach (var item in itemsElement.EnumerateArray())
                {
                    if (!TryReadStringIgnoreCase(item, "categoryId", out var categoryId)
                        || !TryReadStringIgnoreCase(item, "text", out var text)
                        || !categoryNames.TryGetValue(categoryId, out var categoryName))
                        continue;
                    result[categoryName].Add(text);
                }
                return result;
            }

            foreach (var category in ReadRubricCategories(rubricJson))
            {
                if (!string.IsNullOrWhiteSpace(category.Name))
                    result[category.Name.Trim()] = SplitRequirements(category.Description);
            }
        }
        catch
        {
            // Best-effort only; empty requirements will fall back to evidence-only display.
        }

        return result;
    }

    private static List<RubricCategoryItem> ReadRubricCategories(string? rubricJson)
    {
        if (string.IsNullOrWhiteSpace(rubricJson))
            return [];

        try
        {
            using var document = JsonDocument.Parse(rubricJson);
            var categories = document.RootElement;
            if (categories.ValueKind == JsonValueKind.Object
                && TryGetPropertyIgnoreCase(categories, "categories", out var nestedCategories))
                categories = nestedCategories;
            if (categories.ValueKind != JsonValueKind.Array)
                return [];
            return JsonSerializer.Deserialize<List<RubricCategoryItem>>(
                categories.GetRawText(),
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
        }
        catch (JsonException)
        {
            return [];
        }
    }

    private static bool TryGetPropertyIgnoreCase(
        JsonElement element,
        string propertyName,
        out JsonElement value)
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in element.EnumerateObject())
            {
                if (string.Equals(property.Name, propertyName, StringComparison.OrdinalIgnoreCase))
                {
                    value = property.Value;
                    return true;
                }
            }
        }
        value = default;
        return false;
    }

    private static bool TryReadStringIgnoreCase(
        JsonElement element,
        string propertyName,
        out string value)
    {
        value = string.Empty;
        if (!TryGetPropertyIgnoreCase(element, propertyName, out var property)
            || property.ValueKind != JsonValueKind.String
            || string.IsNullOrWhiteSpace(property.GetString()))
            return false;
        value = property.GetString()!.Trim();
        return true;
    }

    private static List<string> ParseMustHaveCriteriaItems(string? mustHavesJson)
    {
        if (string.IsNullOrWhiteSpace(mustHavesJson))
            return new List<string>();

        try
        {
            using var doc = JsonDocument.Parse(mustHavesJson);
            return ExtractMustHaveValues(doc.RootElement)
                .Where(v => !string.IsNullOrWhiteSpace(v))
                .Select(v => v.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch
        {
            return new List<string>();
        }
    }

    private static List<string> ExtractMustHaveValues(JsonElement element)
    {
        var values = new List<string>();

        if (element.ValueKind == JsonValueKind.String)
        {
            var value = element.GetString();
            if (!string.IsNullOrWhiteSpace(value))
                values.Add(value);
            return values;
        }

        if (element.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in element.EnumerateArray())
                values.AddRange(ExtractMustHaveValues(item));
            return values;
        }

        if (element.ValueKind != JsonValueKind.Object)
            return values;

        foreach (var key in new[] { "criterion", "requirement", "item", "name", "title", "description", "qualification" })
        {
            if (element.TryGetProperty(key, out var candidate) && candidate.ValueKind == JsonValueKind.String)
            {
                var value = candidate.GetString();
                if (!string.IsNullOrWhiteSpace(value))
                    values.Add(value);
            }
        }

        foreach (var prop in element.EnumerateObject())
        {
            if (prop.Value.ValueKind is JsonValueKind.Array or JsonValueKind.Object)
                values.AddRange(ExtractMustHaveValues(prop.Value));
        }

        return values;
    }

    private static List<string> SplitRequirements(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
            return new List<string>();

        var split = description
            .Split(new[] { '\n', ';', '•' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Trim())
            .Where(part => !string.IsNullOrWhiteSpace(part))
            .ToList();

        if (split.Count <= 1)
        {
            split = description
                .Split(new[] { ". " }, StringSplitOptions.RemoveEmptyEntries)
                .Select(part => part.Trim())
                .Where(part => !string.IsNullOrWhiteSpace(part))
                .ToList();
        }

        return split
            .Select(part => part.Trim().TrimEnd('.', ','))
            .Where(part => !string.IsNullOrWhiteSpace(part))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static bool TryResolveCategoryValue<T>(string categoryName, Dictionary<string, T> values, out T value)
    {
        if (values.TryGetValue(categoryName, out value!))
            return true;

        var normalizedCategory = NormalizeForMatch(categoryName);
        foreach (var kv in values)
        {
            var normalizedCandidate = NormalizeForMatch(kv.Key);
            if (string.IsNullOrWhiteSpace(normalizedCandidate))
                continue;

            if (normalizedCandidate == normalizedCategory
                || normalizedCandidate.Contains(normalizedCategory, StringComparison.Ordinal)
                || normalizedCategory.Contains(normalizedCandidate, StringComparison.Ordinal))
            {
                value = kv.Value;
                return true;
            }
        }

        value = default!;
        return false;
    }

    private static List<string> GetEvidenceSnippetsForCategory(string categoryName, List<EvidenceItem> evidence)
    {
        if (evidence.Count == 0)
            return new List<string>();

        var normalizedCategory = NormalizeForMatch(categoryName);
        return evidence
            .Where(e => !string.IsNullOrWhiteSpace(e.Snippet))
            .Where(e =>
            {
                var category = e.Category ?? string.Empty;
                var normalizedEvidenceCategory = NormalizeForMatch(category);
                return !string.IsNullOrWhiteSpace(normalizedEvidenceCategory)
                    && (normalizedEvidenceCategory == normalizedCategory
                        || normalizedEvidenceCategory.Contains(normalizedCategory, StringComparison.Ordinal)
                        || normalizedCategory.Contains(normalizedEvidenceCategory, StringComparison.Ordinal));
            })
            .Select(e => e.Snippet!.Trim())
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static List<string> GetTipsForCategory(string categoryName, List<string> tips)
    {
        if (tips.Count == 0)
            return new List<string>();

        var normalizedCategory = NormalizeForMatch(categoryName);
        var categoryTokens = normalizedCategory
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(t => t.Length >= 4)
            .Distinct(StringComparer.Ordinal)
            .ToList();

        var matched = new List<string>();
        foreach (var tip in tips)
        {
            if (string.IsNullOrWhiteSpace(tip))
                continue;

            var normalizedTip = NormalizeForMatch(tip);
            if (string.IsNullOrWhiteSpace(normalizedTip))
                continue;

            if (normalizedTip.Contains(normalizedCategory, StringComparison.Ordinal)
                || normalizedCategory.Contains(normalizedTip, StringComparison.Ordinal))
            {
                matched.Add(tip);
                continue;
            }

            if (!categoryTokens.Any())
                continue;

            var overlap = categoryTokens.Count(token => normalizedTip.Contains(token, StringComparison.Ordinal));
            if (overlap >= Math.Min(2, categoryTokens.Count))
                matched.Add(tip);
        }

        return matched.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    }

    private bool IsTipGateFailureRelated(string tip, List<string> failedCriteria)
    {
        if (string.IsNullOrWhiteSpace(tip) || failedCriteria.Count == 0)
            return false;

        var normalizedTip = NormalizeForMatch(tip);
        if (string.IsNullOrWhiteSpace(normalizedTip))
            return false;

        foreach (var criterion in failedCriteria)
        {
            if (string.IsNullOrWhiteSpace(criterion)) continue;

            var normalizedCriterion = NormalizeForMatch(criterion);
            if (string.IsNullOrWhiteSpace(normalizedCriterion)) continue;

            if (normalizedTip.Contains(normalizedCriterion, StringComparison.Ordinal) ||
                normalizedCriterion.Contains(normalizedTip, StringComparison.Ordinal))
            {
                return true;
            }

            var criterionTokens = normalizedCriterion.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Where(t => t.Length >= 4)
                .Distinct(StringComparer.Ordinal)
                .ToList();

            if (!criterionTokens.Any()) continue;

            var overlap = criterionTokens.Count(token => normalizedTip.Contains(token, StringComparison.Ordinal));
            if (overlap >= Math.Min(2, criterionTokens.Count))
                return true;
        }

        return false;
    }

    private static bool TryParseFlexibleBool(JsonElement value, out bool parsed)
    {
        switch (value.ValueKind)
        {
            case JsonValueKind.True:
                parsed = true;
                return true;
            case JsonValueKind.False:
                parsed = false;
                return true;
            case JsonValueKind.Number:
                if (value.TryGetInt32(out var intVal))
                {
                    parsed = intVal != 0;
                    return true;
                }
                break;
            case JsonValueKind.String:
                var raw = value.GetString()?.Trim().ToLowerInvariant();
                if (string.IsNullOrWhiteSpace(raw)) break;

                if (raw is "true" or "yes" or "y" or "pass" or "passed" or "met" or "meets" or "satisfied" or "compliant" or "success" or "successful")
                {
                    parsed = true;
                    return true;
                }

                if (raw is "false" or "no" or "n" or "fail" or "failed" or "missing" or "not met" or "unsatisfied" or "non-compliant" or "ineligible")
                {
                    parsed = false;
                    return true;
                }
                break;
        }

        parsed = false;
        return false;
    }

    private static string NormalizeForMatch(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;

        var chars = value
            .ToLowerInvariant()
            .Select(ch => char.IsLetterOrDigit(ch) ? ch : ' ')
            .ToArray();

        return string.Join(' ', new string(chars).Split(' ', StringSplitOptions.RemoveEmptyEntries));
    }

    private List<MustHaveEntry> BuildDesiredChecklist(string? desiredCriteriaJson, string? evidenceCitationsJson)
    {
        var desiredItems = ParseDesiredCriteriaItems(desiredCriteriaJson);
        if (!desiredItems.Any())
            return new List<MustHaveEntry>();

        var desiredEvidence = GetDesiredEvidenceSnippets(evidenceCitationsJson);
        var checklist = new List<MustHaveEntry>();

        foreach (var desired in desiredItems)
        {
            var matchedEvidence = FindMatchingEvidence(desired, desiredEvidence);
            checklist.Add(new MustHaveEntry
            {
                Criterion = desired,
                Passed = !string.IsNullOrWhiteSpace(matchedEvidence),
                Evidence = matchedEvidence
            });
        }

        return checklist;
    }

    private static string? FindMatchingEvidence(string criterion, List<string> snippets)
    {
        var normalizedCriterion = NormalizeForMatch(criterion);
        if (string.IsNullOrWhiteSpace(normalizedCriterion))
            return null;

        var criterionTokens = normalizedCriterion
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(t => t.Length >= 4)
            .Distinct(StringComparer.Ordinal)
            .ToList();

        foreach (var snippet in snippets)
        {
            var normalizedSnippet = NormalizeForMatch(snippet);
            if (string.IsNullOrWhiteSpace(normalizedSnippet))
                continue;

            if (normalizedSnippet.Contains(normalizedCriterion, StringComparison.Ordinal)
                || normalizedCriterion.Contains(normalizedSnippet, StringComparison.Ordinal))
            {
                return snippet;
            }

            if (!criterionTokens.Any())
                continue;

            var overlap = criterionTokens.Count(t => normalizedSnippet.Contains(t, StringComparison.Ordinal));
            if (overlap >= Math.Min(2, criterionTokens.Count))
                return snippet;
        }

        return null;
    }

    private static List<string> ParseDesiredCriteriaItems(string? desiredCriteriaJson)
    {
        if (string.IsNullOrWhiteSpace(desiredCriteriaJson))
            return new List<string>();

        try
        {
            using var doc = JsonDocument.Parse(desiredCriteriaJson);
            return ExtractDesiredCriteriaValues(doc.RootElement)
                .Where(v => !string.IsNullOrWhiteSpace(v))
                .Select(v => v.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch
        {
            return new List<string>();
        }
    }

    private static List<string> ExtractDesiredCriteriaValues(JsonElement element)
    {
        var values = new List<string>();

        if (element.ValueKind == JsonValueKind.String)
        {
            var value = element.GetString();
            if (!string.IsNullOrWhiteSpace(value))
                values.Add(value);
            return values;
        }

        if (element.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in element.EnumerateArray())
                values.AddRange(ExtractDesiredCriteriaValues(item));
            return values;
        }

        if (element.ValueKind != JsonValueKind.Object)
            return values;

        foreach (var key in new[] { "qualification", "criterion", "requirement", "item", "name", "title", "description" })
        {
            if (element.TryGetProperty(key, out var candidate) && candidate.ValueKind == JsonValueKind.String)
            {
                var value = candidate.GetString();
                if (!string.IsNullOrWhiteSpace(value))
                    values.Add(value);
            }
        }

        foreach (var prop in element.EnumerateObject())
        {
            if (prop.Value.ValueKind is JsonValueKind.Array or JsonValueKind.Object)
                values.AddRange(ExtractDesiredCriteriaValues(prop.Value));
        }

        return values;
    }

    private List<string> GetDesiredEvidenceSnippets(string? evidenceCitationsJson)
    {
        var evidence = ParseJson<List<EvidenceItem>>(evidenceCitationsJson) ?? new List<EvidenceItem>();

        return evidence
            .Where(e => !string.IsNullOrWhiteSpace(e.Snippet))
            .Select(e => e.Snippet)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static double? GetDesiredCategoryScore(Dictionary<string, double>? subScores)
    {
        if (subScores == null || subScores.Count == 0)
            return null;

        foreach (var kv in subScores)
        {
            if (kv.Key.Contains("desired", StringComparison.OrdinalIgnoreCase)
                || kv.Key.Contains("recommended", StringComparison.OrdinalIgnoreCase)
                || kv.Key.Contains("preferred", StringComparison.OrdinalIgnoreCase)
                || kv.Key.Contains("bonus", StringComparison.OrdinalIgnoreCase))
            {
                return kv.Value;
            }
        }

        return null;
    }

    private bool HasError(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return false;
        try
        {
            using var doc = JsonDocument.Parse(json);
            return doc.RootElement.TryGetProperty("error", out _);
        }
        catch { return false; }
    }

    private string GetErrorMessage(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "";
        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("error", out var err))
                return err.GetString() ?? "";
        }
        catch { }
        return "";
    }

    private string GetRawResponse(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "";
        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("rawResponse", out var raw))
                return raw.GetString() ?? "";
        }
        catch { }
        return "";
    }

