    private async Task ReparseRun(string applicationId, string scoringRunId)
    {
        if (CurrentPrompt == null) return;
        if (reparsingRunIds.Contains(scoringRunId)) return;

        reparsingRunIds.Add(scoringRunId);
        workflowMessage = null;
        StateHasChanged();

        try
        {
            var result = await Api.ReparseScoringRunAsync(applicationId, scoringRunId);
            Console.WriteLine($"[PromptTestRunner] Re-parse run={scoringRunId} source={result?.Source} fallback={result?.FallbackParsingActivated} eligibilityPath={result?.EligibilityPath} gateDetected={result?.GateDetected} totalScoreFallback={result?.TotalScoreFallbackActivated}");

            if (result?.FallbackParsingActivated == true)
                Console.WriteLine($"[PromptTestRunner] Fallback parsing path ACTIVATED for run {scoringRunId} (path={result.EligibilityPath}).");
            else
                Console.WriteLine($"[PromptTestRunner] Fallback parsing path not activated for run {scoringRunId}.");

            if (_selectedDetailRunId != null && _selectedDetailPromptId != null)
            {
                selectedDetail = await Api.GetTestRunDetailAsync(
                    JobId,
                    _selectedDetailPromptId,
                    _selectedDetailRunId);
            }

            workflowMessage = $"Re-parsed scoring run {scoringRunId[..8]}... (source: {result?.Source ?? "unknown"}).";
        }
        catch (ApiException ex)
        {
            workflowMessage = ex.Message;
        }
        catch (Exception ex)
        {
            workflowMessage = ex.Message;
        }
        finally
        {
            reparsingRunIds.Remove(scoringRunId);
            StateHasChanged();
        }
    }

