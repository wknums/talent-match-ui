@using TalentMatch.Web.Client.Services

<div style="border: 1px solid #ccc; border-radius: 8px; padding: 1rem; cursor: pointer;" @onclick="() => OnClick.InvokeAsync()">
    <h5>@Job.Title</h5>
    <p>@Job.Organisation — @Job.Department</p>
    <p style="font-size: 0.8rem; color: gray;">Posted @((DateTime.UtcNow - Job.PostingDate).Days) days ago</p>
    <span style="background: @StatusColor; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.8rem;">@Job.Status</span>
</div>

@code {
    [Parameter] public JobDto Job { get; set; } = default!;
    [Parameter] public EventCallback OnClick { get; set; }

    private string StatusColor => Job.Status switch
    {
        "active" => "#4caf50",
        "closed" => "#f44336",
        _ => "#ff9800"
    };
}
