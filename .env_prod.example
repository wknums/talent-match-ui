# =============================================================================
# Production Deployment Profile (.env_prod)
# =============================================================================
# Copy to .env_prod and fill in values for production Azure deployment.
# Usage: ./infra/scripts/deploy.sh .env_prod prod apply both
# EXAMPLES ONLY: populated names, URLs, network ranges, and settings below are illustrative.
# They are not verified Azure coordinates or approved production configuration.
# Keep examples here; replace environment-specific values in the untracked .env_prod copy.
# CI DEPLOYMENT_ENV_FILE must contain that completed profile, not this unchanged template.
# =============================================================================

# --- Azure Subscription ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=australiaeast

# --- Resource Naming ---
ENVIRONMENT=prod
RESOURCE_GROUP=rg-talentmatch-prod
PROJECT_NAME=talentmatch
APP_NAME_STACK_A_INFIX=node
APP_NAME_STACK_B_INFIX=blazor

# Comma-separated browser origins allowed to make credentialed API requests.
CORS_ALLOWED_ORIGINS=

# --- Stack Target ---
STACK_TARGET=both

# --- Shared Resource Reuse Flags ---
AZ_APP_SERVICE_PLAN_REUSE=FALSE
AZ_SQL_REUSE=FALSE
AZ_SQL_BOOTSTRAP_ENABLED=TRUE
AZ_KEY_VAULT_REUSE=FALSE
AZ_KEY_VAULT_ENABLED=FALSE
AZ_APIM_REUSE=FALSE
AZ_APP_INSIGHTS_ENABLED=FALSE
AZ_APP_INSIGHTS_REUSE=FALSE
# Managed identities only; app-registration reuse is controlled by ENTRA_REUSE.
# Optional separate setup: bash infra/scripts/setup-identity.sh .env_prod
# Record its printed reuse coordinates in this profile before deployment.
AZ_IDENTITIES_REUSE=FALSE

# --- Existing Resource Coordinates (required when *_REUSE=TRUE) ---
# App Service Plan
# AZ_APP_SERVICE_PLAN_NAME=
# AZ_APP_SERVICE_PLAN_RG=

# Azure SQL
# SQL_SERVER_NAME=
# SQL_DATABASE_NAME=
# SQL_RG=

# Key Vault. With reuse FALSE, optional NAME/RG override where the new vault is
# created; the custom RG must already exist. Blank values use kv-<project>-<env>
# in RESOURCE_GROUP. With reuse TRUE, both values are required.
# AZ_KEY_VAULT_NAME=
# AZ_KEY_VAULT_RG=

# API Management
# AZ_APIM_NAME=
# AZ_APIM_RG=

# Application Insights (coordinates required only when enabled and reused).
# With reuse FALSE, create appi-<project>-<env> and law-<project>-<env> in RESOURCE_GROUP.
# AZ_APP_INSIGHTS_NAME=
# AZ_APP_INSIGHTS_RG=

# Managed identities (set only for stacks included by STACK_TARGET)
# AZ_IDENTITY_STACK_A_NAME=
# AZ_IDENTITY_STACK_B_NAME=
# AZ_IDENTITIES_RG=

# --- App Service SKU ---
APP_SERVICE_PLAN_SKU=S1

# --- SQL Configuration ---
SQL_ADMIN_LOGIN=sqladmin

# --- Runtime Settings (non-secret) ---
APP_AUTH_MODE=entra
ENTRA_REUSE=FALSE

# Shared protected API and public browser clients
ENTRA_API_APP_CLIENT_ID=
ENTRA_API_SERVICE_PRINCIPAL_OBJECT_ID=
ENTRA_API_IDENTIFIER_URI=
ENTRA_API_SCOPE=access_as_user
# Required delegated scope UUID: preserve its deployed value; no built-in default.
ENTRA_API_SCOPE_ID=
ENTRA_STACK_A_CLIENT_ID=
ENTRA_STACK_B_CLIENT_ID=

# All four stable protected-API app-role UUIDs are required; preserve their deployed values.
ENTRA_ADMIN_APP_ROLE_ID=
ENTRA_ORGANIZATION_ADMIN_APP_ROLE_ID=
ENTRA_RECRUITER_APP_ROLE_ID=
ENTRA_BUSINESS_PANEL_APP_ROLE_ID=

# Verified first-administrator and initial authorization scope
ENTRA_BOOTSTRAP_ADMIN_OBJECT_ID=
ENTRA_BOOTSTRAP_ORGANIZATION_NAME=
ENTRA_BOOTSTRAP_DEPARTMENT_NAME=

# Browser acceptance targets and tenant-verified fixture IDs (non-secret)
E2E_STACK_A_BASE_URL=https://app-yourproject-node.azurewebsites.net
E2E_STACK_B_BASE_URL=https://app-yourproject-blazor.azurewebsites.net
E2E_ENTRA_ACCESS_USER_OBJECT_ID=
E2E_ENTRA_ORGANIZATION_ID=
E2E_ENTRA_DEPARTMENT_IDS=

# Stack A
STORAGE_PROVIDER=azuresql
AWR_AUTH_MODE=apikey
# Stack B: shared production document slots per app instance in sequential mode.
AWR_MAX_PARALLEL=1
# Stack B: seconds a document being scored stays reserved before it counts as abandoned (default 240; allowed 60-1800).
# AWR_SCORING_LEASE_SECONDS=240
# AWR_SEQ_API_ENDPOINT=
# AWR_PLATFORM_API_ENDPOINT=
# AWR_AAD_ISSUER=
# AWR_AAD_AUDIENCE=

# Stack B
DATABASE_PROVIDER=sqlserver

# --- APIM Configuration ---
APIM_SKU=Basic_1
APIM_PUBLISHER_NAME=TalentMatch
APIM_PUBLISHER_EMAIL=admin@example.com

# --- Key Vault Secret References ---
# Automatically wired from Key Vault into app settings at deploy time.

# =============================================================================
# Private Network Connectivity (US6)
# =============================================================================
# Production always uses an existing VNet with an existing delegated subnet.
AZ_VNET_REUSE=TRUE
AZ_VNET_NAME=vnet-awr-platform
AZ_VNET_RG=rg-awr-networking

# Option A: Reuse existing delegated subnet (production standard)
AZ_INTEGRATION_SUBNET_NAME=snet-appservice-integration
# Option B: Create a new delegated subnet (use this OR Option A, not both)
# AZ_INTEGRATION_SUBNET_CIDR=10.0.4.0/26

# SQL Private Endpoint — existing PE is reused; Terraform does not create one
AZ_SQL_PRIVATE_ENDPOINT_REUSE=TRUE

# IP Access Restrictions — required when AZ_VNET_REUSE=TRUE
# Comma-separated public IPs allowed to reach the App Services
AZ_ALLOWED_IPS=203.0.113.10,198.51.100.20,192.0.2.50

# Separate delegated Microsoft 365 source connector. Populate only the untracked Production profile.
MICROSOFT365_SOURCE_MODE=
PRODUCT_ENVIRONMENT=
MICROSOFT365_SOURCE_PUBLISHER_VERIFIED=
MICROSOFT365_SOURCE_REUSE=
MICROSOFT365_SOURCE_CLIENT_ID=
MICROSOFT365_SOURCE_REDIRECT_URIS=
MICROSOFT365_SOURCE_CALLBACK_PATH=
MICROSOFT365_SOURCE_ADMIN_CONSENT_CALLBACK_PATH=
MICROSOFT365_SOURCE_AUTHORITY=
MICROSOFT365_SOURCE_SCOPES=
MICROSOFT_GRAPH_BASE_URI=
BULK_AUTH_KEY_URI=
BULK_AUTH_DEV_KEY_PATH=
BULK_SOURCE_IDLE_TTL_MINUTES=
BULK_SOURCE_ABSOLUTE_TTL_MINUTES=
BULK_DISCOVERY_STEP_FILES=
BULK_DISCOVERY_STEP_MAX_ENTRIES=
BULK_DISCOVERY_STEP_MAX_SECONDS=
BULK_MAX_TOTAL_BYTES=
BULK_PENDING_CONNECTIONS_PER_ACTOR=
BULK_CONNECTION_STARTS_PER_ACTOR_PER_MINUTE=
BULK_CONNECTION_STARTS_PER_IP_PER_MINUTE=
BULK_CALLBACKS_PER_IP_PER_MINUTE=
BULK_ADMISSION_HMAC_KEY_URI=
MICROSOFT365_SOURCE_MAX_CONCURRENCY=
BULK_IMPORT_CONCURRENCY=
BULK_CONVERT_CONCURRENCY=
BULK_RASTER_DPI=
