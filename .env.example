# EXAMPLES ONLY: populated settings below illustrate configuration, not a verified deployment.
# Keep these examples in this template; review and replace environment-specific values only in
# an untracked copy. Never use unchanged examples as the CI DEPLOYMENT_ENV_FILE secret.
# Local runtime and browser acceptance settings (non-secret)
APP_AUTH_MODE=simple
STORAGE_PROVIDER=sqlite
DATABASE_PROVIDER=sqlite

E2E_STACK_A_BASE_URL=http://127.0.0.1:5173
E2E_STACK_B_BASE_URL=http://127.0.0.1:5000
E2E_ENTRA_ACCESS_USER_OBJECT_ID=
E2E_ENTRA_ORGANIZATION_ID=
E2E_ENTRA_DEPARTMENT_IDS=

# Optional comma-separated browser origins for credentialed cross-origin API requests.
# Leave empty for same-origin hosting.
CORS_ALLOWED_ORIGINS=

# Storage provider: "local" (SQLite) or "azuresql" (when AZURE_SQL_CONNECTION_STRING is set)
# When AZURE_SQL_CONNECTION_STRING is absent, Stack A automatically uses SQLite at ./shared-data/talentmatch.db
# Optional override for both stacks in development: SQLITE_DB_PATH=shared-data/talentmatch.db
STORAGE_PROVIDER=local

# Server port
PORT=3001

# Application authentication: "simple" (local credentials) or "entra" (single-tenant Entra PKCE)
APP_AUTH_MODE=simple

# Shared protected API (non-secret; Terraform outputs when managed by this repository)
# ENTRA_API_APP_CLIENT_ID=
# ENTRA_API_SERVICE_PRINCIPAL_OBJECT_ID=
# ENTRA_API_IDENTIFIER_URI=
ENTRA_API_SCOPE=
# Required for Entra deployments: preserve the existing delegated scope UUID; no built-in default.
ENTRA_API_SCOPE_ID=

# Browser SPA clients (public client IDs; never configure a SPA client secret)
# ENTRA_STACK_A_CLIENT_ID=
# ENTRA_STACK_B_CLIENT_ID=

# All four stable protected-API app-role IDs are required for Entra deployments; preserve existing IDs.
# ENTRA_ADMIN_APP_ROLE_ID=
# ENTRA_ORGANIZATION_ADMIN_APP_ROLE_ID=
# ENTRA_RECRUITER_APP_ROLE_ID=
# ENTRA_BUSINESS_PANEL_APP_ROLE_ID=

# First-administrator bootstrap inputs
# ENTRA_BOOTSTRAP_ADMIN_OBJECT_ID=
# ENTRA_BOOTSTRAP_ORGANIZATION_NAME=
# ENTRA_BOOTSTRAP_DEPARTMENT_NAME=

# AWReason API endpoint (required for document extraction, prompt generation, and scoring)
# AWR_SEQ_API_ENDPOINT=

# Scoring profile identity forwarded to AWReason and snapshotted on every prompt version.
# Update both values whenever the backend deployment changes model or reasoning behavior.
# Existing production prompts are blocked until a new version is tested and approved.
AWR_MODEL_ID=
AWR_REASONING_LEVEL=medium

# Stack B production document slots per app instance, shared across jobs/uploads.
# Sequential mode automatically refills free slots from queued database rows.
# Does not cap prompt tests, extraction, other app instances, or platform mode.
AWR_MAX_PARALLEL=1

# Stack B: seconds a document being scored stays reserved before it counts as abandoned and fails with
# "Sequential scoring lease expired". The host renews the reservation every 20 s and retries a failed renewal.
# Default 240 (4 minutes); allowed 60-1800. Stack A does not use it.
# AWR_SCORING_LEASE_SECONDS=240
# AWReason Platform API endpoint (optional - for platform-mode scoring)
# When unset or equal to AWR_SEQ_API_ENDPOINT, system operates in sequential mode.
# When set to a different URL, production scoring uses the platform endpoint (async submission).
# Non-scoring operations (prompt generation, extraction, test scoring) always use AWR_SEQ_API_ENDPOINT.
# Contract: specs/008-platform-mode-shift/platform-contract.md
# AWR_PLATFORM_API_ENDPOINT=

# Platform mode tuning (only relevant when AWR_PLATFORM_API_ENDPOINT is set)
# CVs per submission; raise once platform is validated
# AWR_PLATFORM_BATCH_SIZE=2
# Reconciler tick
# AWR_PLATFORM_RECONCILE_INTERVAL_MS=15000
# SQL row-lease TTL for reconciler
# AWR_PLATFORM_LEASE_SECONDS=60
# Cap batches reconciled per tick per replica
# AWR_PLATFORM_MAX_INFLIGHT_PER_TICK=50

# CV blob storage (REQUIRED in platform mode; RBAC only, no SAS — see constitution)
# Client writes CVs to {AWR_BLOB_STORAGE_ACCOUNT}/{AWR_BLOB_CONTAINER}/{jobId}/{appId}/{docId}.{ext}
# Both client and platform read/write via managed identity.
# AWR_BLOB_STORAGE_ACCOUNT=
# AWR_BLOB_CONTAINER=

# Separate delegated Microsoft 365 source connector. Checked-in profiles deliberately leave all
# environment-owned identifiers, endpoints, assertions, callbacks, and policy values blank.
MICROSOFT365_SOURCE_MODE=
PRODUCT_ENVIRONMENT=
MICROSOFT365_SOURCE_PUBLISHER_VERIFIED=
MICROSOFT365_SOURCE_REUSE=
MICROSOFT365_SOURCE_CLIENT_ID=
MICROSOFT365_SOURCE_REDIRECT_URIS=
MICROSOFT365_SOURCE_CALLBACK_PATH=
MICROSOFT365_SOURCE_ADMIN_CONSENT_CALLBACK_PATH=
MICROSOFT365_SOURCE_AUTHORITY=
MICROSOFT365_SOURCE_SCOPES=
MICROSOFT_GRAPH_BASE_URI=
BULK_AUTH_KEY_URI=
BULK_AUTH_DEV_KEY_PATH=
BULK_SOURCE_IDLE_TTL_MINUTES=
BULK_SOURCE_ABSOLUTE_TTL_MINUTES=
BULK_DISCOVERY_STEP_FILES=
BULK_DISCOVERY_STEP_MAX_ENTRIES=
BULK_DISCOVERY_STEP_MAX_SECONDS=
BULK_MAX_TOTAL_BYTES=
BULK_PENDING_CONNECTIONS_PER_ACTOR=
BULK_CONNECTION_STARTS_PER_ACTOR_PER_MINUTE=
BULK_CONNECTION_STARTS_PER_IP_PER_MINUTE=
BULK_CALLBACKS_PER_IP_PER_MINUTE=
BULK_ADMISSION_HMAC_KEY_URI=
MICROSOFT365_SOURCE_MAX_CONCURRENCY=
BULK_IMPORT_CONCURRENCY=
BULK_CONVERT_CONCURRENCY=
BULK_RASTER_DPI=

# AWReason API Authentication
# AWR_AUTH_MODE: "none" (local dev — no auth headers), "apikey" (staging), "entra" (production)
AWR_AUTH_MODE=none
# AWR_API_KEY: Required when AWR_AUTH_MODE=apikey — shared secret for AWReason API
# AWR_API_KEY=
# AWR_AAD_ISSUER: Entra ID issuer URL (optional, for entra mode validation)
# AWR_AAD_ISSUER=
# AWR_AAD_AUDIENCE: Required when AWR_AUTH_MODE=entra — target API scope/audience
# AWR_AAD_AUDIENCE=

# Azure SQL connection string (required when STORAGE_PROVIDER=azuresql)
# AZURE_SQL_CONNECTION_STRING=

# Azure OpenAI configuration (optional - authentication uses DefaultAzureCredential)
# AZURE_OPENAI_ENDPOINT=
