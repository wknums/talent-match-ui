# Storage provider: "local" or "azuresql"
STORAGE_PROVIDER=local

# Server port
PORT=3001

# API AUTH mode: "none" or "apikey" or "entra"
AUTH_MODE=none
API_KEY=some-test-secret-you-pick

# AWReason API endpoint (required for document extraction, prompt generation, and scoring)
# AWR_SEQ_API_ENDPOINT=http://127.0.0.1:8080

# AWReason API Authentication
# AWR_AUTH_MODE: "none" (local dev — no auth headers), "apikey" (staging), "entra" (production)
AWR_AUTH_MODE=none
# AWR_API_KEY: Required when AWR_AUTH_MODE=apikey — shared secret for AWReason API
# AWR_API_KEY=your-awr-api-key
# AWR_AAD_ISSUER: Entra ID issuer URL (optional, for entra mode validation)
# AWR_AAD_ISSUER=https://login.microsoftonline.com/{tenant-id}/v2.0
# AWR_AAD_AUDIENCE: Required when AWR_AUTH_MODE=entra — target API scope/audience
# AWR_AAD_AUDIENCE=api://your-awr-api-app-id/.default

# Azure SQL connection string (required when STORAGE_PROVIDER=azuresql)
# AZURE_SQL_CONNECTION_STRING=Server=your-server.database.windows.net;Database=your-db;User Id=your-user;Password=your-password;Encrypt=true

# LLM API configuration (optional - needed for document extraction features)
# Option 1: OpenAI API
# OPENAI_API_KEY=sk-...

# Option 2: Azure OpenAI
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
