# Storage provider: "local" or "azuresql"
STORAGE_PROVIDER=local

# Server port
PORT=3001

# Azure SQL connection string (required when STORAGE_PROVIDER=azuresql)
# AZURE_SQL_CONNECTION_STRING=Server=your-server.database.windows.net;Database=your-db;User Id=your-user;Password=your-password;Encrypt=true

# LLM API configuration (optional - needed for document extraction features)
# Option 1: OpenAI API
# OPENAI_API_KEY=sk-...

# Option 2: Azure OpenAI
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
