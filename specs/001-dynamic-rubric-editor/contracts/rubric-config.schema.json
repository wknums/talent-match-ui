{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talentmatch.local/contracts/rubric-v2.schema.json",
  "title": "Editable rubric configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "categories",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "rubric-v2"
    },
    "legacySourceVersionId": {
      "type": ["string", "null"]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "weight",
        "order"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "description": {
          "type": ["string", "null"]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "categoryId",
        "text",
        "requirementType",
        "order",
        "reviewStatus",
        "createdFrom"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "categoryId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "requirementType": {
          "enum": [
            "must_have",
            "desired",
            "experience",
            "responsibility",
            "other"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "sourceText": {
          "type": ["string", "null"]
        },
        "sourceLocation": {
          "type": ["string", "null"]
        },
        "sourceRequirementId": {
          "type": ["string", "null"]
        },
        "reviewStatus": {
          "enum": [
            "confirmed",
            "needs_review"
          ]
        },
        "createdFrom": {
          "enum": [
            "extracted",
            "manual",
            "legacy_conversion"
          ]
        }
      }
    }
  }
}
